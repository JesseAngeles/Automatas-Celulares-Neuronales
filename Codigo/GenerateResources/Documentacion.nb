         RowBox[{"\[Theta]", "[", "t", "]"}], ",", 
         RowBox[{
          RowBox[{"\[Theta]", "'"}], "[", "t", "]"}]}], "}"}], "/.", " ", 
       "sol"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "200", ",", "tmax"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"s\[OAcute]lo", " ", "parte", " ", "final"}], "->", 
       RowBox[{"atractor", " ", "estable"}]}], "*)"}], 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
     RowBox[{"AspectRatio", "->", "1"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
