Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", "0.35"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", "0.3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"w", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmax", "=", "2000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"y", "[", "t", "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"x", "[", "t", "]"}], "-", 
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], "^", "3"}], "-", 
         RowBox[{"a", "*", 
          RowBox[{"y", "[", "t", "]"}]}], "+", 
         RowBox[{"b", "*", 
          RowBox[{"Cos", "[", 
           RowBox[{"w", "*", "t"}], "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
     RowBox[{"MaxSteps", "->", "Infinity"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"caotico", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "[", "t", "]"}], ",", 
         RowBox[{"y", "[", "t", "]"}]}], "}"}], "/.", " ", "sol"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "500", ",", "tmax"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "se", " ", "omite", " ", "el", " ", "transitorio", " ", "inicial"}], 
      "*)"}], 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.1", ",", "0.3", ",", "0.8"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"AspectRatio", "->", "1"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<x\>\"", ",", "14"}], "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<dx/dt\>\"", ",", "14"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
     RowBox[{"Background", "->", "White"}], ",", 
     RowBox[{"PlotPoints", "->", "300"}]}], "]"}]}], ";"}]}], "Input",
