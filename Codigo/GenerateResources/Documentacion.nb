         "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Velocidad \[Omega] (rad/s)\>\"", ",", "14"}], "]"}]}], 
       "}"}]}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}]}], "]"}]}], 
  ";"}]}], "Input",
