Cell[BoxData[{
 RowBox[{
  RowBox[{"hexagonGeometry", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cx_", ",", "cy_"}], "}"}], ",", 
    RowBox[{"r_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"Polygon", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cx", "+", 
        RowBox[{"r", " ", 
         RowBox[{"Cos", "[", "a", "]"}]}]}], ",", 
       RowBox[{"cy", "+", 
        RowBox[{"r", " ", 
         RowBox[{"Sin", "[", "a", "]"}]}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "0", ",", 
       RowBox[{"2", " ", "Pi"}], ",", 
       RowBox[{"Pi", "/", "3"}]}], "}"}]}], "]"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"axialToCartesian", "[", 
   RowBox[{"{", 
    RowBox[{"q_", ",", "r_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"3", "/", "2"}], " ", "q"}], ",", 
    RowBox[{
     RowBox[{"Sqrt", "[", "3", "]"}], " ", 
     RowBox[{"(", 
      RowBox[{"r", "+", 
       RowBox[{"q", "/", "2"}]}], ")"}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hexDistance", "[", 
   RowBox[{"{", 
    RowBox[{"q_", ",", "r_"}], "}"}], "]"}], ":=", 
  RowBox[{"Max", "[", 
   RowBox[{
    RowBox[{"Abs", "[", "q", "]"}], ",", 
    RowBox[{"Abs", "[", "r", "]"}], ",", 
    RowBox[{"Abs", "[", 
     RowBox[{"q", "+", "r"}], "]"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"range", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"allHexCoordinates", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q", ",", "r"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"q", ",", 
         RowBox[{"-", "range"}], ",", "range"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"-", "range"}], ",", "range"}], "}"}]}], "]"}], ",", "1"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"capaCentro", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"allHexCoordinates", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"hexDistance", "[", "#", "]"}], "==", "0"}], "&"}]}], "]"}]}],
    ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"capaGris", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"allHexCoordinates", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"hexDistance", "[", "#", "]"}], "==", "1"}], "&"}]}], "]"}]}],
    ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"capaBlanca", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"allHexCoordinates", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"hexDistance", "[", "#", "]"}], "==", "2"}], "&"}]}], "]"}]}],
    ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nHexagon", "=", 
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"EdgeForm", "[", 
        RowBox[{"{", 
         RowBox[{"Black", ",", "Thin"}], "}"}], "]"}], ",", 
       RowBox[{"FaceForm", "[", "Black", "]"}], ",", 
       RowBox[{"hexagonGeometry", "/@", 
        RowBox[{"(", 
         RowBox[{"axialToCartesian", "/@", "capaCentro"}], ")"}]}], ",", 
       RowBox[{"FaceForm", "[", 
        RowBox[{"GrayLevel", "[", "0.5", "]"}], "]"}], ",", 
       RowBox[{"hexagonGeometry", "/@", 
        RowBox[{"(", 
         RowBox[{"axialToCartesian", "/@", "capaGris"}], ")"}]}], ",", 
       RowBox[{"FaceForm", "[", "White", "]"}], ",", 
       RowBox[{"hexagonGeometry", "/@", 
        RowBox[{"(", 
         RowBox[{"axialToCartesian", "/@", "capaBlanca"}], ")"}]}]}], "}"}], ",", 
     RowBox[{"Frame", "->", "False"}], ",", 
     RowBox[{"Axes", "->", "False"}], ",", 
     RowBox[{"PlotRangePadding", "->", "0.5"}], ",", 
     RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}], ";"}]}], "Input",
