Cell[BoxData[
 RowBox[{
  RowBox[{"metricsEvo", "[", "evo_List", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"series", ",", "T", ",", "born", ",", "death", ",", "live"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"series", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{"evo", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", "1", "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}]}], "}"}]}], "]"}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"cada", " ", "fila"}], "=", 
       RowBox[{
       "serie", " ", "temporal", " ", "de", " ", "una", " ", "celda"}]}], 
      "*)"}], 
     RowBox[{"T", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"series", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"n\[UAcute]mero", " ", "de", " ", "generaciones"}], "*)"}], 
     RowBox[{"born", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"T", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"death", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"T", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"live", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"T", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"s", "[", 
              RowBox[{"[", "t", "]"}], "]"}], "==", "0"}], "&&", 
            RowBox[{
             RowBox[{"s", "[", 
              RowBox[{"[", 
               RowBox[{"t", "+", "1"}], "]"}], "]"}], "==", "1"}]}], ",", 
           RowBox[{
            RowBox[{"born", "[", 
             RowBox[{"[", "t", "]"}], "]"}], "++"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"s", "[", 
              RowBox[{"[", "t", "]"}], "]"}], "==", "1"}], "&&", 
            RowBox[{
             RowBox[{"s", "[", 
              RowBox[{"[", 
               RowBox[{"t", "+", "1"}], "]"}], "]"}], "==", "0"}]}], ",", 
           RowBox[{
            RowBox[{"death", "[", 
             RowBox[{"[", "t", "]"}], "]"}], "++"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"s", "[", 
              RowBox[{"[", "t", "]"}], "]"}], "==", "1"}], "&&", 
            RowBox[{
             RowBox[{"s", "[", 
              RowBox[{"[", 
               RowBox[{"t", "+", "1"}], "]"}], "]"}], "==", "1"}]}], ",", 
           RowBox[{
            RowBox[{"live", "[", 
             RowBox[{"[", "t", "]"}], "]"}], "++"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "1", ",", 
           RowBox[{"T", "-", "1"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "series"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<born\>\"", "->", "born"}], ",", 
       RowBox[{"\"\<death\>\"", "->", "death"}], ",", 
       RowBox[{"\"\<live\>\"", "->", "live"}]}], "|>"}]}]}], "]"}]}]], "Input",\

 InitializationCell->True,
