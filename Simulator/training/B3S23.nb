Cell[BoxData[
 RowBox[{
  RowBox[{"ContarPatrones", "[", 
   RowBox[{"matrices_List", ",", "patrones_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "subBloques", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"subBloques", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Partition", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}]}], "]"}], "&"}], "/@", 
       "matrices"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AssociationMap", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Function", "[", "\[IndentingNewLine]", 
        RowBox[{"p", ",", "\[IndentingNewLine]", 
         RowBox[{"Module", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"centro", "=", 
              RowBox[{"p", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{"sumaExt", "=", 
              RowBox[{"p", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"Count", "[", 
              RowBox[{
               RowBox[{"Flatten", "[", 
                RowBox[{"#", ",", "1"}], "]"}], ",", 
               RowBox[{"b_", "/;", 
                RowBox[{
                 RowBox[{
                  RowBox[{"b", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}], "===", "centro"}], 
                 "&&", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Total", "[", 
                    RowBox[{"b", ",", "2"}], "]"}], "-", 
                    RowBox[{"b", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ")"}], "===", 
                  "sumaExt"}]}]}]}], "]"}], "&"}], "/@", "subBloques"}]}], 
          "]"}]}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
       "patrones"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellLabel->"In[1]:=",ExpressionUUID->"932d0026-93f7-46a3-94c1-af989570d52a"],

