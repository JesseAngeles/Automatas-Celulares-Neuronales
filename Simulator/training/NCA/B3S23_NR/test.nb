Cell[BoxData[{
 RowBox[{
  RowBox[{"distancias", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"ManhattanDistance", "[", 
      RowBox[{"basevector", ",", "#"}], "]"}], "&"}], "/@", "vectors"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"orden", "=", 
   RowBox[{"Reverse", "@", 
    RowBox[{"Ordering", "[", 
     RowBox[{"distancias", ",", "All", ",", "Greater"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"namesSorted", "=", 
   RowBox[{"names", "[", 
    RowBox[{"[", "orden", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"distSorted", "=", 
    RowBox[{"distancias", "[", 
     RowBox[{"[", "orden", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"primerNoCero", "=", 
   RowBox[{
    RowBox[{"FirstPosition", "[", 
     RowBox[{"distSorted", ",", 
      RowBox[{"x_", "/;", 
       RowBox[{"x", ">", "0"}]}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mask", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"distSorted", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ">", "0"}], "||", 
       RowBox[{"i", "==", 
        RowBox[{"primerNoCero", "-", "1"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "distSorted", "]"}]}], "}"}]}], "]"}]}], ";"}],
   "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"namesFiltered", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{"namesSorted", ",", "mask"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"distFiltered", "=", 
    RowBox[{"Pick", "[", 
     RowBox[{"distSorted", ",", "mask"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Colorear", " ", "seg\[UAcute]n", " ", "el", " ", "VALOR"}], ",", 
    
    RowBox[{
    "no", " ", "seg\[UAcute]n", " ", "la", " ", "posici\[OAcute]n"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"colorFunc", "=", 
   RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"valoresEscalados", "=", 
    RowBox[{"Rescale", "[", "distFiltered", "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"normaliza", " ", "entre", " ", "0", " ", "y", " ", "1"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coloresPorValor", "=", 
    RowBox[{"colorFunc", "/@", "valoresEscalados"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"fplot", "=", 
  RowBox[{"BarChart", "[", 
   RowBox[{"distFiltered", ",", 
    RowBox[{"ChartStyle", "->", "coloresPorValor"}], ",", 
    RowBox[{"ChartLabels", "->", 
