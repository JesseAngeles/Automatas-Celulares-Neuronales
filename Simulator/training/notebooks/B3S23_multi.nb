Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"ContarPatrones", "[", 
   RowBox[{"matrices_List", ",", "patrones_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "subBloques", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"subBloques", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Partition", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}]}], "]"}], "&"}], "/@", 
       "matrices"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AssociationMap", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Function", "[", "\[IndentingNewLine]", 
        RowBox[{"p", ",", "\[IndentingNewLine]", 
         RowBox[{"Module", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"centro", "=", 
              RowBox[{"p", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{"sumaExt", "=", 
              RowBox[{"p", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"Count", "[", 
              RowBox[{
               RowBox[{"Flatten", "[", 
                RowBox[{"#", ",", "1"}], "]"}], ",", 
               RowBox[{"b_", "/;", 
                RowBox[{
                 RowBox[{
                  RowBox[{"b", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}], "===", "centro"}], 
                 "&&", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Total", "[", 
                    RowBox[{"b", ",", "2"}], "]"}], "-", 
                    RowBox[{"b", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ")"}], "===", 
                  "sumaExt"}]}]}]}], "]"}], "&"}], "/@", "subBloques"}]}], 
          "]"}]}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
       "patrones"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellLabel->"In[3]:=",ExpressionUUID->"9bf8fe9c-4585-4431-8778-9441746b3491"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evos", "=", 
   RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"CellularAutomaton", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"224", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"2", ",", "2", ",", "2"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"2", ",", "1", ",", "2"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"100", ",", "100"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", "100"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;"}], "]"}], "]"}], "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Range", "[", "100", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
