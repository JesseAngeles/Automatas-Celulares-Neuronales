Notebook[{
Cell["P\[EAcute]rdida del entrenamiento de sandpile", "Title",ExpressionUUID->"915eb5ef-9903-4306-a80b-ca81fa8e9202"],

Cell[TextData[{
 "Red 2:64:ReLU & 17:Linear entrenada con ",
 Cell[BoxData[Cell["CA/Sandpile/evo.mat",
   Background->None,ExpressionUUID->"bad1ab15-8e54-4492-9fc5-6962d77ed607"]], 
  "InlineCode",ExpressionUUID->"6174d178-f6ef-4ca9-bb50-6a09c2bd5bb7"],
 " (25 \[Times] 25, un generador) y ",
 Cell[BoxData[Cell["CA/Sandpile/4generadores/evo.mat",
   Background->None,ExpressionUUID->"1d24e76e-f7e6-407e-960d-562d94244040"]], 
  "InlineCode",ExpressionUUID->"3d7b2ce7-a451-4bf6-89f8-6a69ca49480b"],
 " (25 \[Times] 25, 4 generadores aleatorios): lote 4096, semilla 42, p\
\[EAcute]rdida objetivo 0.000001, l\[IAcute]mite de 2000 \[EAcute]pocas, \
entrada sin one-hot. El registro tiene la p\[EAcute]rdida promedio de cada \
\[EAcute]poca; ",
 Cell[BoxData[Cell["main.py",
   Background->None,ExpressionUUID->"49bb4cce-64d5-4455-b247-fbfdb30adcf1"]], 
  "InlineCode",ExpressionUUID->"efb3460d-939b-4b5e-9e42-7ef8b64bdde1"],
 " repite la \[UAcute]ltima \[EAcute]poca al converger, as\[IAcute] que se \
quitan los duplicados. Solo se usan las columnas ",
 StyleBox["epoch", "TI"],
 " y ",
 StyleBox["loss", "TI"],
 " (los registros nuevos tambi\[EAcute]n traen ",
 StyleBox["lr", "TI"],
 ")."
}], "Text",ExpressionUUID->"eb152cf6-1c32-4182-821a-76aa1e7a80e2"],

Cell["\<\
El eje y es logar\[IAcute]tmico y la l\[IAcute]nea punteada marca la p\
\[EAcute]rdida objetivo. \
\>", "Text",ExpressionUUID->"d2c2fbca-0dfe-4cfc-b52f-70276f25cab6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"graficaPerdidaDe", "[", 
    RowBox[{"archivo_", ",", "objetivo_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"registro", ",", "perdida", ",", 
       RowBox[{"divisiones", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"10", "^", "k"}], ",", 
            RowBox[{"Superscript", "[", 
             RowBox[{"10", ",", "k"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"-", "6"}], ",", "1"}], "}"}]}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"registro", "=", 
       RowBox[{"Rest", "[", 
        RowBox[{"Import", "[", 
         RowBox[{"archivo", ",", "\"\<CSV\>\""}], "]"}], "]"}]}], ";", " ", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"perdida", "=", 
       RowBox[{"DeleteDuplicatesBy", "[", 
        RowBox[{
         RowBox[{"registro", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{";;", " ", "2"}]}], "]"}], "]"}], ",", "First"}], "]"}]}],
       ";", " ", "\[IndentingNewLine]", "\t", 
      RowBox[{"ListLogPlot", "[", 
       RowBox[{"perdida", ",", 
        RowBox[{"Joined", "->", "True"}], ",", "\[IndentingNewLine]", "\t\t", 
        
        RowBox[{"PlotStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"RGBColor", "[", "\"\<#2a78d6\>\"", "]"}], ",", 
           RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{"Epilog", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{"RGBColor", "[", "\"\<#eb6834\>\"", "]"}], ",", "Dashed",
              ",", 
             RowBox[{"AbsoluteThickness", "[", "1", "]"}]}], "]"}], ",", 
           "\[IndentingNewLine]", "\t\t\t", 
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{"Log", "[", "objetivo", "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Length", "[", "perdida", "]"}], ",", 
                RowBox[{"Log", "[", "objetivo", "]"}]}], "}"}]}], "}"}], 
            "]"}], ",", "\[IndentingNewLine]", "\t\t\t", 
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<P\[EAcute]rdida objetivo\>\"", ",", "10", ",", 
               RowBox[{"RGBColor", "[", "\"\<#eb6834\>\"", "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "perdida", "]"}], "/", "60"}], ",", 
               RowBox[{"Log", "[", "objetivo", "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", 
               RowBox[{"-", "1.2"}]}], "}"}]}], "]"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"Length", "[", "perdida", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"5", "*", 
              RowBox[{"10", "^", 
               RowBox[{"-", "7"}]}]}], ",", "5"}], "}"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"Axes", "->", "False"}], ",", 
        RowBox[{"FrameStyle", "->", 
         RowBox[{"GrayLevel", "[", "0.4", "]"}]}], ",", "\[IndentingNewLine]",
         "\t\t", 
        RowBox[{"FrameTicks", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"divisiones", ",", "None"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"Automatic", ",", "None"}], "}"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{"FrameTicksStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Black", ",", "11"}], "]"}]}], ",", 
        RowBox[{"LabelStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Black", ",", "12"}], "]"}]}], ",", "\[IndentingNewLine]", 
        "\t\t", 
        RowBox[{"GridLines", "->", 
         RowBox[{"{", 
          RowBox[{"Automatic", ",", 
           RowBox[{"divisiones", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "}"}]}], ",", 
        RowBox[{"GridLinesStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"GrayLevel", "[", "0.85", "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\[CapitalEAcute]poca\>\"", 
           ",", "\"\<P\[EAcute]rdida\>\""}], "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", "\"\<2:64:ReLU & 17:Linear\>\""}], ",", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{"ImageSize", "->", "400"}], ",", 
        RowBox[{"AspectRatio", "->", 
         RowBox[{"3", "/", "4"}]}]}], "]"}]}]}], "]"}]}], ";"}]}], "Input",Exp\
ressionUUID->"b3d31e83-0870-4f69-9fd4-83eefff844f9"],

Cell["Tasa de aprendizaje constante", "Section",ExpressionUUID->"06ccd094-c82c-41f6-898c-d978b4c574d0"],

Cell["\<\
Tasa de aprendizaje fija en 0.001. Converge en la \[EAcute]poca 899. \
\>", "Text",ExpressionUUID->"0208dc8a-bd5e-4756-a04c-accd3947e94a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"graficaConstante", "=", 
   RowBox[{"graficaPerdidaDe", "[", 
    RowBox[{"\"\<../NCA/Sandpile/4generadores/objetivo0.000001/2-64-relu_17-\
linear.csv\>\"", ",", "0.000001"}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<../../../Documentation/img/experimentacion/duplicacion/sandpile/sp_4generadores_loss.png\>\"", ",",
     "graficaConstante", ",", 
    RowBox[{"ImageResolution", "->", "200"}]}], "]"}], ";"}]}], "Input",Expres\
sionUUID->"14b186a0-4852-4d19-8786-0c3452a69e10"],

Cell["Tasa de aprendizaje con decaimiento exponencial", "Section",ExpressionUUID->"f05f260c-1f85-435b-b1f9-345af94900e8"],

Cell[TextData[{
 "La tasa de aprendizaje baja de 0.001 a 0.000001 con decaimiento exponencial \
a lo largo de las 2000 \[EAcute]pocas (",
 Cell[BoxData[Cell["--lr-schedule exp",
   Background->None,ExpressionUUID->"23cd5356-cd33-4efe-bd81-30d0828e9e92"]], 
  "InlineCode",ExpressionUUID->"031e5ff3-c044-4ed6-9c29-29d98a23a159"],
 "). No alcanza la p\[EAcute]rdida objetivo y termina en la \[EAcute]poca \
1999. "
}], "Text",ExpressionUUID->"ee7b37ca-5495-4511-abd9-23263e2082b6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"graficaExp", "=", 
   RowBox[{"graficaPerdidaDe", "[", 
    RowBox[{"\"\<../NCA/Sandpile/4generadores/objetivo0.000001_exp/2-64-relu_\
17-linear.csv\>\"", ",", "0.000001"}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<../../../Documentation/img/experimentacion/duplicacion/sandpile/sp_4generadores_loss_exp.png\>\"", 
    ",", "graficaExp", ",", 
    RowBox[{"ImageResolution", "->", "200"}]}], "]"}], ";"}]}], "Input",Expres\
sionUUID->"2f570dc4-a7e8-4cb8-94a5-60cd1d7c506c"],

Cell["Tasa de aprendizaje con decaimiento din\[AAcute]mico", "Section",ExpressionUUID->"d7bb64b0-eac6-4485-ab4b-813506918c7c"],

Cell[TextData[{
 "La tasa de aprendizaje empieza en 0.001 y se reduce a la mitad cuando la p\
\[EAcute]rdida no supera su m\[IAcute]nimo en 20 \[EAcute]pocas (",
 Cell[BoxData[Cell["--lr-schedule plateau",
   Background->None,ExpressionUUID->"e75ab038-49b0-4c46-9eec-bd8f5dbd4f3f"]], 
  "InlineCode",ExpressionUUID->"c82406ea-0011-475b-bd17-2e577244a667"],
 ", ",
 Cell[BoxData[Cell["ReduceLROnPlateau",
   Background->None,ExpressionUUID->"6ffb6571-cc43-4489-9bd0-05960818eb1b"]], 
  "InlineCode",ExpressionUUID->"741ed262-d0c7-4760-a6ee-73fa0f0ffb45"],
 "), sin bajar de 0.000001. Se redujo en las \[EAcute]pocas 230, 252, 569, \
942 y 1053 (hasta 0.00003125) y converge en la \[EAcute]poca 1318. "
}], "Text",ExpressionUUID->"1e229528-ebf0-49d4-82b9-409c2040a77c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"graficaPlateau", "=", 
   RowBox[{"graficaPerdidaDe", "[", 
    RowBox[{"\"\<../NCA/Sandpile/4generadores/objetivo0.000001_plateau/2-64-\
relu_17-linear.csv\>\"", ",", "0.000001"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<../../../Documentation/img/experimentacion/duplicacion/sandpile/sp_4generadores_loss_plateau.png\>\
\"", ",", "graficaPlateau", ",", 
    RowBox[{"ImageResolution", "->", "200"}]}], "]"}], ";"}]}], "Input",Expres\
sionUUID->"9859583d-c27e-4439-890c-7a999e2c9230"]
},
