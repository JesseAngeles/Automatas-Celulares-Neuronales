 "El entrenamiento y la evaluaci\[OAcute]n est\[AAcute]n en ",
 Cell[BoxData[Cell["scripts/barrido_langton_colores.py",
   Background->None,ExpressionUUID->"f9c92fe7-cf7e-4ec2-9599-88d68f91eef5"]], 
  "InlineCode",ExpressionUUID->"26775f52-ac7d-49f5-9b2d-5efe8d989851"],
 ". "
}], "Text",ExpressionUUID->"59ae7676-c1f7-48d7-a03b-0d870245249f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fijarRegla", "[", "r_String", "]"}], ":=", 
    RowBox[{"(", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"regla", "=", "r"}], ";", " ", 
      RowBox[{"n", "=", 
       RowBox[{"StringLength", "[", "regla", "]"}]}], ";", " ", 
      RowBox[{"estados", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{
          RowBox[{"5", " ", "n"}], "-", "1"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"colores", "=", 
       RowBox[{"Association", "[", "\[IndentingNewLine]", "\t\t", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"c", "->", 
            RowBox[{"colorCelda", "[", "c", "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"c", ",", "0", ",", 
             RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", "\t\t", 
         RowBox[{"Flatten", "@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"colorHormiga", "[", 
              RowBox[{"c", ",", "d"}], "]"}], "->", 
             RowBox[{"Darker", "[", 
              RowBox[{
               RowBox[{"colorCelda", "[", "c", "]"}], ",", "0.6"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", "0", ",", "3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"c", ",", "0", ",", 
              RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"nombres", "=", 
       RowBox[{"Association", "[", "\[IndentingNewLine]", "\t\t", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"c", "->", 
            RowBox[{
             RowBox[{"ToString", "[", "c", "]"}], " ", "<>", 
             " ", "\"\<: color \>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", "c", "]"}], " ", "<>", " ", "\"\< (\>\"",
              " ", "<>", " ", 
             RowBox[{"StringTake", "[", 
              RowBox[{"regla", ",", 
               RowBox[{"{", 
                RowBox[{"c", "+", "1"}], "}"}]}], "]"}], " ", "<>", 
             " ", "\"\<)\>\""}]}], ",", 
           RowBox[{"{", 
            RowBox[{"c", ",", "0", ",", 
             RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", "\t\t", 
         RowBox[{"Flatten", "@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"colorHormiga", "[", 
              RowBox[{"c", ",", "d"}], "]"}], "->", 
             RowBox[{
              RowBox[{"ToString", "[", 
               RowBox[{"colorHormiga", "[", 
                RowBox[{"c", ",", "d"}], "]"}], "]"}], " ", "<>", 
              " ", "\"\<: hormiga \>\"", " ", "<>", " ", 
              RowBox[{"flechas", "[", 
               RowBox[{"[", 
                RowBox[{"d", "+", "1"}], "]"}], "]"}], " ", "<>", 
              " ", "\"\<, color \>\"", " ", "<>", " ", 
              RowBox[{"ToString", "[", "c", "]"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", "0", ",", "3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"c", ",", "0", ",", 
              RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], 
     ")"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"generarColores", "[", 
     RowBox[{
     "r_String", ",", "hormigas0_", ",", "ladoX_", ",", "pasosX_", ",", 
      "dir_String"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"evo", ",", "bl", ",", "sal", ",", "fr", ",", "cuadrosX"}], 
       "}"}], ",", "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"fijarRegla", "[", "r", "]"}], ";", " ", "\[IndentingNewLine]",
        "\t", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"evo", ",", "bl"}], "}"}], "=", 
        RowBox[{"simularHormigas", "[", 
         RowBox[{"ladoX", ",", "pasosX", ",", "hormigas0"}], "]"}]}], ";", 
       " ", "\[IndentingNewLine]", "\t", 
       RowBox[{"sal", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"dir", ",", "regla"}], "}"}], "]"}]}], ";", " ", 
       RowBox[{"Quiet", "@", 
        RowBox[{"CreateDirectory", "[", 
         RowBox[{"sal", ",", 
          RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}]}], 
       ";", " ", "\[IndentingNewLine]", "\t", 
       RowBox[{"fr", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"#", "/", 
            RowBox[{"Total", "[", "#", "]"}]}], "]"}], " ", "&"}], "@", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"BinCounts", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", "#", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{"Length", "[", "estados", "]"}], ",", "1"}], "}"}]}], 
             "]"}], " ", "&"}], " ", "/@", " ", "evo"}], "]"}]}]}], ";", " ", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"exportarNPY", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"sal", ",", "\"\<evo.npy\>\""}], "}"}], "]"}], ",", 
         "evo"}], "]"}], ";", " ", "\[IndentingNewLine]", "\t", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"sal", ",", "\"\<evo.mat\>\""}], "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<evolution\>\"", "->", 
           RowBox[{"NumericArray", "[", 
            RowBox[{"evo", ",", "\"\<Integer32\>\""}], "]"}]}], "}"}], 
         ",", "\"\<LabeledData\>\""}], "]"}], ";", " ", "\[IndentingNewLine]",
        "\t", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"sal", ",", "\"\<evo.json\>\""}], "}"}], "]"}], ",", 
         RowBox[{"<|", "\[IndentingNewLine]", "\t\t", 
          RowBox[{
           RowBox[{"\"\<simulation\>\"", "->", "\"\<langton_ant\>\""}], ",", 
           RowBox[{"\"\<rule\>\"", "->", "regla"}], ",", 
           RowBox[{"\"\<colors_count\>\"", "->", "n"}], ",", 
           RowBox[{"\"\<states_count\>\"", "->", 
            RowBox[{"5", " ", "n"}]}], ",", 
           RowBox[{"\"\<ants\>\"", "->", 
            RowBox[{"Length", "[", "hormigas0", "]"}]}], ",", 
           "\[IndentingNewLine]", "\t\t", 
           RowBox[{"\"\<shape\>\"", "->", 
            RowBox[{"Dimensions", "[", "evo", "]"}]}], ",", 
           RowBox[{"\"\<size\>\"", "->", "ladoX"}], ",", 
           RowBox[{"\"\<steps\>\"", "->", "pasosX"}], ",", 
           "\[IndentingNewLine]", "\t\t", 
           RowBox[{"\"\<ants_start\>\"", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<row\>\"", "->", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                 RowBox[{"\"\<col\>\"", "->", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                 RowBox[{"\"\<direction\>\"", "->", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "3", "]"}], "]"}]}]}], "|>"}], " ", "&"}], 
              " ", "/@", " ", "hormigas0"}], ")"}]}], ",", 
           "\[IndentingNewLine]", "\t\t", 
           RowBox[{"\"\<boundary\>\"", "->", "\"\<periodic\>\""}], ",", 
           RowBox[{"\"\<update\>\"", "->", "\"\<sincrona\>\""}], ",", 
           "\[IndentingNewLine]", "\t\t", 
           
           RowBox[{"\"\<exclusion\>\"", 
            "->", "\"\<cada hormiga gira segun su celda; si su destino esta \
ocupado por otra hormiga o si otra hormiga va al mismo destino, queda \
bloqueada: solo gira, sin cambiar el color ni avanzar. Las demas cambian el \
color de su celda y avanzan.\>\""}], ",", "\[IndentingNewLine]", "\t\t", 
           RowBox[{"\"\<blocked_moves\>\"", "->", "bl"}], ",", 
           "\[IndentingNewLine]", "\t\t", 
           
           RowBox[{"\"\<state_encoding\>\"", 
            "->", "\"\<color + n*(direction + 1) en las celdas con hormiga; \
direction 0 arriba, 1 derecha, 2 abajo, 3 izquierda\>\""}], ",", 
           "\[IndentingNewLine]", "\t\t", 
           RowBox[{"\"\<states\>\"", "->", 
            RowBox[{"Values", "[", 
             RowBox[{"KeySort", "[", "nombres", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<colors_hex\>\"", "->", 
            RowBox[{"(", 
             RowBox[{"ToUpperCase", " ", "/@", " ", 
              RowBox[{"(", 
               RowBox[{"hex", " ", "/@", " ", 
                RowBox[{"Values", "[", 
                 RowBox[{"KeySort", "[", "colores", "]"}], "]"}]}], ")"}]}], 
             ")"}]}], ",", "\[IndentingNewLine]", "\t\t", 
           RowBox[{"\"\<state_fraction\>\"", "->", "fr"}]}], "|>"}], 
         ",", "\"\<RawJSON\>\""}], "]"}], ";", " ", "\[IndentingNewLine]", 
       "\t", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"sal", ",", "\"\<colores.csv\>\""}], "}"}], "]"}], ",", 
         RowBox[{"ToUpperCase", " ", "/@", " ", 
          RowBox[{"(", 
           RowBox[{"hex", " ", "/@", " ", 
            RowBox[{"Values", "[", 
             RowBox[{"KeySort", "[", "colores", "]"}], "]"}]}], ")"}]}], 
         ",", "\"\<Lines\>\""}], "]"}], ";", " ", "\[IndentingNewLine]", "\t", 
       RowBox[{"cuadrosX", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"ImageResize", "[", 
           RowBox[{
            RowBox[{"Image", "[", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"List", " ", "@@", " ", 
                 RowBox[{"colores", "[", "#", "]"}]}], " ", "&"}], ",", 
               RowBox[{"evo", "[", 
                RowBox[{"[", 
                 RowBox[{"k", "+", "1"}], "]"}], "]"}], ",", 
               RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", 
            RowBox[{"10", " ", "ladoX"}], ",", 
            RowBox[{"Resampling", "->", "\"\<Nearest\>\""}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", "pasosX", ",", "20"}], "}"}]}], 
         "]"}]}], ";", " ", "\[IndentingNewLine]", "\t", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"sal", ",", "\"\<evo.gif\>\""}], "}"}], "]"}], ",", 
         "cuadrosX", ",", 
         RowBox[{"\"\<DisplayDurations\>\"", "->", "0.04"}], ",", 
         RowBox[{"AnimationRepetitions", "->", "Infinity"}]}], "]"}], ";", 
       " ", "\[IndentingNewLine]", "\t", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"sal", ",", "\"\<evo_final.png\>\""}], "}"}], "]"}], ",", 
         RowBox[{"Last", "[", "cuadrosX", "]"}]}], "]"}], ";", " ", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"{", 
        RowBox[{"regla", ",", 
         RowBox[{"Dimensions", "[", "evo", "]"}], ",", "bl", ",", 
         RowBox[{"Min", "[", 
          RowBox[{"fr", "[", 
           RowBox[{"[", 
            RowBox[{";;", " ", "n"}], "]"}], "]"}], "]"}]}], "}"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reglasColores", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<RL\>\"", ",", "\"\<RLL\>\"", ",", "\"\<RLLR\>\"", 
     ",", "\"\<RLRLL\>\"", ",", "\"\<RRRLLL\>\"", ",", "\"\<RLRLRLL\>\"", 
     ",", "\"\<RLRLRLRR\>\"", ",", "\"\<RLRLRLLRL\>\"", 
     ",", "\"\<RLRLRLRRRL\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"generarColores", "[", 
    RowBox[{"#", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"15", ",", "10", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"15", ",", "20", ",", "3"}], "}"}]}], "}"}], ",", "30", ",", 
     "10000", ",", "\"\<../CA/LangtonAnt/colores_30x30_2hormigas\>\""}], 
    "]"}], " ", "&"}], " ", "/@", " ", "reglasColores"}]}], "Input",Expression\
UUID->"7af32594-05e5-4f9b-b96e-28c2f3855657"],

Cell["Exportar", "Section",ExpressionUUID->"ff52338f-6e26-4ac0-a520-fb8fc042abe4"],

Cell[TextData[{
 "Todo se guarda en ",
 Cell[BoxData[Cell["CA/LangtonAnt/<regla>_<lado>x<lado>/",
   Background->None,ExpressionUUID->"97b50594-542b-443f-9fe9-019d4af5a911"]], 
  "InlineCode",ExpressionUUID->"2fed4d90-7871-41eb-b552-ebee40f1eedb"],
 ", con el mismo formato que exporta el simulador (GUI) y que lee ",
 Cell[BoxData[Cell["scripts/main.py",
   Background->None,ExpressionUUID->"3df37600-e709-4958-9869-6ae2a7530fe9"]], 
  "InlineCode",ExpressionUUID->"4e20a202-dc2a-4d0c-8b13-ce3292777dad"],
 ": la evoluci\[OAcute]n ",
 Cell[BoxData[Cell["(pasos + 1, lado, lado)",
   Background->None,ExpressionUUID->"7fbbf81f-1e0a-4805-aefd-6722182c9d62"]], 
  "InlineCode",ExpressionUUID->"03f58ce5-843b-4910-9446-4fb69cbdefa8"],
 " en enteros de 32 bits, como ",
 Cell[BoxData[Cell["evo.npy",
   Background->None,ExpressionUUID->"5e0906ac-9618-4a15-aede-b5531e4e9503"]], 
  "InlineCode",ExpressionUUID->"2b492cd2-0378-4baf-8835-8f511d47a926"],
 " y como ",
 Cell[BoxData[Cell["evo.mat",
   Background->None,ExpressionUUID->"4e0661a3-7888-4070-b00e-8a0294b48d85"]], 
  "InlineCode",ExpressionUUID->"b7c329b6-fd91-480f-a886-87e4ab976274"],
 " (variable ",
 StyleBox["evolution", "TI"],
 ", comprimido). ",
 Cell[BoxData[Cell["evo.json",
   Background->None,ExpressionUUID->"dbbc69d5-5b5e-49a6-87a3-b73525d65a21"]], 
  "InlineCode",ExpressionUUID->"5af1f947-39e3-4473-b19d-c15161bda20c"],
 " guarda los par\[AAcute]metros, el paso de inicio de la autopista, el \
significado y color de cada estado y la fracci\[OAcute]n de celdas en cada \
estado. Tambi\[EAcute]n se exportan la animaci\[OAcute]n (un cuadro cada ",
 Cell[BoxData[Cell["cadaGif",
   Background->None,ExpressionUUID->"d5ca74dd-c90e-4c7c-a3b2-40003b05b2af"]], 
  "InlineCode",ExpressionUUID->"a56446ed-da47-496c-9a9c-ebb39b2a97be"],
 " pasos, cada celda de ",
 StyleBox["escala", "TI"],
 " \[Times] ",
 StyleBox["escala", "TI"],
 " p\[IAcute]xeles) y las gr\[AAcute]ficas para el documento en ",
 Cell[BoxData[Cell["Documentation/img/langton_<regla>_<lado>x<lado>_*.png",
   Background->None,ExpressionUUID->"a695df8d-b8ea-4074-b75a-f8b4d0975bb8"]], 
  "InlineCode",ExpressionUUID->"f34b7233-d417-44ce-bdf1-14d7012d3b7e"],
 ". La gr\[AAcute]fica de las evoluciones aleatorias va en ",
 Cell[BoxData[
 Cell["Documentation/img/langton_<regla>_aleatorias_proporcion.png",
   Background->None,ExpressionUUID->"e40f2788-1dfa-4383-980c-814db4c5fbb8"]], 
  "InlineCode",ExpressionUUID->"ebf55790-3915-4650-9acc-1a051d16e003"],
 "."
}], "Text",ExpressionUUID->"4fb294f4-57fa-4b08-bf69-23c27752109a"],

Cell[TextData[{
 "Mathematica no exporta ",
 Cell[BoxData[Cell[".npy",
   Background->None,ExpressionUUID->"ebdc0a75-84fa-4e14-a229-fc6c1e03dfb3"]], 
  "InlineCode",ExpressionUUID->"2110dc24-5f85-4c9c-b104-e89261943f00"],
 ", as\[IAcute] que ",
 Cell[BoxData[Cell["exportarNPY",
   Background->None,ExpressionUUID->"fb1b5c79-c9f5-408a-8ad6-a29befc6a0b0"]], 
  "InlineCode",ExpressionUUID->"c542dd84-e45b-4fb7-bd11-2263b228c663"],
 " escribe el formato NPY 1.0 a mano: encabezado con tipo ",
 Cell[BoxData[Cell["<i4",
   Background->None,ExpressionUUID->"4572e0c9-9a99-4a61-a0ba-8c451cfca37a"]], 
  "InlineCode",ExpressionUUID->"9e0e91c7-1f59-43fd-8585-bd297544c10d"],
 ", orden C y forma, y despu\[EAcute]s los datos por bloques. "
}], "Text",ExpressionUUID->"3546ab68-d077-4603-9d80-975f823ddb67"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"exportarNPY", "[", 
    RowBox[{"archivo_String", ",", "datos_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dims", "=", 
        RowBox[{"Dimensions", "[", "datos", "]"}]}], ",", "cab", ",", "s", ",", 
       RowBox[{"b", "=", "500"}]}], "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"cab", "=", 
       RowBox[{"\"\<{'descr': '<i4', 'fortran_order': False, 'shape': (\>\"", 
        " ", "<>", " ", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{
          RowBox[{"ToString", " ", "/@", " ", "dims"}], ",", "\"\<, \>\""}], 
         "]"}], " ", "<>", " ", "\"\<), }\>\""}]}], ";", " ", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"cab", "=", 
       RowBox[{"cab", " ", "<>", " ", 
        RowBox[{"StringRepeat", "[", 
         RowBox[{"\"\< \>\"", ",", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"10", "+", 
               RowBox[{"StringLength", "[", "cab", "]"}], "+", "1"}], ")"}]}],
             ",", "64"}], "]"}]}], "]"}], " ", "<>", " ", "\"\<\\n\>\""}]}], ";",
       " ", "\[IndentingNewLine]", "\t", 
      RowBox[{"s", "=", 
       RowBox[{"OpenWrite", "[", 
        RowBox[{"archivo", ",", 
         RowBox[{"BinaryFormat", "->", "True"}]}], "]"}]}], ";", " ", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"BinaryWrite", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", "147", "}"}], ",", 
          RowBox[{"ToCharacterCode", "[", "\"\<NUMPY\>\"", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}]}], "]"}], 
        ",", "\"\<UnsignedInteger8\>\""}], "]"}], ";", " ", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"BinaryWrite", "[", 
       RowBox[{"s", ",", 
        RowBox[{"StringLength", "[", "cab", "]"}], 
        ",", "\"\<UnsignedInteger16\>\"", ",", 
        RowBox[{"ByteOrdering", "->", 
         RowBox[{"-", "1"}]}]}], "]"}], ";", " ", "\[IndentingNewLine]", "\t", 
      RowBox[{"BinaryWrite", "[", 
       RowBox[{"s", ",", "cab", ",", "\"\<Character8\>\""}], "]"}], ";", " ", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"BinaryWrite", "[", 
         RowBox[{"s", ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{"datos", "[", 
             RowBox[{"[", 
              RowBox[{"i", " ", ";;", " ", 
               RowBox[{"Min", "[", 
                RowBox[{
                 RowBox[{"i", "+", "b", "-", "1"}], ",", 
                 RowBox[{"First", "[", "dims", "]"}]}], "]"}]}], "]"}], "]"}],
             "]"}], "]"}], ",", "\"\<Integer32\>\"", ",", 
          RowBox[{"ByteOrdering", "->", 
           RowBox[{"-", "1"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"First", "[", "dims", "]"}], ",", "b"}], "}"}]}], "]"}], ";",
       " ", "\[IndentingNewLine]", "\t", 
      RowBox[{"Close", "[", "s", "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hex", "[", "c_", "]"}], ":=", 
    RowBox[{"\"\<#\>\"", " ", "<>", " ", 
     RowBox[{"StringJoin", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"IntegerString", "[", 
