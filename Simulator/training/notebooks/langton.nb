    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 5}}],
  ImageMargins->{{0, 0}, {5, 5}}]], "TextTableForm", \
"Text",ExpressionUUID->"695c9906-508c-4714-9e02-b471410b098d"],

Cell[TextData[{
 Cell[BoxData[Cell["fijarRegla",
   Background->None,ExpressionUUID->"a2ea0be5-a460-4fb5-8634-bb6c5eff88e9"]], 
  "InlineCode",ExpressionUUID->"828b7d30-7beb-4f6a-a107-4293db2096dc"],
 " cambia la regla y todo lo que depende de ",
 StyleBox["n", "TI"],
 ". ",
 Cell[BoxData[Cell["generarColores",
   Background->None,ExpressionUUID->"1a8daa73-7b0b-43f4-aac5-19142e247601"]], 
  "InlineCode",ExpressionUUID->"331f33fa-c8b1-405d-b0ac-c0a19ba4f43d"],
 " simula y exporta en ",
 Cell[BoxData[Cell["CA/LangtonAnt/colores_30x30_2hormigas/<regla>/",
   Background->None,ExpressionUUID->"39485314-f8f7-4336-829b-efc6e9d1e323"]], 
  "InlineCode",ExpressionUUID->"78c5b4ca-464d-4902-925d-7c1cc59309ca"],
 " la evoluci\[OAcute]n (",
 Cell[BoxData[Cell["evo.npy",
   Background->None,ExpressionUUID->"240a42d3-a6e1-4653-ba5a-0d1f569a04ff"]], 
  "InlineCode",ExpressionUUID->"b7b6d332-76b4-46f9-86b4-e57d2c5a39ff"],
 ", ",
 Cell[BoxData[Cell["evo.mat",
   Background->None,ExpressionUUID->"5c985a34-158d-4d19-8bab-ced144836ef4"]], 
  "InlineCode",ExpressionUUID->"6cb31fd5-8a4d-4ec7-ad61-5f2e8f6a660a"],
 ", ",
 Cell[BoxData[Cell["evo.json",
   Background->None,ExpressionUUID->"206963db-b03e-4e9e-99d8-fd2fbbf1fbbe"]], 
  "InlineCode",ExpressionUUID->"b5fdffdc-acfe-473b-aa23-2db3f24ac35e"],
 "), la paleta para la GUI (",
 Cell[BoxData[Cell["colores.csv",
   Background->None,ExpressionUUID->"0d46d61f-a582-442f-b180-77799205581f"]], 
  "InlineCode",ExpressionUUID->"69f17784-e786-4366-8a14-36f8712920cf"],
 ", un color por estado), la animaci\[OAcute]n y el \[UAcute]ltimo paso. \
Requiere ",
 Cell[BoxData[Cell["simularHormigas",
   Background->None,ExpressionUUID->"11e173c6-b42b-4a11-bd92-78b58693b507"]], 
  "InlineCode",ExpressionUUID->"ea2bed67-ea62-46db-9089-e4f8338a6966"],
 " y las celdas de \"Colores por estado\" y \"Exportar\"."
}], "Text",ExpressionUUID->"2f4b8bf8-75f6-4e31-bb34-cd8807c92376"],

