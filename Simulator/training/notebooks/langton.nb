Cell[BoxData[{
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"regla", "=", "\"\<RL\>\""}], ";"}], "                    ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"una", " ", "letra", " ", "por", " ", 
     RowBox[{"color", ":", " ", "R"}]}], ",", " ", "L", ",", " ", 
    RowBox[{"N", " ", "o", " ", "U"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lado", "=", "100"}], ";"}], "                      ", 
  RowBox[{"(*", " ", 
   RowBox[{"espacio", " ", "de", " ", "lado", " ", "\[Times]", " ", "lado"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pasos", "=", "11000"}], ";"}], "                   ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "con", " ", "RL", " ", "la", " ", "autopista", " ", "aparece", " ", 
    "cerca", " ", "del", " ", "paso", " ", "10", " ", "000"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"inicio", "=", 
    RowBox[{"{", 
     RowBox[{"50", ",", "50"}], "}"}]}], ";"}], "               ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"fila", ",", " ", "columna"}], "}"}], " ", "inicial", " ", "de", 
    " ", "la", " ", "hormiga"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"direccion", "=", "0"}], ";"}], "                   ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"0", " ", "arriba"}], ",", " ", 
    RowBox[{"1", " ", "derecha"}], ",", " ", 
    RowBox[{"2", " ", "abajo"}], ",", " ", 
    RowBox[{"3", " ", "izquierda"}]}], " ", "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"!", " ", 
      RowBox[{"StringMatchQ", "[", 
       RowBox[{"regla", ",", 
        RowBox[{
         RowBox[{"(", 
          
          RowBox[{"\"\<R\>\"", " ", "|", " ", "\"\<L\>\"", " ", "|", 
           " ", "\"\<N\>\"", " ", "|", " ", "\"\<U\>\""}], ")"}], " ", 
         ".."}]}], "]"}]}], "||", 
     RowBox[{
      RowBox[{"StringLength", "[", "regla", "]"}], "<", "2"}]}], ",", 
    "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
     "Print", "[", "\"\<La regla debe tener al menos 2 letras R, L, N o U\>\"",
       "]"}], ";", " ", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"StringLength", "[", "regla", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"giros", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<R\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<L\>\"", "->", 
      RowBox[{"-", "1"}]}], ",", 
     RowBox[{"\"\<N\>\"", "->", "0"}], ",", 
     RowBox[{"\"\<U\>\"", "->", "2"}]}], "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"movimientos", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"flechas", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<\[UpArrow]\>\"", ",", "\"\<\[RightArrow]\>\"", 
     ",", "\"\<\[DownArrow]\>\"", ",", "\"\<\[LeftArrow]\>\""}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"colorHormiga", "[", 
    RowBox[{"c_", ",", "d_"}], "]"}], ":=", 
   RowBox[{"c", "+", 
    RowBox[{"n", " ", 
     RowBox[{"(", 
      RowBox[{"d", "+", "1"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"estados", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", 
     RowBox[{
      RowBox[{"5", " ", "n"}], "-", "1"}]}], "]"}]}], ";"}]}], "Input",Express\
ionUUID->"0185d030-93df-407b-9c6a-3fed3bb8c7fa"],

Cell["Simulaci\[OAcute]n", "Section",ExpressionUUID->"186148b8-3c0a-40f3-83c3-5c731bf3a5d8"],

Cell[TextData[{
 "Para no ocupar memoria de m\[AAcute]s, los cuadros se guardan en bloques de \
enteros de 8 bits (",
 Cell[BoxData[
  TemplateBox[{
   "NumericArray", "paclet:ref/NumericArray", 
    "https://reference.wolfram.com/language/ref/NumericArray.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "e71a33db-1778-4307-84e1-86aba1c3cd13"],
 "). Adem\[AAcute]s del espacio, se registran los conteos de celdas de cada \
color y la posici\[OAcute]n de la hormiga sin envolver en el borde (para \
medir su distancia al inicio). "
}], "Text",ExpressionUUID->"1ea462f1-f83c-4da1-86c8-8c43d301fb67"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bloque", "=", "500"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"simular", "[", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"lado", ",", "lado"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"p", "=", "inicio"}], ",", 
        RowBox[{"d", "=", "direccion"}], ",", 
        RowBox[{"q", "=", "inicio"}], ",", "\[IndentingNewLine]", "\t\t", 
        RowBox[{"gs", "=", 
         RowBox[{"Lookup", "[", 
          RowBox[{"giros", ",", 
           RowBox[{"Characters", "[", "regla", "]"}]}], "]"}]}], ",", "c", ",", 
        RowBox[{"trozos", "=", 
         RowBox[{"{", "}"}]}], ",", "trozo", ",", 
        RowBox[{"i", "=", "0"}], ",", "conteo", ",", "conteos", ",", 
        "posiciones", ",", "guardar"}], "}"}], ",", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{
       RowBox[{"conteo", "=", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", "n"}], "]"}], ",", 
          RowBox[{"1", "->", 
           RowBox[{"lado", "^", "2"}]}]}], "]"}]}], ";", " ", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"conteos", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pasos", "+", "1"}], ",", "n"}], "}"}]}], "]"}]}], ";", 
       " ", 
       RowBox[{"posiciones", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pasos", "+", "1"}], ",", "2"}], "}"}]}], "]"}]}], ";", 
       " ", "\[IndentingNewLine]", "\t", 
       RowBox[{"trozo", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"bloque", ",", "lado", ",", "lado"}], "}"}]}], "]"}]}], ";",
        " ", "\[IndentingNewLine]", "\t", 
       RowBox[{
        RowBox[{"guardar", "[", "k_", "]"}], ":=", 
        RowBox[{"(", "\[IndentingNewLine]", "\t\t", 
         RowBox[{
          RowBox[{"i", "++"}], ";", " ", 
          RowBox[{
           RowBox[{"trozo", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "=", "g"}], ";", " ", 
          RowBox[{
           RowBox[{"trozo", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"p", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"p", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "=", 
           RowBox[{"colorHormiga", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"p", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"p", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], ",", "d"}], 
            "]"}]}], ";", " ", "\[IndentingNewLine]", "\t\t", 
          RowBox[{
           RowBox[{"conteos", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "1"}], "]"}], "]"}], "=", "conteo"}], ";", " ", 
          RowBox[{
           RowBox[{"posiciones", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "1"}], "]"}], "]"}], "=", "q"}], ";", " ", 
          "\[IndentingNewLine]", "\t\t", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "==", "bloque"}], ",", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"trozos", ",", 
               RowBox[{"NumericArray", "[", 
                RowBox[{"trozo", ",", "\"\<Integer8\>\""}], "]"}]}], "]"}], ";",
              " ", 
             RowBox[{"i", "=", "0"}]}]}], "]"}]}], ")"}]}], ";", " ", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"guardar", "[", "0", "]"}], ";", " ", "\[IndentingNewLine]", 
       "\t", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "\t\t", 
        RowBox[{
         RowBox[{
          RowBox[{"c", "=", 
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"p", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"p", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}]}], ";", " ", 
          "\[IndentingNewLine]", "\t\t", 
          RowBox[{"d", "=", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"d", "+", 
              RowBox[{"gs", "[", 
               RowBox[{"[", 
                RowBox[{"c", "+", "1"}], "]"}], "]"}]}], ",", "4"}], "]"}]}], 
          ";", " ", "\[IndentingNewLine]", "\t\t", 
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"p", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"p", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "=", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"c", "+", "1"}], ",", "n"}], "]"}]}], ";", " ", 
          "\[IndentingNewLine]", "\t\t", 
          RowBox[{
           RowBox[{"conteo", "[", 
            RowBox[{"[", 
             RowBox[{"c", "+", "1"}], "]"}], "]"}], "--"}], ";", " ", 
          RowBox[{
           RowBox[{"conteo", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"c", "+", "1"}], ",", "n"}], "]"}], "+", "1"}], "]"}],
             "]"}], "++"}], ";", " ", "\[IndentingNewLine]", "\t\t", 
          RowBox[{"q", " ", "+=", " ", 
           RowBox[{"movimientos", "[", 
            RowBox[{"[", 
             RowBox[{"d", "+", "1"}], "]"}], "]"}]}], ";", " ", 
          "\[IndentingNewLine]", "\t\t", 
          RowBox[{"p", "=", 
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"p", "+", 
               RowBox[{"movimientos", "[", 
                RowBox[{"[", 
                 RowBox[{"d", "+", "1"}], "]"}], "]"}], "-", "1"}], ",", 
              "lado"}], "]"}], "+", "1"}]}], ";", " ", "\[IndentingNewLine]", 
          "\t\t", 
          RowBox[{"guardar", "[", "k", "]"}]}], ",", "\[IndentingNewLine]", 
         "\t\t", 
         RowBox[{"{", 
          RowBox[{"k", ",", "pasos"}], "}"}]}], "]"}], ";", " ", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", ">", "0"}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"trozos", ",", 
           RowBox[{"NumericArray", "[", 
            RowBox[{
             RowBox[{"trozo", "[", 
              RowBox[{"[", " ", 
               RowBox[{";;", " ", "i"}], "]"}], "]"}], 
             ",", "\"\<Integer8\>\""}], "]"}]}], "]"}]}], "]"}], ";", " ", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Join", " ", "@@", " ", "trozos"}], ",", "conteos", ",", 
         "posiciones"}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"evolucion", ",", "conteos", ",", "posiciones"}], "}"}], "=", 
   RowBox[{"simular", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cuadro", "[", "k_", "]"}], ":=", 
   RowBox[{"Normal", "[", 
    RowBox[{"evolucion", "[", 
     RowBox[{"[", 
      RowBox[{"k", "+", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "[", "evolucion", "]"}], ",", 
   RowBox[{"Union", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"cuadro", "[", "pasos", "]"}], "]"}], "]"}], ",", 
   RowBox[{"conteos", "[", 
    RowBox[{"[", 
     RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}]}], "Input",ExpressionUUID->\
"ead1bb7d-89e3-4cca-b919-6a6a72b02e94"],

Cell["Inicio de la autopista", "Section",ExpressionUUID->"f8d9bc60-e3db-4837-84a0-f240c2a05721"],

Cell[TextData[{
 "La autopista de ",
 Cell[BoxData["\"\<RL\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "fc59b8c9-6c7f-4d58-b705-a711c4f0690a"],
 " repite el mismo recorrido cada 104 pasos y en cada periodo avanza 2 celdas \
en cada eje. ",
 Cell[BoxData[Cell["inicioCarretera",
   Background->None,ExpressionUUID->"eaffa5e7-13c4-44e5-8f71-2549bb86f0fe"]], 
  "InlineCode",ExpressionUUID->"650d9693-0686-4bb6-886c-cc54da55d5bb"],
 " es el \[UAcute]ltimo paso a partir del cual los movimientos de la hormiga \
se repiten con ese periodo hasta el final de la simulaci\[OAcute]n. Con 100 \
\[Times] 100 y la hormiga en ",
 Cell[BoxData[Cell["{50, 50}",
   Background->None,ExpressionUUID->"24d8e451-8f8b-48db-841f-79eb81542138"]], 
  "InlineCode",ExpressionUUID->"07b34bca-9327-42c0-b08e-810d0e626de2"],
 " sale el paso 9 976, con un avance de ",
 Cell[BoxData[Cell["{2, \[Minus]2}",
   Background->None,ExpressionUUID->"6efd82b4-a67e-4631-a9bf-15cb933d384b"]], 
  "InlineCode",ExpressionUUID->"6f0a3553-8b58-42e5-b302-056250f8a85d"],
 " por periodo. "
}], "Text",ExpressionUUID->"58f2913e-24e7-4bab-8025-40b644c78923"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"periodo", "=", "104"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"movs", "=", 
   RowBox[{"Differences", "[", "posiciones", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"iguales", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Boole", "[", 
      RowBox[{
       RowBox[{"movs", "[", 
        RowBox[{"[", "k", "]"}], "]"}], "==", 
       RowBox[{"movs", "[", 
        RowBox[{"[", 
         RowBox[{"k", "+", "periodo"}], "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{
        RowBox[{"Length", "[", "movs", "]"}], "-", "periodo"}]}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"inicioCarretera", "=", 
   RowBox[{
    RowBox[{"Length", "[", "iguales", "]"}], "-", 
    RowBox[{"LengthWhile", "[", 
     RowBox[{
      RowBox[{"Reverse", "[", "iguales", "]"}], ",", 
      RowBox[{
       RowBox[{"#", "==", "1"}], " ", "&"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"inicioCarretera", ",", 
   RowBox[{
    RowBox[{"posiciones", "[", 
     RowBox[{"[", 
      RowBox[{"-", "1"}], "]"}], "]"}], "-", 
    RowBox[{"posiciones", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"-", "1"}], "-", "periodo"}], "]"}], "]"}]}], ",", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"pasos", "-", "inicioCarretera"}], ")"}], "/", "periodo"}], 
    "]"}]}], "}"}]}], "Input",ExpressionUUID->"80791a45-ed97-4dea-a456-\
90e2e83ff22c"],

Cell["Colores por estado", "Section",ExpressionUUID->"dd79a633-fecf-4512-83be-ca7f3597d117"],

Cell[TextData[{
 "Cada color de celda tiene su color; la hormiga usa el mismo color \
oscurecido. En los espacios, una flecha negra marca la posici\[OAcute]n y \
direcci\[OAcute]n de la hormiga. Con m\[AAcute]s de 9 colores se interpola la \
paleta. ",
 Cell[BoxData[Cell["paletaCSV",
   Background->None,ExpressionUUID->"d01bb275-b02f-4efc-be46-cad8e2a7d406"]], 
  "InlineCode",ExpressionUUID->"310270fb-f29e-48d2-9811-ad45742aa2a2"],
 " es la paleta de la GUI para ",
 Cell[BoxData["\"\<RL\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "df1dc79b-7359-4e8a-b893-bba5193ff8ad"],
 " (",
 Cell[BoxData[Cell["Simulator/GUI/colores/langton_blanco_negro.csv",
   Background->None,ExpressionUUID->"834a4bc0-b0a5-4795-9024-2aaa79f324d6"]], 
  "InlineCode",ExpressionUUID->"ab272b70-57eb-46e1-a807-3144003d0bba"],
 "): blanco y gris ",
 Cell[BoxData[Cell["#C5C5C5",
   Background->None,ExpressionUUID->"4f103e2a-53b3-48c5-9ae1-d9a64a9aeb70"]], 
  "InlineCode",ExpressionUUID->"74977dbb-9598-45f7-93ee-dc5297b1dd6b"],
 " para los colores 0 y 1, azules para la hormiga sobre el 0 y rosas para la \
hormiga sobre el 1, de claro (\[UpArrow]) a oscuro (\[LeftArrow]). "
}], "Text",ExpressionUUID->"1c512d93-f731-4972-8cce-c3de89dadb70"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"paleta", "=", 
   RowBox[{"RGBColor", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<#f0efec\>\"", ",", "\"\<#2a78d6\>\"", ",", "\"\<#eb6834\>\"",
       ",", "\"\<#1baf7a\>\"", ",", "\"\<#eda100\>\"", ",", "\"\<#e87ba4\>\"",
       ",", "\"\<#008300\>\"", ",", "\"\<#4a3aa7\>\"", 
      ",", "\"\<#e34948\>\""}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"colorCelda", "[", "c_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"n", "<=", 
      RowBox[{"Length", "[", "paleta", "]"}]}], ",", 
     RowBox[{"paleta", "[", 
      RowBox[{"[", 
       RowBox[{"c", "+", "1"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"c", "==", "0"}], ",", 
       RowBox[{"First", "[", "paleta", "]"}], ",", 
       RowBox[{"Blend", "[", 
        RowBox[{
         RowBox[{"Rest", "[", "paleta", "]"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"c", "-", "1"}], ")"}], "/", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", 
            RowBox[{"n", "-", "2"}]}], "]"}]}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"colores", "=", 
   RowBox[{"Association", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"c", "->", 
        RowBox[{"colorCelda", "[", "c", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", "0", ",", 
         RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"colorHormiga", "[", 
          RowBox[{"c", ",", "d"}], "]"}], "->", 
         RowBox[{"Darker", "[", 
          RowBox[{
           RowBox[{"colorCelda", "[", "c", "]"}], ",", "0.6"}], "]"}]}], ",", 
        
        RowBox[{"{", 
         RowBox[{"d", ",", "0", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"c", ",", "0", ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nombres", "=", 
   RowBox[{"Association", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"c", "->", 
        RowBox[{
         RowBox[{"ToString", "[", "c", "]"}], " ", "<>", 
         " ", "\"\<: color \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "c", "]"}], " ", "<>", " ", "\"\< (\>\"", 
         " ", "<>", " ", 
         RowBox[{"StringTake", "[", 
          RowBox[{"regla", ",", 
           RowBox[{"{", 
            RowBox[{"c", "+", "1"}], "}"}]}], "]"}], " ", "<>", 
         " ", "\"\<)\>\""}]}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", "0", ",", 
         RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"colorHormiga", "[", 
          RowBox[{"c", ",", "d"}], "]"}], "->", 
         RowBox[{
          RowBox[{"ToString", "[", 
           RowBox[{"colorHormiga", "[", 
            RowBox[{"c", ",", "d"}], "]"}], "]"}], " ", "<>", 
          " ", "\"\<: hormiga \>\"", " ", "<>", " ", 
          RowBox[{"flechas", "[", 
           RowBox[{"[", 
            RowBox[{"d", "+", "1"}], "]"}], "]"}], " ", "<>", 
          " ", "\"\<, color \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", "c", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"d", ",", "0", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"c", ",", "0", ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"leyendaEstados", "=", 
   RowBox[{"SwatchLegend", "[", 
    RowBox[{
     RowBox[{"Values", "[", 
      RowBox[{"KeySort", "[", "colores", "]"}], "]"}], ",", 
     RowBox[{"Values", "[", 
      RowBox[{"KeySort", "[", "nombres", "]"}], "]"}], ",", 
     RowBox[{"LegendMarkerSize", "->", "14"}], ",", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"LegendMarkers", "->", 
      RowBox[{"Graphics", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"EdgeForm", "[", 
          RowBox[{"GrayLevel", "[", "0.6", "]"}], "]"}], ",", 
         RowBox[{"Rectangle", "[", "]"}]}], "}"}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"paletaCSV", "=", 
    RowBox[{"RGBColor", " ", "/@", " ", 
     RowBox[{"StringTrim", " ", "/@", " ", 
      RowBox[{"ReadList", "[", 
       RowBox[{"\"\<../../GUI/colores/langton_blanco_negro.csv\>\"", ",", 
        "String"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"marcaHormiga", "[", "f_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"pos", "=", 
        RowBox[{"First", "@", 
         RowBox[{"Position", "[", 
          RowBox[{"f", ",", 
           RowBox[{"s_", " ", "/;", " ", 
            RowBox[{"s", ">=", "n"}]}], ",", 
           RowBox[{"{", "2", "}"}], ",", "1"}], "]"}]}]}], ",", "d", ",", 
       "centro", ",", "v"}], "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"d", "=", 
       RowBox[{
        RowBox[{"Quotient", "[", 
         RowBox[{
          RowBox[{"Extract", "[", 
           RowBox[{"f", ",", "pos"}], "]"}], ",", "n"}], "]"}], "-", "1"}]}], 
      ";", " ", 
      RowBox[{"centro", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"pos", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", "0.5"}], ",", 
         RowBox[{"lado", "-", 
          RowBox[{"pos", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "+", "0.5"}]}], "}"}]}], ";", " ", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"v", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], "[", 
        RowBox[{"[", 
         RowBox[{"d", "+", "1"}], "]"}], "]"}]}], ";", " ", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"{", 
       RowBox[{"Black", ",", 
        RowBox[{"Thickness", "[", "0.012", "]"}], ",", 
        RowBox[{"Arrowheads", "[", "0.09", "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"centro", "-", 
            RowBox[{"4", " ", "v"}]}], ",", 
           RowBox[{"centro", "+", 
            RowBox[{"4", " ", "v"}]}]}], "}"}], "]"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"espacio", "[", 
    RowBox[{"k_", ",", "opts___"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", "=", 
       RowBox[{"cuadro", "[", "k", "]"}]}], "}"}], ",", 
     RowBox[{"ArrayPlot", "[", 
      RowBox[{"f", ",", 
       RowBox[{"ColorRules", "->", 
        RowBox[{"Normal", "[", "colores", "]"}]}], ",", "\[IndentingNewLine]",
        "\t", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameTicks", "->", "None"}], ",", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"GrayLevel", "[", "0.6", "]"}]}], ",", 
       RowBox[{"Epilog", "->", 
        RowBox[{"marcaHormiga", "[", "f", "]"}]}], ",", "\[IndentingNewLine]",
        "\t", 
       RowBox[{"PlotLabel", "->", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"\"\<Paso \>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "k", "]"}]}], ",", "Black", ",", "12"}], 
         "]"}]}], ",", 
       RowBox[{"ImageSize", "->", "160"}], ",", "opts"}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"092b9813-ee9b-4520-a4c0-b525a82cfb38"],

Cell["Gr\[AAcute]ficas", "Section",ExpressionUUID->"cdba7a9c-1b07-4743-9416-e0f49c488d2a"],

Cell[TextData[{
 "Estilo com\[UAcute]n con ",
 Cell[BoxData[Cell["gol_proportions.nb",
   Background->None,ExpressionUUID->"6b7cf60e-ea17-425c-ab7c-93ed51cadf0a"]], 
  "InlineCode",ExpressionUUID->"4d710524-af50-4ea8-886c-354716c2a7c9"],
 " y ",
 Cell[BoxData[Cell["sandpile.nb",
   Background->None,ExpressionUUID->"172f479f-bee5-4e28-a30f-e6735681639c"]], 
  "InlineCode",ExpressionUUID->"b0ae729b-b05c-40d8-b5bc-377211c4a07e"],
 ". "
}], "Text",ExpressionUUID->"39008442-203d-47bb-bea0-2dab1aff4703"],

Cell[BoxData[
 RowBox[{
  RowBox[{"estilo", "=", 
   RowBox[{"Sequence", "[", 
    RowBox[{
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"Axes", "->", "False"}], ",", 
     RowBox[{"FrameStyle", "->", 
      RowBox[{"GrayLevel", "[", "0.4", "]"}]}], ",", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"FrameTicksStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "11"}], "]"}]}], ",", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "12"}], "]"}]}], ",", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"GridLinesStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"GrayLevel", "[", "0.85", "]"}], "]"}]}], ",", 
     RowBox[{"ImageSize", "->", "400"}], ",", 
     RowBox[{"AspectRatio", "->", 
      RowBox[{"3", "/", "4"}]}]}], "]"}]}], ";"}]], "Input",ExpressionUUID->\
"aba4609f-e9c6-438c-88d2-f6ab978b89bb"],

Cell["Espacio en varios pasos", "Subsection",ExpressionUUID->"23e69770-3785-44ac-b74a-74765d760abd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pasosMuestra", "=", 
   RowBox[{"Round", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "0.05", ",", "0.2", ",", "0.5", ",", "0.8", ",", "0.95", ",", "1"}], 
      "}"}], " ", "pasos"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"graficaEspacios", "=", 
  RowBox[{"Legended", "[", 
   RowBox[{
    RowBox[{"GraphicsGrid", "[", 
     RowBox[{
      RowBox[{"Partition", "[", 
       RowBox[{
        RowBox[{"espacio", " ", "/@", " ", "pasosMuestra"}], ",", "3"}], 
       "]"}], ",", 
      RowBox[{"Spacings", "->", 
       RowBox[{"{", 
        RowBox[{"10", ",", "10"}], "}"}]}]}], "]"}], ",", 
    "\[IndentingNewLine]", "\t", 
    RowBox[{"Placed", "[", 
     RowBox[{"leyendaEstados", ",", "After"}], "]"}]}], "]"}]}]}], "Input",Exp\
ressionUUID->"d9aaaf1f-6a16-4cbf-bcb6-f492b9c08368"],

Cell["Captura de un paso", "Subsection",ExpressionUUID->"c5ac25b1-b5b3-49f2-96ad-a3f65fb93f93"],

Cell["\<\
Un paso con la paleta de la GUI y malla gris, sin t\[IAcute]tulo, como las \
capturas de sandpile del documento. \
\>", "Text",ExpressionUUID->"931eaf14-59a4-44e7-b87c-433ad609a31c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"captura", "[", "k_", "]"}], ":=", 
   RowBox[{"ArrayPlot", "[", 
    RowBox[{
     RowBox[{"cuadro", "[", "k", "]"}], ",", 
     RowBox[{"ColorRules", "->", 
      RowBox[{"Thread", "[", 
       RowBox[{"estados", "->", "paletaCSV"}], "]"}]}], ",", 
     RowBox[{"Mesh", "->", "All"}], ",", 
     RowBox[{"MeshStyle", "->", 
      RowBox[{"GrayLevel", "[", 
       RowBox[{"0.85", ",", "0.6"}], "]"}]}], ",", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameTicks", "->", "None"}], ",", 
     RowBox[{"FrameStyle", "->", 
      RowBox[{"GrayLevel", "[", "0.6", "]"}]}], ",", 
     RowBox[{"ImageSize", "->", "460"}], ",", 
     RowBox[{"PlotRangePadding", "->", "0"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"captura", "[", "10000", "]"}]}], "Input",ExpressionUUID->"f8995de1-\
e2a8-4953-bc9a-a0efffdd2ed8"],

Cell["Celdas de cada color", "Subsection",ExpressionUUID->"9c13b178-6d5e-4ee3-ada8-f50cfb9ae447"],

Cell["\<\
El color 0 es el fondo, as\[IAcute] que no se grafica. Con una sola serie no \
se agrega leyenda. \
\>", "Text",ExpressionUUID->"29eaa30f-c355-4680-ba52-1505b83e6ead"],

Cell[BoxData[
 RowBox[{"graficaColores", "=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cs", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"1", ",", 
        RowBox[{"n", "-", "1"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]",
     "\t", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", "=", 
        RowBox[{"ListLinePlot", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"conteos", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", 
              RowBox[{"cs", "+", "1"}]}], "]"}], "]"}], "]"}], ",", 
          RowBox[{"DataRange", "->", 
           RowBox[{"{", 
            RowBox[{"0", ",", "pasos"}], "}"}]}], ",", "\[IndentingNewLine]", 
          "\t\t\t", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Directive", "[", 
               RowBox[{
                RowBox[{"colores", "[", "#", "]"}], ",", 
                RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], " ", 
              "&"}], " ", "/@", " ", "cs"}], ")"}]}], ",", 
          "\[IndentingNewLine]", "\t\t\t", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "pasos"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "Automatic"}], "}"}]}], "}"}]}], ",", 
          RowBox[{"GridLines", "->", 
           RowBox[{"{", 
            RowBox[{"None", ",", "Automatic"}], "}"}]}], ",", 
          "\[IndentingNewLine]", "\t\t\t", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<Paso\>\"", ",", "\"\<Celdas\>\""}], "}"}]}], ",", 
          "\[IndentingNewLine]", "\t\t\t", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"n", "==", "2"}], ",", "\"\<Celdas de color 1\>\"", 
             ",", "\"\<Celdas por color (sin el color 0)\>\""}], "]"}]}], ",",
           "estilo"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", "\t\t", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"n", "==", "2"}], ",", "g", ",", 
        RowBox[{"Legended", "[", 
         RowBox[{"g", ",", 
          RowBox[{"LineLegend", "[", 
           RowBox[{
            RowBox[{"colores", " ", "/@", " ", "cs"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\"\<Color \>\"", " ", "<>", " ", 
                RowBox[{"ToString", "[", "#", "]"}]}], ")"}], " ", "&"}], " ",
              "/@", " ", "cs"}], ",", 
            RowBox[{"LegendMarkerSize", "->", 
             RowBox[{"{", 
              RowBox[{"20", ",", "10"}], "}"}]}]}], "]"}]}], "]"}]}], "]"}]}],
      "]"}]}], "]"}]}]], "Input",ExpressionUUID->"375b30fa-f6b8-4856-b616-\
c2c55ddfa689"],

Cell["Distancia al inicio", "Subsection",ExpressionUUID->"123702f8-46ae-4f98-a2ee-63b47b3b642b"],

Cell["\<\
Distancia euclidiana entre la hormiga y su posici\[OAcute]n inicial, sin \
envolver en el borde. Cuando la hormiga construye una autopista la distancia \
crece linealmente. \
\>", "Text",ExpressionUUID->"47e3a332-5a1d-4306-b499-b65288191660"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"distancia", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"Norm", "[", 
       RowBox[{"#", "-", "inicio"}], "]"}], "]"}], " ", "&"}], " ", "/@", " ",
     "posiciones"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"graficaDistancia", "=", 
  RowBox[{"ListLinePlot", "[", 
   RowBox[{"distancia", ",", 
    RowBox[{"DataRange", "->", 
     RowBox[{"{", 
      RowBox[{"0", ",", "pasos"}], "}"}]}], ",", "\[IndentingNewLine]", "\t", 
    
    RowBox[{"PlotStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{
       RowBox[{"RGBColor", "[", "\"\<#2a78d6\>\"", "]"}], ",", 
       RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", "\t", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "pasos"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "Automatic"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"GridLines", "->", 
     RowBox[{"{", 
      RowBox[{"None", ",", "Automatic"}], "}"}]}], ",", "\[IndentingNewLine]",
     "\t", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Paso\>\"", ",", "\"\<Distancia\>\""}], "}"}]}], ",", 
    RowBox[{"PlotLabel", "->", "\"\<Distancia de la hormiga al inicio\>\""}], 
    ",", "estilo"}], "]"}]}]}], "Input",ExpressionUUID->"c21a6803-c6d8-427d-\
b79e-8c4890823e6c"],

Cell["Proporci\[OAcute]n de estados", "Subsection",ExpressionUUID->"480655ff-91e0-477a-8b96-ad57dd040a04"],

Cell[TextData[{
 "Proporci\[OAcute]n de cada estado sobre todas las celdas de todos los pasos \
(",
 Cell[BoxData[Cell["pasos + 1",
   Background->None,ExpressionUUID->"b69002f6-ac91-4236-a517-92b2509fe1fa"]], 
  "InlineCode",ExpressionUUID->"e8fcd540-6b0c-4234-8229-d24ea4be006f"],
 " cuadros de ",
 Cell[BoxData[Cell["lado \[Times] lado",
   Background->None,ExpressionUUID->"ae3b29ab-caf1-4f48-b0c3-0850b30cc679"]], 
  "InlineCode",ExpressionUUID->"1d041fd2-226d-41ef-9eac-9f9cad1e318d"],
 "). ",
 Cell[BoxData[Cell["conteoPorPaso[[k + 1]]",
   Background->None,ExpressionUUID->"ffcc0b17-db8c-4e84-8793-ac519cdfa5f6"]], 
  "InlineCode",ExpressionUUID->"37339b06-cf74-4c95-a4e9-2ec9da16b4fe"],
 " tiene las celdas de cada estado en el paso ",
 StyleBox["k", "TI"],
 "; de ah\[IAcute] salen la media, la desviaci\[OAcute]n est\[AAcute]ndar, el \
m\[IAcute]nimo y el m\[AAcute]ximo de la fracci\[OAcute]n de cada estado por \
paso (",
 StyleBox["resumen", "TI"],
 "). ",
 Cell[BoxData[Cell["fasesHormiga",
   Background->None,ExpressionUUID->"a2967a19-6d53-49ed-9dbe-9c303b1409d2"]], 
  "InlineCode",ExpressionUUID->"dca945fc-b809-4de4-bdd2-d1c745890d28"],
 " da la fracci\[OAcute]n de pasos que la hormiga pasa en cada estado antes y \
despu\[EAcute]s de ",
 Cell[BoxData[Cell["inicioCarretera",
   Background->None,ExpressionUUID->"cd7e7a1f-40a5-4681-b4fc-e8bc4bc7eeb0"]], 
  "InlineCode",ExpressionUUID->"2c3ea57e-a327-4585-9d21-83d56269e6ef"],
 "."
}], "Text",ExpressionUUID->"8289892d-dcb5-4698-88b7-9b427cae2714"],

Cell[TextData[{
 "El eje y es logar\[IAcute]tmico porque la hormiga es una sola celda por \
cuadro; cada barra lleva su porcentaje. Las celdas sin hormiga van en azul \
(claro el color 0, medio el color 1) y las celdas con hormiga en naranja \
(claro sobre el color 0, medio sobre el color 1), como en ",
 Cell[BoxData[Cell["sandpile.nb",
   Background->None,ExpressionUUID->"1b6d8bcc-df8c-495a-a976-23cb88a406c6"]], 
  "InlineCode",ExpressionUUID->"1af46054-afbd-4984-a8da-ddf6b622f111"],
 ". Debajo de cada estado se indica la direcci\[OAcute]n y el color de la \
celda con hormiga. "
}], "Text",ExpressionUUID->"20c81903-1528-4e83-bf3a-700e72c2b4c0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"conteoPorPaso", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"BinCounts", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"cuadro", "[", "k", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"Length", "[", "estados", "]"}], ",", "1"}], "}"}]}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "pasos"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"conteoEstados", "=", 
   RowBox[{"Total", "[", "conteoPorPaso", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"proporcionEstados", "=", 
   RowBox[{"N", "[", 
    RowBox[{"conteoEstados", "/", 
     RowBox[{"Total", "[", "conteoEstados", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fraccionPorPaso", "=", 
   RowBox[{"N", "[", 
    RowBox[{"conteoPorPaso", "/", 
     RowBox[{"lado", "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"resumen", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", ",", 
       RowBox[{"conteoEstados", "[", 
        RowBox[{"[", 
         RowBox[{"s", "+", "1"}], "]"}], "]"}], ",", 
       RowBox[{"proporcionEstados", "[", 
        RowBox[{"[", 
         RowBox[{"s", "+", "1"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
       "\t\t", 
       RowBox[{"Mean", "[", 
        RowBox[{"fraccionPorPaso", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"s", "+", "1"}]}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"StandardDeviation", "[", 
        RowBox[{"fraccionPorPaso", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"s", "+", "1"}]}], "]"}], "]"}], "]"}], ",", 
       "\[IndentingNewLine]", "\t\t", 
       RowBox[{"Min", "[", 
        RowBox[{"fraccionPorPaso", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"s", "+", "1"}]}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"Max", "[", 
        RowBox[{"fraccionPorPaso", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"s", "+", "1"}]}], "]"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "estados"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TableForm", "[", 
   RowBox[{"resumen", ",", 
    RowBox[{"TableHeadings", "->", 
     RowBox[{"{", 
      RowBox[{"None", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Estado\>\"", ",", "\"\<Celdas\>\"", 
         ",", "\"\<Proporci\[OAcute]n\>\"", ",", "\"\<Media por paso\>\"", 
         ",", "\"\<Desv. est.\>\"", ",", "\"\<M\[IAcute]n\>\"", 
         ",", "\"\<M\[AAcute]x\>\""}], "}"}]}], "}"}]}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"estadoHormiga", "=", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{"#", ",", "1"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"conteoPorPaso", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{
          RowBox[{"n", "+", "1"}], " ", ";;"}]}], "]"}], "]"}]}], "]"}], "+", 
    "n", "-", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"fasesHormiga", "=", 
  RowBox[{"KeySort", " ", "/@", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Counts", "[", 
        RowBox[{"estadoHormiga", "[", 
         RowBox[{"[", 
          RowBox[{";;", " ", 
           RowBox[{"inicioCarretera", "+", "1"}]}], "]"}], "]"}], "]"}], "/", 
       
       RowBox[{"(", 
        RowBox[{"inicioCarretera", "+", "1"}], ")"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Counts", "[", 
        RowBox[{"estadoHormiga", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"inicioCarretera", "+", "2"}], " ", ";;"}], "]"}], "]"}], 
        "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"pasos", "-", "inicioCarretera"}], ")"}]}], "]"}]}], 
    "}"}]}]}]}], "Input",ExpressionUUID->"f2b66fcb-560f-49b7-b99e-\
f47e818e362a"],

Cell[TextData[{
 Cell[BoxData[Cell["porcentaje[p, dec]",
   Background->None,ExpressionUUID->"caca5f73-bd4a-480b-ba80-52227cc459f8"]], 
  "InlineCode",ExpressionUUID->"20e63a36-56c6-401c-8a24-0e514e8ce17b"],
 " escribe los porcentajes de 0.1 % o m\[AAcute]s con ",
 StyleBox["dec", "TI"],
 " decimales (1 por omisi\[OAcute]n) y los menores con 2 cifras \
significativas. "
}], "Text",ExpressionUUID->"f45a2991-ca64-47e3-8759-ff80974dfefe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"colorBarra", "[", "s_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"s", "<", "n"}], ",", 
     RowBox[{"Blend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"RGBColor", "[", "\"\<#cfe0f6\>\"", "]"}], ",", 
         RowBox[{"RGBColor", "[", "\"\<#2a78d6\>\"", "]"}], ",", 
         RowBox[{"RGBColor", "[", "\"\<#0b2f5e\>\"", "]"}]}], "}"}], ",", 
       RowBox[{"0.5", " ", 
        RowBox[{"s", "/", 
         RowBox[{"(", 
          RowBox[{"n", "-", "1"}], ")"}]}]}]}], "]"}], ",", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"Blend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"RGBColor", "[", "\"\<#fbd9c9\>\"", "]"}], ",", 
         RowBox[{"RGBColor", "[", "\"\<#eb6834\>\"", "]"}], ",", 
         RowBox[{"RGBColor", "[", "\"\<#6b2208\>\"", "]"}]}], "}"}], ",", 
       RowBox[{"0.5", " ", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"s", ",", "n"}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"n", "-", "1"}], ")"}]}]}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"etiquetaEstado", "[", "s_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"s", "<", "n"}], ",", 
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", ",", "\"\< \>\""}], "}"}], ",", 
       RowBox[{"Alignment", "->", "Center"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", ",", 
         RowBox[{
          RowBox[{"flechas", "[", 
           RowBox[{"[", 
            RowBox[{"Quotient", "[", 
             RowBox[{"s", ",", "n"}], "]"}], "]"}], "]"}], " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"Mod", "[", 
            RowBox[{"s", ",", "n"}], "]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"porcentaje", "[", 
    RowBox[{"p_", ",", 
     RowBox[{"dec_", " ", ":", " ", "1"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"ToString", "[", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"p", ">=", "0.001"}], ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"100", " ", "p"}], ",", 
         RowBox[{"{", 
          RowBox[{"Infinity", ",", "dec"}], "}"}]}], "]"}], ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"100", " ", "p"}], ",", "2"}], "]"}]}], "]"}], "]"}], " ", "<>",
     " ", "\"\<%\>\""}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"divisionesLog", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"10", "^", "k"}], ",", 
        RowBox[{"Superscript", "[", 
         RowBox[{"10", ",", "k"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"-", "6"}], ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Con", " ", "ScalingFunctions"}], " ", "->", " ", 
    RowBox[{"\"\<Log\>\"", " ", "las", " ", "coordenadas", " ", "del", " ", 
     "Epilog", " ", "van", " ", "en", " ", "logaritmo", " ", "natural"}]}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"graficaProporcion", "[", 
     RowBox[{"proporcion_", ",", "titulo_", ",", 
      RowBox[{"dec_", " ", ":", " ", "1"}]}], "]"}], ":=", 
    RowBox[{"BarChart", "[", 
     RowBox[{"proporcion", ",", "\[IndentingNewLine]", "\t", 
      RowBox[{"ChartStyle", "->", 
       RowBox[{"(", 
        RowBox[{"colorBarra", " ", "/@", " ", "estados"}], ")"}]}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"ChartLabels", "->", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"etiquetaEstado", " ", "/@", " ", "estados"}], ",", "Axis"}],
         "]"}]}], ",", "\[IndentingNewLine]", "\t", 
      RowBox[{"ScalingFunctions", "->", "\"\<Log\>\""}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"10", "^", 
          RowBox[{"-", "6"}]}], ",", "50"}], "}"}]}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"Epilog", "->", 
       RowBox[{"MapIndexed", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Text", "[", 
           RowBox[{
            RowBox[{"Rotate", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"porcentaje", "[", 
                 RowBox[{"#1", ",", "dec"}], "]"}], ",", "9", ",", "Black"}], 
               "]"}], ",", 
              RowBox[{"90", " ", "Degree"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"First", "[", "#2", "]"}], ",", 
              RowBox[{"Log", "[", "#1", "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"-", "1.3"}]}], "}"}]}], "]"}], " ", "&"}], ",", 
         "proporcion"}], "]"}]}], ",", "\[IndentingNewLine]", "\t", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"Axes", "->", "False"}], ",", 
      RowBox[{"FrameStyle", "->", 
       RowBox[{"GrayLevel", "[", "0.4", "]"}]}], ",", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{"FrameTicks", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"divisionesLog", ",", "None"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Automatic", ",", "None"}], "}"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"FrameTicksStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "11"}], "]"}]}], ",", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "12"}], "]"}]}], ",", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{"GridLines", "->", 
       RowBox[{"{", 
        RowBox[{"None", ",", 
         RowBox[{"divisionesLog", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"GridLinesStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"GrayLevel", "[", "0.85", "]"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Estado\>\"", ",", "\"\<Proporci\[OAcute]n\>\""}], 
        "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", "titulo"}], ",", "\[IndentingNewLine]", "\t", 
      RowBox[{"ImageSize", "->", "400"}], ",", 
      RowBox[{"AspectRatio", "->", 
       RowBox[{"3", "/", "4"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"graficaProporcionEstados", "=", 
  RowBox[{"graficaProporcion", "[", 
   RowBox[{
   "proporcionEstados", 
    ",", "\"\<Proporci\[OAcute]n de estados en toda la \
evoluci\[OAcute]n\>\""}], "]"}]}]}], "Input",ExpressionUUID->"a49d71f8-f7ad-\
4aa5-895a-aecafab296ea"],

Cell["Evoluciones aleatorias", "Section",ExpressionUUID->"f712bee9-777e-453a-af34-1a63ccfe4772"],

Cell[TextData[{
 Cell[BoxData[Cell["nMuestras",
   Background->None,ExpressionUUID->"76bceb5a-1cb6-4232-81ca-233a2e92ddf9"]], 
  "InlineCode",ExpressionUUID->"605cba0e-51a5-47a3-88eb-dce16cc27e6b"],
 " espacios de ",
 Cell[BoxData[Cell["ladoMuestras \[Times] ladoMuestras",
   Background->None,ExpressionUUID->"8e09a0bf-bb2e-4e00-abf5-c0eaa88e1686"]], 
  "InlineCode",ExpressionUUID->"336db373-c076-4045-8424-1113fd680712"],
 " con cada celda de un color aleatorio uniforme y una sola hormiga en una \
posici\[OAcute]n y direcci\[OAcute]n aleatorias. Cada muestra evoluciona ",
 Cell[BoxData[Cell["pasosMuestras",
   Background->None,ExpressionUUID->"eaf07587-93c3-41e0-bc51-5c0d65561ec6"]], 
  "InlineCode",ExpressionUUID->"4348e621-1dd9-4d0d-a536-0793daf540a6"],
 " pasos con la misma regla y bordes peri\[OAcute]dicos."
}], "Text",ExpressionUUID->"c3602e4f-2119-4b9c-b7a1-b8ee9788fdb2"],

Cell[TextData[{
 "Las evoluciones no se guardan: como cada paso solo cambia una celda, ",
 Cell[BoxData[Cell["conteoMuestra",
   Background->None,ExpressionUUID->"cf32e813-fd81-4170-be12-3bca73dba2f0"]], 
  "InlineCode",ExpressionUUID->"98cb5776-c4f3-4f95-ac21-3ab937c76e91"],
 " lleva el conteo de colores y en cada cuadro (incluido el 0) suma los \
colores, resta la celda de la hormiga y suma su estado. ",
 Cell[BoxData[Cell["cuadrosMuestra",
   Background->None,ExpressionUUID->"ad853798-4b19-4354-afa5-3e5e4fa7a765"]], 
  "InlineCode",ExpressionUUID->"c59335c7-df36-40da-b376-69f102a2145d"],
 " genera los cuadros completos de una muestra para comprobar que el conteo \
coincide."
}], "Text",ExpressionUUID->"17789acb-7986-400c-9a66-1bf47fb07155"],

Cell[TextData[{
 "Como los colores iniciales son uniformes, los estados 0 y 1 quedan cerca de \
50 % cada uno (49.996 % y 49.994 % con ",
 Cell[BoxData[
  RowBox[{"SeedRandom", "[", "42", "]"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "27e91af5-289b-41e0-bb32-c40b9f407351"],
 "), as\[IAcute] que la gr\[AAcute]fica usa 3 decimales. "
}], "Text",ExpressionUUID->"75ea2cc1-44f0-422d-bcab-c753c1c1be30"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nMuestras", "=", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ladoMuestras", "=", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pasosMuestras", "=", "1000"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"muestras", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"n", "-", "1"}], ",", 
          RowBox[{"{", 
           RowBox[{"ladoMuestras", ",", "ladoMuestras"}], "}"}]}], "]"}], ",", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "ladoMuestras"}], "}"}], ",", "2"}], "]"}], ",", 
        
        RowBox[{"RandomInteger", "[", "3", "]"}]}], "}"}], ",", "nMuestras"}],
      "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"conteoMuestra", "[", 
    RowBox[{"{", 
     RowBox[{"g0_", ",", "p0_", ",", "d0_"}], "}"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"g", "=", "g0"}], ",", 
       RowBox[{"p", "=", "p0"}], ",", 
       RowBox[{"d", "=", "d0"}], ",", "c", ",", "conteo", ",", 
       RowBox[{"t", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"5", " ", "n"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       "\t\t", 
       RowBox[{"gs", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"giros", ",", 
          RowBox[{"Characters", "[", "regla", "]"}]}], "]"}]}], ",", 
       "acumular"}], "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"conteo", "=", 
       RowBox[{"BinCounts", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", "g", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "n", ",", "1"}], "}"}]}], "]"}]}], ";", " ", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"acumular", ":=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"t", "[", 
           RowBox[{"[", 
            RowBox[{";;", " ", "n"}], "]"}], "]"}], " ", "+=", " ", 
          "conteo"}], ";", " ", 
         RowBox[{
          RowBox[{"t", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"p", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"p", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "+", "1"}], 
            "]"}], "]"}], "--"}], ";", " ", 
         RowBox[{
          RowBox[{"t", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"colorHormiga", "[", 
              RowBox[{
               RowBox[{"g", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"p", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], ",", 
                  RowBox[{"p", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], ",", "d"}],
               "]"}], "+", "1"}], "]"}], "]"}], "++"}]}], ")"}]}], ";", " ", 
      "\[IndentingNewLine]", "\t", "acumular", ";", " ", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"c", "=", 
          RowBox[{"g", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"p", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"p", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}]}], ";", " ", 
         RowBox[{"d", "=", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"d", "+", 
             RowBox[{"gs", "[", 
              RowBox[{"[", 
               RowBox[{"c", "+", "1"}], "]"}], "]"}]}], ",", "4"}], "]"}]}], ";",
          " ", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"p", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"p", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "=", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"c", "+", "1"}], ",", "n"}], "]"}]}], ";", " ", 
         "\[IndentingNewLine]", "\t\t", 
         RowBox[{
          RowBox[{"conteo", "[", 
           RowBox[{"[", 
            RowBox[{"c", "+", "1"}], "]"}], "]"}], "--"}], ";", " ", 
         RowBox[{
          RowBox[{"conteo", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{"c", "+", "1"}], ",", "n"}], "]"}], "+", "1"}], "]"}], 
           "]"}], "++"}], ";", " ", "\[IndentingNewLine]", "\t\t", 
         RowBox[{"p", "=", 
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"p", "+", 
              RowBox[{"movimientos", "[", 
               RowBox[{"[", 
                RowBox[{"d", "+", "1"}], "]"}], "]"}], "-", "1"}], ",", 
             "ladoMuestras"}], "]"}], "+", "1"}]}], ";", " ", "acumular"}], ",", 
        RowBox[{"{", "pasosMuestras", "}"}]}], "]"}], ";", " ", 
      "\[IndentingNewLine]", "\t", "t"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cuadrosMuestra", "[", 
     RowBox[{"{", 
      RowBox[{"g0_", ",", "p0_", ",", "d0_"}], "}"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g", "=", "g0"}], ",", 
        RowBox[{"p", "=", "p0"}], ",", 
        RowBox[{"d", "=", "d0"}], ",", "c", ",", 
        RowBox[{"gs", "=", 
         RowBox[{"Lookup", "[", 
          RowBox[{"giros", ",", 
           RowBox[{"Characters", "[", "regla", "]"}]}], "]"}]}], ",", "f", ",",
         "primero"}], "}"}], ",", "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", "]"}], ":=", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{"g", ",", 
          RowBox[{"p", "->", 
           RowBox[{"colorHormiga", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"p", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"p", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], ",", "d"}], 
            "]"}]}]}], "]"}]}], ";", " ", "\[IndentingNewLine]", "\t", 
       RowBox[{"primero", "=", 
        RowBox[{"f", "[", "]"}]}], ";", " ", "\[IndentingNewLine]", "\t", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"c", "=", 
             RowBox[{"g", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"p", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"p", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}]}], ";", " ", 
            RowBox[{"d", "=", 
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{"d", "+", 
                RowBox[{"gs", "[", 
                 RowBox[{"[", 
                  RowBox[{"c", "+", "1"}], "]"}], "]"}]}], ",", "4"}], 
              "]"}]}], ";", " ", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"p", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"p", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "=", 
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{"c", "+", "1"}], ",", "n"}], "]"}]}], ";", " ", 
            "\[IndentingNewLine]", "\t\t", 
            RowBox[{"p", "=", 
             RowBox[{
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"p", "+", 
                 RowBox[{"movimientos", "[", 
                  RowBox[{"[", 
                   RowBox[{"d", "+", "1"}], "]"}], "]"}], "-", "1"}], ",", 
                "ladoMuestras"}], "]"}], "+", "1"}]}], ";", " ", 
            RowBox[{"f", "[", "]"}]}], ",", 
           RowBox[{"{", "pasosMuestras", "}"}]}], "]"}], ",", "primero"}], 
        "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"conteoMuestra", "[", 
      RowBox[{"muestras", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "]"}], "==", 
     RowBox[{"BinCounts", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"cuadrosMuestra", "[", 
         RowBox[{"muestras", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"5", " ", "n"}], ",", "1"}], "}"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "3"}], "}"}]}], "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"conteosMuestras", "=", 
   RowBox[{"conteoMuestra", " ", "/@", " ", "muestras"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"conteoAleatorias", "=", 
   RowBox[{"Total", "[", "conteosMuestras", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"proporcionAleatorias", "=", 
   RowBox[{"N", "[", 
    RowBox[{"conteoAleatorias", "/", 
     RowBox[{"Total", "[", "conteoAleatorias", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"graficaProporcionAleatorias", "=", 
  RowBox[{"graficaProporcion", "[", 
   RowBox[{
   "proporcionAleatorias", 
    ",", "\"\<Proporci\[OAcute]n de estados en 100 evoluciones aleatorias\>\"",
     ",", "3"}], "]"}]}]}], "Input",ExpressionUUID->"2712078d-1dfe-4f00-8ba3-\
238ff6bba7cf"],

Cell["Dos hormigas con exclusi\[OAcute]n", "Section",ExpressionUUID->"06e49717-21a3-4d72-8992-ad8bef097687"],

Cell["\<\
Varias hormigas en el mismo espacio, con los mismos estados (las hormigas no \
se distinguen entre s\[IAcute]). La actualizaci\[OAcute]n es s\[IAcute]ncrona \
y ninguna celda puede tener dos hormigas:\
\>", "Text",ExpressionUUID->"08ceeba1-84aa-4ceb-b8fa-bd24d15a25af"],

Cell["1. todas las hormigas leen el color de su celda y giran;", "Text",ExpressionUUID->"784f3800-01d9-428b-b4a6-9e91fafac31a"],

Cell["\<\
2. una hormiga queda bloqueada si su celda destino est\[AAcute] ocupada por \
otra hormiga o si otra hormiga va al mismo destino; la hormiga bloqueada solo \
gira: no cambia el color de su celda ni avanza;\
\>", "Text",ExpressionUUID->"1f334ef7-2149-4923-9e64-ec5c4de51112"],

Cell[TextData[{
 "3. las hormigas no bloqueadas cambian el color de su celda y avanzan. ",
 StyleBox["hormigas", "TI"],
 " es la lista de ",
 Cell[BoxData[Cell["{fila, columna, direcci\[OAcute]n}",
   Background->None,ExpressionUUID->"2b2c6c9e-1b87-46c0-afb3-3424a9ef8517"]], 
  "InlineCode",ExpressionUUID->"732e0c27-61dc-4c50-9cbc-6b1e127eeefd"],
 " iniciales y ",
 Cell[BoxData[Cell["bloqueosH",
   Background->None,ExpressionUUID->"9b186f8d-ff92-4c14-bfb9-d65db4e5f63d"]], 
  "InlineCode",ExpressionUUID->"2ba6f48e-a74f-4a38-ad39-fad2a957539c"],
 " cuenta los movimientos bloqueados. Con ",
 Cell[BoxData[Cell["{15, 10}",
   Background->None,ExpressionUUID->"9d36eaf6-876a-4554-af29-531c94a23d31"]], 
  "InlineCode",ExpressionUUID->"9a06a927-28b3-4e81-a0f2-f762f3c760fa"],
 " \[RightArrow] y ",
 Cell[BoxData[Cell["{15, 20}",
   Background->None,ExpressionUUID->"b2e1411f-121e-470c-810d-2366d35e77c6"]], 
  "InlineCode",ExpressionUUID->"0c9e161d-e662-4020-aae5-05044bf26f9e"],
 " \[LeftArrow] en 30 \[Times] 30 hay 46 bloqueos en 10 000 pasos; con ",
 Cell[BoxData[Cell["{10, 10}",
   Background->None,ExpressionUUID->"31f17f25-457a-4ad7-b12f-0378eb97fbae"]], 
  "InlineCode",ExpressionUUID->"3e43f2c6-f36f-4558-bc99-4a31054a2848"],
 " \[UpArrow] y ",
 Cell[BoxData[Cell["{21, 21}",
   Background->None,ExpressionUUID->"41e10b41-916f-41c9-bf8e-80bc82367ab3"]], 
  "InlineCode",ExpressionUUID->"ebdb4686-148a-44a6-9fdd-97aad0f2dc2e"],
 " \[DownArrow] no hay ninguno. Las dos hormigas empiezan sim\[EAcute]tricas \
respecto al centro, as\[IAcute] que la evoluci\[OAcute]n es sim\[EAcute]trica \
con una rotaci\[OAcute]n de 180\[Degree]."
}], "Text",ExpressionUUID->"5a094725-6dc4-45a0-8954-5a71360f4266"],

Cell[TextData[{
 "Como un bloqueo depende de otra hormiga a dos celdas de distancia (dos \
hormigas que van al mismo destino), la regla no es determinista con la \
vecindad de Von Neumann (38 patrones ambiguos en estos datos); con el rombo \
de radio 2 (13 celdas, ",
 Cell[BoxData[Cell["|dx| + |dy| \[LessEqual] 2",
   Background->None,ExpressionUUID->"206b142d-dc78-4a2e-9dd7-aa6cba373b02"]], 
  "InlineCode",ExpressionUUID->"9718c1ee-3c6a-4f09-9d6a-277d74efde3b"],
 ") s\[IAcute] lo es. "
}], "Text",ExpressionUUID->"5c2d5025-4db0-4ee3-b408-359fceff8c9c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"simularHormigas", "[", 
     RowBox[{"ladoH_", ",", "pasosH_", ",", "hormigas0_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"ladoH", ",", "ladoH"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"hs", "=", "hormigas0"}], ",", 
        RowBox[{"gs", "=", 
         RowBox[{"Lookup", "[", 
          RowBox[{"giros", ",", 
           RowBox[{"Characters", "[", "regla", "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", "\t\t", "evo", ",", "cuadroH", ",", "c", ",", 
        "t", ",", "ocupadas", ",", "bloq", ",", 
        RowBox[{"bloqueos", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{
       RowBox[{
        RowBox[{"cuadroH", "[", "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"f", "=", "g"}], "}"}], ",", 
          RowBox[{
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"f", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"h", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"h", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "=", 
              RowBox[{"colorHormiga", "[", 
               RowBox[{
                RowBox[{"g", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"h", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                   RowBox[{"h", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], ",", 
                RowBox[{"h", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"h", ",", "hs"}], "}"}]}], "]"}], ";", " ", "f"}]}], 
         "]"}]}], ";", " ", "\[IndentingNewLine]", "\t", 
       RowBox[{"evo", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pasosH", "+", "1"}], ",", "ladoH", ",", "ladoH"}], 
           "}"}]}], "]"}]}], ";", " ", 
       RowBox[{
        RowBox[{"evo", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", 
        RowBox[{"cuadroH", "[", "]"}]}], ";", " ", "\[IndentingNewLine]", 
       "\t", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "\t\t", 
        RowBox[{"(*", " ", 
         RowBox[{
         "1.", " ", "todas", " ", "leen", " ", "su", " ", "celda", " ", "y", " ",
           "giran"}], " ", "*)"}], "\[IndentingNewLine]", "\t\t", 
        RowBox[{
         RowBox[{
          RowBox[{"hs", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"h", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"h", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", 
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"h", "[", 
                   RowBox[{"[", "3", "]"}], "]"}], "+", 
                  RowBox[{"gs", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"g", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"h", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"h", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "+", 
                    "1"}], "]"}], "]"}]}], ",", "4"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"h", ",", "hs"}], "}"}]}], "]"}]}], ";", " ", 
          "\[IndentingNewLine]", "\t\t", 
          RowBox[{"t", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"h", "[", 
                  RowBox[{"[", 
                   RowBox[{";;", " ", "2"}], "]"}], "]"}], "+", 
                 RowBox[{"movimientos", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"h", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], "+", "1"}], "]"}], "]"}], 
                 "-", "1"}], ",", "ladoH"}], "]"}], "+", "1"}], ",", 
             RowBox[{"{", 
              RowBox[{"h", ",", "hs"}], "}"}]}], "]"}]}], ";", " ", 
          "\[IndentingNewLine]", "\t\t", 
          RowBox[{"ocupadas", "=", 
           RowBox[{"hs", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", 
              RowBox[{";;", " ", "2"}]}], "]"}], "]"}]}], ";", " ", 
          "\[IndentingNewLine]", "\t\t", 
          RowBox[{"(*", " ", 
           RowBox[{
           "2.", " ", "bloqueada", " ", "si", " ", "su", " ", "destino", " ", 
            "est\[AAcute]", " ", "ocupado", " ", "o", " ", "si", " ", "otra", 
            " ", "hormiga", " ", "va", " ", "al", " ", "mismo", " ", 
            "destino"}], " ", "*)"}], "\[IndentingNewLine]", "\t\t", 
          RowBox[{"bloq", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"Delete", "[", 
                 RowBox[{"ocupadas", ",", "i"}], "]"}], ",", 
                RowBox[{"t", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "||", 
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"Delete", "[", 
                 RowBox[{"t", ",", "i"}], "]"}], ",", 
                RowBox[{"t", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"Length", "[", "hs", "]"}]}], "}"}]}], "]"}]}], ";", 
          " ", "\[IndentingNewLine]", "\t\t", 
          RowBox[{"bloqueos", " ", "+=", " ", 
           RowBox[{"Count", "[", 
            RowBox[{"bloq", ",", "True"}], "]"}]}], ";", " ", 
          "\[IndentingNewLine]", "\t\t", 
          RowBox[{"(*", " ", 
           RowBox[{
           "3.", " ", "las", " ", "no", " ", "bloqueadas", " ", "cambian", " ",
             "el", " ", "color", " ", "de", " ", "su", " ", "celda", " ", "y",
             " ", "avanzan"}], " ", "*)"}], "\[IndentingNewLine]", "\t\t", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", " ", 
               RowBox[{"bloq", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"g", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"hs", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                   RowBox[{"hs", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], "=", 
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"g", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"hs", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"hs", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], "+",
                    "1"}], ",", "n"}], "]"}]}], ";", " ", 
               RowBox[{
                RowBox[{"hs", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", 
                   RowBox[{";;", " ", "2"}]}], "]"}], "]"}], "=", 
                RowBox[{"t", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"Length", "[", "hs", "]"}]}], "}"}]}], "]"}], ";", " ", 
          "\[IndentingNewLine]", "\t\t", 
          RowBox[{
           RowBox[{"evo", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "1"}], "]"}], "]"}], "=", 
           RowBox[{"cuadroH", "[", "]"}]}]}], ",", "\[IndentingNewLine]", 
         "\t\t", 
         RowBox[{"{", 
          RowBox[{"k", ",", "pasosH"}], "}"}]}], "]"}], ";", " ", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"{", 
        RowBox[{"evo", ",", "bloqueos"}], "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hormigas", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"15", ",", "10", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"15", ",", "20", ",", "3"}], "}"}]}], "}"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{"fila", ",", " ", "columna", ",", " ", "direcci\[OAcute]n"}], 
    "}"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ladoH", "=", "30"}], ";", " ", 
  RowBox[{"pasosH", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"evoH", ",", "bloqueosH"}], "}"}], "=", 
   RowBox[{"simularHormigas", "[", 
    RowBox[{"ladoH", ",", "pasosH", ",", "hormigas"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fraccionH", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"#", "/", 
       RowBox[{"Total", "[", "#", "]"}]}], "]"}], " ", "&"}], "@", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"BinCounts", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", "#", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"Length", "[", "estados", "]"}], ",", "1"}], "}"}]}], 
        "]"}], " ", "&"}], " ", "/@", " ", "evoH"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "[", "evoH", "]"}], ",", "bloqueosH", ",", 
   RowBox[{"Union", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Count", "[", 
       RowBox[{"#", ",", 
        RowBox[{"_", "?", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#", ">=", "n"}], " ", "&"}], ")"}]}], ",", "2"}], "]"}], 
      " ", "&"}], " ", "/@", " ", "evoH"}], "]"}]}], "}"}]}], "Input",Expressi\
onUUID->"509270fc-7d08-4db2-8ac4-141ae79e27a5"],

Cell[TextData[{
 "La celda de ",
 Cell[BoxData[Cell["exportarNPY",
   Background->None,ExpressionUUID->"c4e1eb8b-061f-4ae9-9be5-cc0c95a50c59"]], 
  "InlineCode",ExpressionUUID->"317dfda6-d074-446c-b15e-398f5d1a40f0"],
 " (secci\[OAcute]n \"Exportar\") debe evaluarse antes de exportar. "
}], "Text",ExpressionUUID->"95003064-8103-468b-98ba-0a4d7e0f66bd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"salidaH", "=", "\"\<../CA/LangtonAnt/RL_30x30_2hormigas\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Quiet", "@", 
   RowBox[{"CreateDirectory", "[", "salidaH", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"exportarNPY", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"salidaH", ",", "\"\<evo.npy\>\""}], "}"}], "]"}], ",", 
    "evoH"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"salidaH", ",", "\"\<evo.mat\>\""}], "}"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"\"\<evolution\>\"", "->", 
      RowBox[{"NumericArray", "[", 
       RowBox[{"evoH", ",", "\"\<Integer32\>\""}], "]"}]}], "}"}], 
    ",", "\"\<LabeledData\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"salidaH", ",", "\"\<evo.json\>\""}], "}"}], "]"}], ",", 
    RowBox[{"<|", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"\"\<simulation\>\"", "->", "\"\<langton_ant\>\""}], ",", 
      RowBox[{"\"\<rule\>\"", "->", "regla"}], ",", 
      RowBox[{"\"\<colors_count\>\"", "->", "n"}], ",", 
      RowBox[{"\"\<ants\>\"", "->", 
       RowBox[{"Length", "[", "hormigas", "]"}]}], ",", "\[IndentingNewLine]",
       "\t", 
      RowBox[{"\"\<shape\>\"", "->", 
       RowBox[{"Dimensions", "[", "evoH", "]"}]}], ",", 
      RowBox[{"\"\<size\>\"", "->", "ladoH"}], ",", 
      RowBox[{"\"\<steps\>\"", "->", "pasosH"}], ",", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{"\"\<ants_start\>\"", "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<row\>\"", "->", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", 
            RowBox[{"\"\<col\>\"", "->", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ",", 
            RowBox[{"\"\<direction\>\"", "->", 
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}]}], "|>"}], " ", "&"}], " ", "/@",
          " ", "hormigas"}], ")"}]}], ",", "\[IndentingNewLine]", "\t", 
      RowBox[{"\"\<boundary\>\"", "->", "\"\<periodic\>\""}], ",", 
      RowBox[{"\"\<update\>\"", "->", "\"\<sincrona\>\""}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"\"\<exclusion\>\"", 
       "->", "\"\<cada hormiga gira segun su celda; si su destino esta \
ocupado por otra hormiga o si otra hormiga va al mismo destino, queda \
bloqueada: solo gira, sin cambiar el color ni avanzar. Las demas cambian el \
color de su celda y avanzan.\>\""}], ",", "\[IndentingNewLine]", "\t", 
      RowBox[{"\"\<blocked_moves\>\"", "->", "bloqueosH"}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"\"\<state_encoding\>\"", 
       "->", "\"\<color + n*(direction + 1) en las celdas con hormiga; \
direction 0 arriba, 1 derecha, 2 abajo, 3 izquierda\>\""}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"\"\<states\>\"", "->", 
       RowBox[{"Values", "[", 
        RowBox[{"KeySort", "[", "nombres", "]"}], "]"}]}], ",", 
      RowBox[{"\"\<colors_hex\>\"", "->", 
       RowBox[{"(", 
        RowBox[{"ToUpperCase", " ", "/@", " ", 
         RowBox[{"(", 
          RowBox[{"hex", " ", "/@", " ", "paletaCSV"}], ")"}]}], ")"}]}], ",",
       "\[IndentingNewLine]", "\t", 
      RowBox[{"\"\<state_fraction\>\"", "->", "fraccionH"}]}], "|>"}], 
    ",", "\"\<RawJSON\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cuadrosH", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ImageResize", "[", 
      RowBox[{
       RowBox[{"Image", "[", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"List", " ", "@@", " ", 
            RowBox[{"paletaCSV", "[", 
             RowBox[{"[", 
              RowBox[{"#", "+", "1"}], "]"}], "]"}]}], " ", "&"}], ",", 
          RowBox[{"evoH", "[", 
           RowBox[{"[", 
            RowBox[{"k", "+", "1"}], "]"}], "]"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"10", " ", "ladoH"}], ",", 
       RowBox[{"Resampling", "->", "\"\<Nearest\>\""}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "pasosH", ",", "20"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"salidaH", ",", "\"\<evo.gif\>\""}], "}"}], "]"}], ",", 
    "cuadrosH", ",", 
    RowBox[{"\"\<DisplayDurations\>\"", "->", "0.04"}], ",", 
    RowBox[{"AnimationRepetitions", "->", "Infinity"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"salidaH", ",", "\"\<evo_final.png\>\""}], "}"}], "]"}], ",", 
    RowBox[{"Last", "[", "cuadrosH", "]"}]}], "]"}], ";"}]}], "Input",Expressi\
onUUID->"c3728722-c129-4da4-b6cf-e31599fc3d31"],

Cell["Barrido de colores con dos hormigas", "Section",ExpressionUUID->"7121db44-8188-4e43-b477-28e88dc6bbdf"],

Cell[TextData[{
 "La misma configuraci\[OAcute]n de la secci\[OAcute]n anterior (dos hormigas \
con exclusi\[OAcute]n en ",
 Cell[BoxData[Cell["{15, 10}",
   Background->None,ExpressionUUID->"9a216a16-4886-4a9c-ab89-8e950cf491ac"]], 
  "InlineCode",ExpressionUUID->"4ec3be37-8686-4a23-9237-43f247eff0e9"],
 " \[RightArrow] y ",
 Cell[BoxData[Cell["{15, 20}",
   Background->None,ExpressionUUID->"fbb2a974-cab2-4209-adc0-f22b8de08c1a"]], 
  "InlineCode",ExpressionUUID->"6582a265-10f7-414a-8809-7d83f3f23f82"],
 " \[LeftArrow], 30 \[Times] 30, 10 000 pasos) con reglas de 2 a 10 colores, \
es decir, de 10 a 50 estados."
}], "Text",ExpressionUUID->"1db073fe-61a5-47b5-a054-25f19cc12807"],

Cell[TextData[{
 "Para cada n\[UAcute]mero de colores ",
 StyleBox["n", "TI"],
 " se usa una sola regla, elegida con el mismo criterio para todas: entre las \
reglas de ",
 Cell[BoxData[Cell["R",
   Background->None,ExpressionUUID->"1e50bb54-7e99-4b3e-b83c-bb9b9839784e"]], 
  "InlineCode",ExpressionUUID->"31d7b863-6390-4f9c-93cb-bf472fa192ea"],
 " y ",
 Cell[BoxData[Cell["L",
   Background->None,ExpressionUUID->"d608bab6-b537-46d9-be0e-45332106d644"]], 
  "InlineCode",ExpressionUUID->"ef59e9a1-2682-4d67-bb4a-e8a520ab7d10"],
 " que empiezan con ",
 Cell[BoxData[Cell["R",
   Background->None,ExpressionUUID->"933f889d-5975-4149-bfaa-43387808b78d"]], 
  "InlineCode",ExpressionUUID->"a3fe60b8-19b8-4841-93df-3ff505cf158c"],
 " (las que empiezan con ",
 Cell[BoxData[Cell["L",
   Background->None,ExpressionUUID->"303be6a5-c2ec-4241-b6e8-6892c47080a9"]], 
  "InlineCode",ExpressionUUID->"50dbb704-c6cc-4493-b7fc-a00798c6a2d6"],
 " son su reflejo) y que no son la repetici\[OAcute]n de una regla \
m\[AAcute]s corta (por ejemplo ",
 Cell[BoxData[Cell["RRLRRL",
   Background->None,ExpressionUUID->"1809e621-1910-4dea-b86f-9fb2f5a9c3aa"]], 
  "InlineCode",ExpressionUUID->"6f4ce13d-8c5e-4faf-8987-16d9fa7d3262"],
 " = ",
 Cell[BoxData[Cell["RRL",
   Background->None,ExpressionUUID->"2ac6a271-c853-4bc6-8682-71e9d647e549"]], 
  "InlineCode",ExpressionUUID->"d8fae5d2-bcf0-4cd6-9675-e8107fbeb89c"],
 " dos veces, que se comporta como 3 colores), la de mayor entrop\[IAcute]a \
normalizada de los colores en esta configuraci\[OAcute]n, es decir, la que \
usa los colores de forma m\[AAcute]s pareja. La b\[UAcute]squeda se hizo en \
Python sobre las 1 013 reglas posibles; con ",
 Cell[BoxData[Cell["n = 6",
   Background->None,ExpressionUUID->"0baa3eb4-e1c8-4425-9bae-3bf547d49b61"]], 
  "InlineCode",ExpressionUUID->"d5b79de5-9bd8-4dae-9b70-24ebf68c0ec9"],
 " las dos mejores (",
 Cell[BoxData[Cell["RRLRRL",
   Background->None,ExpressionUUID->"9451d4d8-057d-42ce-99ec-8bd64d996cb3"]], 
  "InlineCode",ExpressionUUID->"17f82e75-90d2-4932-a406-7bc0006537a7"],
 " y ",
 Cell[BoxData[Cell["RLLRLL",
   Background->None,ExpressionUUID->"50f46e39-e8e1-43c2-8e3c-dd93e95c6c07"]], 
  "InlineCode",ExpressionUUID->"61516a7c-1589-4c37-9ac1-e7ee57c3d90c"],
 ") son repeticiones y se tom\[OAcute] la tercera. "
}], "Text",ExpressionUUID->"19a66a95-eb25-42be-b401-e7ea3f9ea285"],

