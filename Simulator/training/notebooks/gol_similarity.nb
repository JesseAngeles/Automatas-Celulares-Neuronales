Cell[BoxData[{
 RowBox[{
  RowBox[{"archivoA", "=", "\"\<../CA/B3S23/base.mat\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "archivoB", 
   "=", "\"\<../NCA/B3S23_NR/1_01111111/16-16-tanh_1-sigmoid_evo.mat\>\""}], 
