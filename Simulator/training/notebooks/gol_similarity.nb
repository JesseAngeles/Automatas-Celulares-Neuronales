Cell[CellGroupData[{

Cell["Funciones", "Section",ExpressionUUID->"6a58d8d6-7b8d-4756-8231-0b7f9d51cd17"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"patrones", "=", 
   RowBox[{"Tuples", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"centros", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", "j"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", "69", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "2", ",", "69", ",", "3"}], "}"}]}], "]"}], ",", 
     "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"leerEvolucion", "[", "archivo_String", "]"}], ":=", 
   RowBox[{"First", "[", 
    RowBox[{"Import", "[", 
     RowBox[{"archivo", ",", "\"\<MAT\>\""}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vectorRegla", "[", "evolucion_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Extract", "[", 
     RowBox[{
      RowBox[{"Last", "[", "evolucion", "]"}], ",", "centros"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{";;", " ", 
      RowBox[{"Length", "[", "patrones", "]"}]}], "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"87d75b88-65dc-45d2-91f6-3feff776295a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Verificaci\[OAcute]n", "Section",ExpressionUUID->"c098ec97-1f58-4365-b808-1bda7a0ca0d6"],

Cell["\<\
Ambas evoluciones deben medir 69 \[Times] 69 y partir de la misma configuraci\
\[OAcute]n. \
\>", "Text",ExpressionUUID->"b9dbf986-bb11-4d82-bd53-dcb9c5e89cd2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoA", "=", 
   RowBox[{"leerEvolucion", "[", "archivoA", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evoB", "=", 
   RowBox[{"leerEvolucion", "[", "archivoB", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "[", "evoA", "]"}], ",", 
   RowBox[{"Dimensions", "[", "evoB", "]"}], ",", 
   RowBox[{
    RowBox[{"First", "[", "evoA", "]"}], "==", 
    RowBox[{"First", "[", "evoB", "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[53]:=",ExpressionUUID->"b13ccb1e-1b3b-4be1-b081-bd56b73cf5e0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "69", ",", "69"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "69", ",", "69"}], "}"}], ",", "True"}], 
  "}"}]], "Output",
 CellChangeTimes->{4.000422167587493*^9, 4.000506443968676*^9, 
