Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"diferencias", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "vectorA", "]"}], "]"}], ",", 
     RowBox[{"Unitize", "[", 
      RowBox[{"vectorA", "-", "vectorB"}], "]"}], ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Counts", "[", 
  RowBox[{"Transpose", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"vectorA", "[", 
      RowBox[{"[", "diferencias", "]"}], "]"}], ",", 
     RowBox[{"vectorB", "[", 
      RowBox[{"[", "diferencias", "]"}], "]"}]}], "}"}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"dba5e135-ca2b-49ba-a596-dc9e831a15cd"],

