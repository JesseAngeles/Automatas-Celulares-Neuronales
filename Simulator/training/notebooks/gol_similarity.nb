Notebook[{

Cell[CellGroupData[{
Cell["Similitud entre vectores de regla", "Title",ExpressionUUID->"f5ae7b19-94a3-4678-a5ce-42e67e553ce0"],

Cell[TextData[{
 "Cada evoluci\[OAcute]n parte de la configuraci\[OAcute]n de 69 \[Times] 69 \
que contiene los 512 patrones de 3 \[Times] 3 en el orden de ",
 Cell[BoxData[
  RowBox[{"Tuples", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "3"}], "}"}]}], "]"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "9a0c62bc-d3c7-493f-93d1-8952be5f787e"],
 " (23 \[Times] 23 bloques; los \[UAcute]ltimos 17 est\[AAcute]n en cero). \
Despu\[EAcute]s de un paso, el centro de cada bloque es la salida de la regla \
para ese patr\[OAcute]n, por lo que los centros del \[UAcute]ltimo paso \
forman el vector de regla. Se comparan los vectores de dos evoluciones con la \
distancia de Manhattan. "
}], "Text",ExpressionUUID->"9e42355a-3857-4839-bbbb-2b287b0fffac"],

Cell[CellGroupData[{

Cell["Archivos", "Section",ExpressionUUID->"a6afcd23-b0fa-44f3-aef0-0a8df0688f61"],

Cell[TextData[{
 "Rutas relativas a la carpeta del notebook. ",
 Cell[BoxData[Cell["archivoA",
   Background->None,ExpressionUUID->"738fe267-22f0-4b9a-b748-7d385ccd4c6b"]], 
  "InlineCode",ExpressionUUID->"134ba337-f46f-4d30-a2ea-58145bb33ffd"],
 " es la referencia. "
}], "Text",ExpressionUUID->"645159b3-c2c6-4cc2-a9cc-736bed2903b4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"archivoA", "=", "\"\<../CA/B3S23/base.mat\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "archivoB", 
   "=", "\"\<../NCA/B3S23_NR/0_11111111/16:16:relu_1:sigmoid_evo.mat\>\""}], 
  ";"}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"dfd19ab1-ca82-495e-b251-9998e53aae83"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Funciones", "Section",ExpressionUUID->"6a58d8d6-7b8d-4756-8231-0b7f9d51cd17"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"patrones", "=", 
   RowBox[{"Tuples", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"centros", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", "j"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", "69", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "2", ",", "69", ",", "3"}], "}"}]}], "]"}], ",", 
     "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"leerEvolucion", "[", "archivo_String", "]"}], ":=", 
   RowBox[{"First", "[", 
    RowBox[{"Import", "[", 
     RowBox[{"archivo", ",", "\"\<MAT\>\""}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vectorRegla", "[", "evolucion_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Extract", "[", 
     RowBox[{
      RowBox[{"Last", "[", "evolucion", "]"}], ",", "centros"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{";;", " ", 
      RowBox[{"Length", "[", "patrones", "]"}]}], "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"87d75b88-65dc-45d2-91f6-3feff776295a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Verificaci\[OAcute]n", "Section",ExpressionUUID->"c098ec97-1f58-4365-b808-1bda7a0ca0d6"],

Cell["\<\
Ambas evoluciones deben medir 69 \[Times] 69 y partir de la misma configuraci\
\[OAcute]n. \
\>", "Text",ExpressionUUID->"b9dbf986-bb11-4d82-bd53-dcb9c5e89cd2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoA", "=", 
   RowBox[{"leerEvolucion", "[", "archivoA", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evoB", "=", 
   RowBox[{"leerEvolucion", "[", "archivoB", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "[", "evoA", "]"}], ",", 
   RowBox[{"Dimensions", "[", "evoB", "]"}], ",", 
   RowBox[{
    RowBox[{"First", "[", "evoA", "]"}], "==", 
    RowBox[{"First", "[", "evoB", "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"b13ccb1e-1b3b-4be1-b081-bd56b73cf5e0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "69", ",", "69"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "69", ",", "69"}], "}"}], ",", "True"}], 
  "}"}]], "Output",
 CellChangeTimes->{4.000422167587493*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"a0fe2cd4-6163-4e2a-b7ae-5e0599d4fc42"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Distancia de Manhattan", "Section",ExpressionUUID->"8cde5b32-e426-4e6d-8744-e28a70077a4c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"vectorA", "=", 
   RowBox[{"vectorRegla", "[", "evoA", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vectorB", "=", 
   RowBox[{"vectorRegla", "[", "evoB", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "vectorA", "]"}], "\[IndentingNewLine]", 
 RowBox[{"distancia", "=", 
  RowBox[{"ManhattanDistance", "[", 
   RowBox[{"vectorA", ",", "vectorB"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"distancia", "/", 
     RowBox[{"Length", "[", "vectorA", "]"}]}], ")"}], "*", "100"}], "//", 
  "N"}]}], "Input",
 CellChangeTimes->{{4.000422208634074*^9, 4.00042222144816*^9}, {
  4.0004222811932917`*^9, 4.000422306705418*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"925e7596-0ccb-4bd7-9229-064098e310cf"],

