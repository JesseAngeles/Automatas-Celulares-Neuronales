Cell[BoxData[
 RowBox[{
  RowBox[{"estilo", "=", 
   RowBox[{"Sequence", "[", 
    RowBox[{
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"Axes", "->", "False"}], ",", 
     RowBox[{"FrameStyle", "->", 
      RowBox[{"GrayLevel", "[", "0.4", "]"}]}], ",", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"FrameTicksStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "11"}], "]"}]}], ",", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "12"}], "]"}]}], ",", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"GridLinesStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"GrayLevel", "[", "0.85", "]"}], "]"}]}], ",", 
     RowBox[{"ImageSize", "->", "400"}], ",", 
     RowBox[{"AspectRatio", "->", 
      RowBox[{"3", "/", "4"}]}]}], "]"}]}], ";"}]], "Input",ExpressionUUID->\
"30cbf49b-2a18-42cd-8bf5-bc82bc9ebaad"],

