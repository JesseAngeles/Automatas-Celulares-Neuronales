Cell[TextData[{
 "Estilo com\[UAcute]n con ",
 Cell[BoxData[Cell["gol_proportions.nb",
   Background->None,ExpressionUUID->"eaa6f7ca-4e03-416c-b9d6-eb02ccff2dd6"]], 
