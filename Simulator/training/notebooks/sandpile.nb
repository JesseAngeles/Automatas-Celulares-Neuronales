Cell["Tama\[NTilde]o de las avalanchas", "Subsection",ExpressionUUID->"0205e410-aa65-4669-b7ad-4374ba589b4a"],

Cell["\<\
Frecuencia de cada tama\[NTilde]o de avalancha (n\[UAcute]mero de derrumbes), \
sin contar los pasos sin avalancha. En escala log\[Dash]log una recta indica \
una ley de potencias. \
\>", "Text",ExpressionUUID->"2e38bd98-4d12-4a24-9cdb-e498a2dd1fc8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"frecuencias", "=", 
   RowBox[{"SortBy", "[", 
    RowBox[{
     RowBox[{"Tally", "[", 
      RowBox[{"Select", "[", 
       RowBox[{"avalanchas", ",", 
        RowBox[{
         RowBox[{"#", ">", "0"}], " ", "&"}]}], "]"}], "]"}], ",", "First"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"graficaAvalanchas", "=", 
  RowBox[{"ListLogLogPlot", "[", 
   RowBox[{"frecuencias", ",", "\[IndentingNewLine]", "\t", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{
       RowBox[{"RGBColor", "[", "\"\<#2a78d6\>\"", "]"}], ",", 
       RowBox[{"PointSize", "[", "0.012", "]"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", "\t", 
    RowBox[{"GridLines", "->", "Automatic"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Tama\[NTilde]o de la avalancha\>\"", 
       ",", "\"\<Frecuencia\>\""}], "}"}]}], ",", "\[IndentingNewLine]", "\t", 
    RowBox[{"PlotLabel", "->", "\"\<Distribuci\[OAcute]n de avalanchas\>\""}],
     ",", "estilo"}], "]"}]}]}], "Input",ExpressionUUID->"e53b2b94-8e3c-4334-\
b0a2-4300ebfd3e21"],

Cell["Exportar", "Section",ExpressionUUID->"7720da28-54ce-40a4-9d50-87e707b36913"],

Cell[TextData[{
 "Mismo formato que exporta el simulador (GUI) y que lee ",
 Cell[BoxData[Cell["scripts/main.py",
   Background->None,ExpressionUUID->"c52a744e-0995-41fc-bbd6-96db520ab7eb"]], 
  "InlineCode",ExpressionUUID->"95d0ff88-41a9-432d-802f-e815097e372e"],
 ": la evoluci\[OAcute]n ",
 Cell[BoxData[Cell["(pasos + 1, lado, lado)",
   Background->None,ExpressionUUID->"8873530b-4446-47d2-bb44-13921009fc92"]], 
  "InlineCode",ExpressionUUID->"489fec7e-9684-491a-b96b-86f556406548"],
 " en enteros de 32 bits, como ",
 Cell[BoxData[Cell["evo.npy",
   Background->None,ExpressionUUID->"92137691-0d44-4495-bf3d-0da6ea893f05"]], 
  "InlineCode",ExpressionUUID->"73eb299a-7916-4dad-97c9-a8b18fe4f456"],
 " y como ",
 Cell[BoxData[Cell["evo.mat",
   Background->None,ExpressionUUID->"e00a6a0e-5a9f-4b80-b6e1-0a7f58db118f"]], 
  "InlineCode",ExpressionUUID->"cd1c8472-e3b3-4334-816d-36bcde43110f"],
 " (variable ",
 StyleBox["evolution", "TI"],
 ", comprimido). ",
 Cell[BoxData[Cell["evo.json",
   Background->None,ExpressionUUID->"e020113f-2da8-499e-aa72-6deb3f63c262"]], 
  "InlineCode",ExpressionUUID->"2e32d46a-de1f-4f77-bf68-beb866c6af3a"],
 " guarda los par\[AAcute]metros, el significado y color de cada estado y la \
fracci\[OAcute]n de celdas en cada estado. Tambi\[EAcute]n se exportan los \
derrumbes por paso, la animaci\[OAcute]n (un cuadro cada ",
 Cell[BoxData[Cell["cadaGif",
   Background->None,ExpressionUUID->"1e88e528-9115-421f-862b-df6b997f2eba"]], 
  "InlineCode",ExpressionUUID->"05905ef1-5e1c-41aa-b8c1-c508f0eb797d"],
 " pasos, cada celda de 4 \[Times] 4 p\[IAcute]xeles) y las gr\[AAcute]ficas \
para el documento."
}], "Text",ExpressionUUID->"d46cbfe5-5646-4c93-ad15-49e0c5063eca"],

Cell[TextData[{
 "Mathematica no exporta ",
 Cell[BoxData[Cell[".npy",
   Background->None,ExpressionUUID->"6564723c-98e6-4c21-9a2d-0d98afa9b138"]], 
  "InlineCode",ExpressionUUID->"b6971f39-2bba-4d73-aa3d-dc5cd580b1ad"],
 ", as\[IAcute] que ",
 Cell[BoxData[Cell["exportarNPY",
   Background->None,ExpressionUUID->"2fa1e8c1-844e-4776-b98d-8a4fde292166"]], 
  "InlineCode",ExpressionUUID->"a7a036af-06eb-4cac-8214-370bc461c5db"],
 " escribe el formato NPY 1.0 a mano: encabezado con tipo ",
 Cell[BoxData[Cell["<i4",
   Background->None,ExpressionUUID->"47495f99-05ea-4e14-bc71-6931c17725ae"]], 
  "InlineCode",ExpressionUUID->"fb272627-4112-4ad6-8e67-831a40aea92f"],
 ", orden C y forma, y despu\[EAcute]s los datos por bloques. "
}], "Text",ExpressionUUID->"e6fc7ac9-a9dc-4f28-b3b0-e095fd243841"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"exportarNPY", "[", 
    RowBox[{"archivo_String", ",", "datos_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dims", "=", 
        RowBox[{"Dimensions", "[", "datos", "]"}]}], ",", "cab", ",", "s", ",", 
       RowBox[{"b", "=", "500"}]}], "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"cab", "=", 
       RowBox[{"\"\<{'descr': '<i4', 'fortran_order': False, 'shape': (\>\"", 
        " ", "<>", " ", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{
          RowBox[{"ToString", " ", "/@", " ", "dims"}], ",", "\"\<, \>\""}], 
         "]"}], " ", "<>", " ", "\"\<), }\>\""}]}], ";", " ", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"cab", "=", 
       RowBox[{"cab", " ", "<>", " ", 
        RowBox[{"StringRepeat", "[", 
         RowBox[{"\"\< \>\"", ",", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"10", "+", 
               RowBox[{"StringLength", "[", "cab", "]"}], "+", "1"}], ")"}]}],
             ",", "64"}], "]"}]}], "]"}], " ", "<>", " ", "\"\<\\n\>\""}]}], ";",
       " ", "\[IndentingNewLine]", "\t", 
      RowBox[{"s", "=", 
       RowBox[{"OpenWrite", "[", 
        RowBox[{"archivo", ",", 
         RowBox[{"BinaryFormat", "->", "True"}]}], "]"}]}], ";", " ", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"BinaryWrite", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", "147", "}"}], ",", 
          RowBox[{"ToCharacterCode", "[", "\"\<NUMPY\>\"", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}]}], "]"}], 
        ",", "\"\<UnsignedInteger8\>\""}], "]"}], ";", " ", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"BinaryWrite", "[", 
       RowBox[{"s", ",", 
        RowBox[{"StringLength", "[", "cab", "]"}], 
        ",", "\"\<UnsignedInteger16\>\"", ",", 
        RowBox[{"ByteOrdering", "->", 
         RowBox[{"-", "1"}]}]}], "]"}], ";", " ", "\[IndentingNewLine]", "\t", 
      RowBox[{"BinaryWrite", "[", 
       RowBox[{"s", ",", "cab", ",", "\"\<Character8\>\""}], "]"}], ";", " ", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"BinaryWrite", "[", 
         RowBox[{"s", ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{"datos", "[", 
             RowBox[{"[", 
              RowBox[{"i", " ", ";;", " ", 
               RowBox[{"Min", "[", 
                RowBox[{
                 RowBox[{"i", "+", "b", "-", "1"}], ",", 
                 RowBox[{"First", "[", "dims", "]"}]}], "]"}]}], "]"}], "]"}],
             "]"}], "]"}], ",", "\"\<Integer32\>\"", ",", 
          RowBox[{"ByteOrdering", "->", 
           RowBox[{"-", "1"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"First", "[", "dims", "]"}], ",", "b"}], "}"}]}], "]"}], ";",
       " ", "\[IndentingNewLine]", "\t", 
      RowBox[{"Close", "[", "s", "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hex", "[", "c_", "]"}], ":=", 
   RowBox[{"\"\<#\>\"", " ", "<>", " ", 
    RowBox[{"StringJoin", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"IntegerString", "[", 
        RowBox[{
         RowBox[{"Round", "[", 
          RowBox[{"255", " ", "#"}], "]"}], ",", "16", ",", "2"}], "]"}], " ",
        "&"}], " ", "/@", " ", 
      RowBox[{"List", " ", "@@", " ", 
       RowBox[{"ColorConvert", "[", 
        RowBox[{"c", ",", "\"\<RGB\>\""}], "]"}]}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fraccionEstados", "[", "datos_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"t", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"Length", "[", "estados", "]"}]}], "]"}]}], ",", 
       RowBox[{"b", "=", "500"}]}], "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"t", " ", "+=", " ", 
         RowBox[{"BinCounts", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{"datos", "[", 
              RowBox[{"[", 
               RowBox[{"i", " ", ";;", " ", 
                RowBox[{"Min", "[", 
                 RowBox[{
                  RowBox[{"i", "+", "b", "-", "1"}], ",", 
                  RowBox[{"Length", "[", "datos", "]"}]}], "]"}]}], "]"}], 
              "]"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"Length", "[", "estados", "]"}], ",", "1"}], "}"}]}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "datos", "]"}], ",", "b"}], "}"}]}], "]"}], ";",
       " ", "\[IndentingNewLine]", "\t", 
      RowBox[{"N", "[", 
       RowBox[{"t", "/", 
        RowBox[{"Total", "[", "t", "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"211210d3-8bcb-42ab-a4e5-e2ff94c9e2e1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"salida", "=", "\"\<../CA/Sandpile\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"img", "=", "\"\<../../../Documentation/img\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"exportarNPY", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"salida", ",", "\"\<evo.npy\>\""}], "}"}], "]"}], ",", 
    "evolucion"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"salida", ",", "\"\<evo.mat\>\""}], "}"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"\"\<evolution\>\"", "->", 
      RowBox[{"NumericArray", "[", 
       RowBox[{"evolucion", ",", "\"\<Integer32\>\""}], "]"}]}], "}"}], 
    ",", "\"\<LabeledData\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"salida", ",", "\"\<evo.json\>\""}], "}"}], "]"}], ",", 
    RowBox[{"<|", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"\"\<simulation\>\"", "->", "\"\<sandpile\>\""}], ",", 
      RowBox[{"\"\<shape\>\"", "->", 
       RowBox[{"Dimensions", "[", "evolucion", "]"}]}], ",", 
      RowBox[{"\"\<size\>\"", "->", "lado"}], ",", 
      RowBox[{"\"\<steps\>\"", "->", "pasos"}], ",", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{"\"\<generators\>\"", "->", "generadores"}], ",", 
      RowBox[{"\"\<threshold\>\"", "->", "umbral"}], ",", 
      RowBox[{"\"\<grains_per_toppling\>\"", "->", "reparto"}], ",", 
      RowBox[{"\"\<boundary\>\"", "->", "\"\<open\>\""}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"\"\<state_encoding\>\"", 
       "->", "\"\<altura en celdas normales; altura + threshold en celdas \
generadoras\>\""}], ",", "\[IndentingNewLine]", "\t", 
      RowBox[{"\"\<states\>\"", "->", 
       RowBox[{"Values", "[", 
        RowBox[{"KeySort", "[", "nombres", "]"}], "]"}]}], ",", 
      RowBox[{"\"\<colors_hex\>\"", "->", 
       RowBox[{"(", 
        RowBox[{"hex", " ", "/@", " ", 
         RowBox[{"Values", "[", 
          RowBox[{"KeySort", "[", "colores", "]"}], "]"}]}], ")"}]}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"\"\<state_fraction\>\"", "->", 
       RowBox[{"fraccionEstados", "[", "evolucion", "]"}]}]}], "|>"}], 
    ",", "\"\<RawJSON\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Export", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"salida", ",", "\"\<avalanchas.csv\>\""}], "}"}], "]"}], ",", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", "pasos", "]"}], ",", "avalanchas"}], "}"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<paso\>\"", ",", "\"\<derrumbes\>\""}], "}"}]}], "]"}]}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cadaGif", "=", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cuadros", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ImageResize", "[", 
      RowBox[{
       RowBox[{"Image", "[", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"List", " ", "@@", " ", 
            RowBox[{"colores", "[", "#", "]"}]}], " ", "&"}], ",", 
          RowBox[{"evolucion", "[", 
           RowBox[{"[", 
            RowBox[{"k", "+", "1"}], "]"}], "]"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"4", " ", "lado"}], ",", 
       RowBox[{"Resampling", "->", "\"\<Nearest\>\""}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "pasos", ",", "cadaGif"}], "}"}]}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"salida", ",", "\"\<evo.gif\>\""}], "}"}], "]"}], ",", 
