Cell["Proporci\[OAcute]n de cada altura", "Subsection",ExpressionUUID->"f5a45840-a477-4b8e-958b-bec472975662"],

Cell["Los generadores cuentan con su altura. ", "Text",ExpressionUUID->"b20a999b-99a0-42c5-a132-4b7aa42b54f2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"celdas", "=", 
   RowBox[{"N", "[", 
    RowBox[{"lado", "^", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"proporciones", "=", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"h", ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Count", "[", 
           RowBox[{"#", ",", "h", ",", 
            RowBox[{"{", "2", "}"}]}], "]"}], "/", "celdas"}], " ", "&"}], 
        " ", "/@", " ", "altura"}]}], "]"}], ",", "alturas"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"graficaEstados", "=", 
  RowBox[{"Legended", "[", "\[IndentingNewLine]", "\t", 
   RowBox[{
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"Values", "[", "proporciones", "]"}], ",", 
      RowBox[{"DataRange", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "pasos"}], "}"}]}], ",", "\[IndentingNewLine]", 
      "\t\t", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"coloresLinea", "[", "#", "]"}], ",", 
            RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], " ", "&"}],
          " ", "/@", " ", "alturas"}], ")"}]}], ",", "\[IndentingNewLine]", 
      "\t\t", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "pasos"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"GridLines", "->", 
       RowBox[{"{", 
        RowBox[{"None", ",", 
         RowBox[{"FindDivisions", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", "5"}], "]"}]}], "}"}]}], ",",
       "\[IndentingNewLine]", "\t\t", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Paso\>\"", ",", "\"\<Proporci\[OAcute]n\>\""}], "}"}]}], 
      ",", 
      RowBox[{
      "PlotLabel", "->", "\"\<Proporci\[OAcute]n de celdas por altura\>\""}], 
      ",", "estilo"}], "]"}], ",", "\[IndentingNewLine]", "\t", 
    RowBox[{"LineLegend", "[", 
     RowBox[{
      RowBox[{"Values", "[", "coloresLinea", "]"}], ",", 
      RowBox[{"granosTexto", " ", "/@", " ", "alturas"}], ",", 
      RowBox[{"LegendMarkerSize", "->", 
       RowBox[{"{", 
        RowBox[{"20", ",", "10"}], "}"}]}]}], "]"}]}], "]"}]}]}], "Input",Expr\
essionUUID->"5358e502-5250-404f-b7d8-39e27235d339"],

Cell["Granos en el sistema", "Subsection",ExpressionUUID->"cb1395b2-a202-4edd-9775-1d76f115e3cf"],

