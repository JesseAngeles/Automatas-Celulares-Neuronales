Notebook[{
Cell["Sandpile", "Title",ExpressionUUID->"2d4725e4-5a2a-4a81-8be3-9d071cb15d30"],

Cell["\<\
Modelo de pila de arena (Bak\[Dash]Tang\[Dash]Wiesenfeld) como \
aut\[OAcute]mata celular s\[IAcute]ncrono con vecindad de Von Neumann. En \
cada paso todas las celdas se actualizan a la vez: \
\>", "Text",ExpressionUUID->"ca51564a-1762-4e0c-89a1-75f8a2d2ca30"],

Cell[TextData[{
 "Si la celda tiene ",
 StyleBox["umbral", "TI"],
 " granos o m\[AAcute]s, se derrumba: pierde ",
 StyleBox["reparto", "TI"],
 " granos y entrega uno a cada vecino (arriba, abajo, izquierda, derecha)."
}], "Item",ExpressionUUID->"fb8b514b-3071-4676-84a9-625a47386440"],

Cell["\<\
Cada celda recibe un grano por cada vecino que se derrumba en ese paso.\
\>", "Item",ExpressionUUID->"9bd043b3-276b-4869-ae70-7a32f459818d"],

Cell["\<\
Una celda generadora agrega un grano solo si no se derrumba en ese paso.\
\>", "Item",ExpressionUUID->"1efa7c91-8042-4073-85c2-a15cab7fc64b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["z", "TI"], 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         RowBox[{"{", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["z", "TI"], 
                    StyleBox["t", "TI"]], "-", "4", "+", 
                    StyleBox["k", "TI"], ","}]], "InlineFormula"], " "}]], 
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["z", "TI"], 
                    StyleBox["t", "TI"]], "\[GreaterEqual]", "4"}]], 
                    "InlineFormula"], " "}]]}, {
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["z", "TI"], 
                    StyleBox["t", "TI"]], "+", 
                    StyleBox["k", "TI"], "+", 
                    SubscriptBox[
                    StyleBox["1", FontSlant -> "Plain"], 
                    StyleBox["i", "TI"]], ","}]], "InlineFormula"], " "}]], 
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["z", "TI"], 
                    StyleBox["t", "TI"]], "<", "4"}]], "InlineFormula"], 
                    " "}]]}}], TraditionalForm]]]}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "z_{t+1} = \\begin{cases} z_t - 4 + k, & z_t \\ge 4 \\\\ z_t + k + \
\\mathbb{1}_i, & z_t < 4 \\end{cases}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "99a63aaa-96e4-467f-9992-03b996b21ff9"],
 "donde ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6703e7fe-0716-4263-a22e-fdc0d58f46c2"],
 " es el n\[UAcute]mero de vecinos que se derrumban en el paso ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["t", "TI"], TraditionalForm], "errors" -> {}, "input" -> "t", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6eb98cfb-63fb-42c7-a201-807c93223cec"],
 " e ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["1", FontSlant -> "Plain"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathbb{1}_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ff3667d2-c93b-4df8-91f6-6b356ceff6f6"],
 " vale 1 en las celdas generadoras. Los granos que salen por el borde se \
pierden."
}], "Text",ExpressionUUID->"bd34fa5b-1ce1-4e98-9b2a-f9eede4fc6e5"],

Cell[TextData[{
 "Con ",
 Cell[BoxData[Cell["umbral = 4",
   Background->None,ExpressionUUID->"0bd0c686-8222-415f-a7e4-c7698d92b3da"]], 
  "InlineCode",ExpressionUUID->"7c00fe08-e126-43a4-b51e-f48be80578ee"],
 " una celda normal tiene a lo m\[AAcute]s ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"3", "+", "4", "\[LongEqual]", "7"}], TraditionalForm], 
     "errors" -> {}, "input" -> "3 + 4 = 7", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fbb04ae8-07da-4cb3-b275-15ef401cff05"],
 " granos y una generadora ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"3", "+", "1", "+", "4", "\[LongEqual]", "8"}], 
       TraditionalForm], "errors" -> {}, "input" -> "3 + 1 + 4 = 8", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "779a8661-ebf2-4e37-9683-568521b1da8d"],
 ", as\[IAcute] que hay 17 estados: "
}], "Text",ExpressionUUID->"ca278de5-d5b9-41dc-9498-f5a10906f921"],

Cell[TextData[{
 "Estados ",
 Cell[BoxData[Cell["0 \[Ellipsis] 7",
   Background->None,ExpressionUUID->"201b97a7-bec9-4a70-b3b9-ee08b4636e09"]], 
  "InlineCode",ExpressionUUID->"ba33bd17-b341-4dae-8a17-9d8b43c47089"],
 ": arena normal con esa altura."
}], "Item",ExpressionUUID->"60d8ae43-b602-4837-8d87-0cb020ad4e7b"],

Cell[TextData[{
 "Estados ",
 Cell[BoxData[Cell["8 \[Ellipsis] 16",
   Background->None,ExpressionUUID->"dc1fe528-cf2b-42ab-af10-0bcba993f78c"]], 
  "InlineCode",ExpressionUUID->"325a4310-aafb-4601-870a-c240a0fa0d4b"],
 ": generador con altura ",
 Cell[BoxData[Cell["estado \[Minus] 8",
   Background->None,ExpressionUUID->"6f0d87de-8317-49e3-ac96-30cb0b66a3e0"]], 
  "InlineCode",ExpressionUUID->"34b48af1-123d-4098-ab2c-c963d99bca3c"],
 "."
}], "Item",ExpressionUUID->"4879da74-495f-4ed8-b274-8a7a74beecbe"],

Cell["El cuadro 0 es el espacio vac\[IAcute]o con los generadores. ", "Text",ExpressionUUID->"6243cf5a-9093-46ce-9089-ba584d372ae5"],

Cell["Par\[AAcute]metros", "Section",ExpressionUUID->"52d365e4-7caa-4e42-9184-074717ffd4c3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lado", "=", "25"}], ";"}], "                       ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"espacio", " ", "de", " ", "lado", " ", "\[Times]", " ", "lado"}],
     ",", " ", 
    RowBox[{"con", " ", "frontera", " ", "abierta"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pasos", "=", "2000"}], ";"}], "                   ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"pasos", " ", "s\[IAcute]ncronos"}], ";", " ", 
    RowBox[{
    "cada", " ", "generador", " ", "agrega", " ", "a", " ", "lo", " ", 
     "m\[AAcute]s", " ", "un", " ", "grano", " ", "por", " ", "paso"}]}], " ",
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"generadores", "=", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"13", ",", "13"}], "}"}], "}"}]}], ";"}], "        ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"fila", ",", " ", "columna"}], "}"}], " ", "de", " ", "las", " ",
     "celdas", " ", "generadoras"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"umbral", "=", "4"}], ";"}], "                      ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "granos", " ", "con", " ", "los", " ", "que", " ", "una", " ", "celda", " ",
     "se", " ", "derrumba"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"reparto", "=", "4"}], ";"}], "                     ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "granos", " ", "que", " ", "entrega", " ", "al", " ", "derrumbarse"}], ",",
     " ", 
    RowBox[{"uno", " ", "por", " ", "vecino"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"alturasNormales", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", 
      RowBox[{
       RowBox[{"2", " ", "umbral"}], "-", "1"}]}], "]"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"0", " ", "\[Ellipsis]", " ", "7"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"alturasGenerador", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", 
      RowBox[{"2", " ", "umbral"}]}], "]"}]}], ";"}], "      ", 
  RowBox[{"(*", " ", 
   RowBox[{"0", " ", "\[Ellipsis]", " ", "8"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"desplazamiento", "=", 
    RowBox[{"2", " ", "umbral"}]}], ";"}], "                  ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"estado", " ", "de", " ", "un", " ", "generador"}], " ", "=", " ", 
    RowBox[{"altura", " ", "+", " ", "8"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"estados", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", 
     RowBox[{"desplazamiento", "+", 
      RowBox[{"2", " ", "umbral"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mascara", "=", 
   RowBox[{"ReplacePart", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{"lado", ",", "lado"}], "}"}]}], "]"}], ",", 
     RowBox[{"Thread", "[", 
      RowBox[{"generadores", "->", "1"}], "]"}]}], "]"}]}], ";"}]}], "Input",E\
xpressionUUID->"723ddb32-8ec9-4d5c-ac78-baba7684ce9d"],

Cell["Simulaci\[OAcute]n", "Section",ExpressionUUID->"94696631-6371-48d7-afcc-6215fab692e1"],

Cell[TextData[{
 Cell[BoxData[Cell["paso[g, m]",
   Background->None,ExpressionUUID->"42cb7589-cacf-4ce3-a736-1a8172e61d8d"]], 
  "InlineCode",ExpressionUUID->"9a0cdba3-d04e-4277-b9a1-55ec1de6c573"],
 " aplica la regla a todas las celdas a la vez; ",
 StyleBox["m", "TI"],
 " marca con 1 las celdas generadoras. La simulaci\[OAcute]n trabaja con \
alturas; el desplazamiento de los generadores solo se suma al guardar cada \
cuadro. "
}], "Text",ExpressionUUID->"9ed1862e-e9d0-4e6a-ab17-28ae382d2934"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"vecinos", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{"ArrayPad", "[", 
      RowBox[{"t", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], "]"}], "+", 
     RowBox[{"ArrayPad", "[", 
      RowBox[{"t", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], "]"}], "+", 
     "\[IndentingNewLine]", "\t\t", 
     RowBox[{"ArrayPad", "[", 
      RowBox[{"t", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}], "+", 
     RowBox[{"ArrayPad", "[", 
      RowBox[{"t", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}]}]}], ";"}],
   "\[IndentingNewLine]", "\t"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"paso", "[", 
    RowBox[{"g_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", "=", 
       RowBox[{"UnitStep", "[", 
        RowBox[{"g", "-", "umbral"}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "\t\t", 
     RowBox[{"g", "-", 
      RowBox[{"reparto", " ", "t"}], "+", 
      RowBox[{"vecinos", "[", "t", "]"}], "+", 
      RowBox[{"m", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", "t"}], ")"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"paso", "[", "g_", "]"}], ":=", 
    RowBox[{"paso", "[", 
     RowBox[{"g", ",", "mascara"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\t"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"simular", "[", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"lado", ",", "lado"}], "}"}]}], "]"}]}], ",", "evo"}], 
       "}"}], ",", "\[IndentingNewLine]", "\t\t", 
      RowBox[{
       RowBox[{"evo", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pasos", "+", "1"}], ",", "lado", ",", "lado"}], "}"}]}], 
         "]"}]}], ";", " ", "\[IndentingNewLine]", "\t\t", 
       RowBox[{
        RowBox[{"evo", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", 
        RowBox[{"g", "+", 
         RowBox[{"desplazamiento", " ", "mascara"}]}]}], ";", " ", 
       "\[IndentingNewLine]", "\t\t", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"g", "=", 
           RowBox[{"paso", "[", "g", "]"}]}], ";", " ", 
          RowBox[{
           RowBox[{"evo", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "1"}], "]"}], "]"}], "=", 
           RowBox[{"g", "+", 
            RowBox[{"desplazamiento", " ", "mascara"}]}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "pasos"}], "}"}]}], "]"}], ";", " ", 
       "\[IndentingNewLine]", "\t\t", "evo"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\t"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evolucion", "=", 
   RowBox[{"simular", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "[", "evolucion", "]"}], ",", 
   RowBox[{"Union", "[", 
    RowBox[{"Flatten", "[", "evolucion", "]"}], "]"}]}], "}"}]}], "Input",Expr\
essionUUID->"a5732e01-f5e1-4f96-bfe3-e4d1203061eb"],

Cell["Configuraciones iniciales aleatorias", "Section",ExpressionUUID->"3ebf91b2-41aa-4385-b211-72760d69ab35"],

Cell[TextData[{
 Cell[BoxData[Cell["nMuestras",
   Background->None,ExpressionUUID->"a128cc5c-99f1-44e3-968c-f7b41a0410e1"]], 
  "InlineCode",ExpressionUUID->"6e87ac4c-17b9-46eb-8a15-db7ff086fdfa"],
 " espacios de ",
 Cell[BoxData[Cell["ladoMuestras \[Times] ladoMuestras",
   Background->None,ExpressionUUID->"1838ed48-e02e-4982-a9cd-bbb3a49d056b"]], 
  "InlineCode",ExpressionUUID->"96a0ae2a-028e-4194-9acc-d75e002c30ed"],
 ", cada uno con ",
 Cell[BoxData[Cell["nGeneradores",
   Background->None,ExpressionUUID->"fe7843a0-6947-4734-8e1b-8d8caa0ffc7d"]], 
  "InlineCode",ExpressionUUID->"80ccbd8f-5bb7-48e2-9f5f-63dae32a0fbc"],
 " generadores en posiciones aleatorias distintas. Las celdas normales \
empiezan con una altura aleatoria uniforme entre 0 y 7; el primer generador \
empieza con altura 0 y los dem\[AAcute]s con una altura aleatoria entre 0 y \
8, as\[IAcute] que desde el paso 0 hay celdas inestables. Cada muestra \
evoluciona ",
 Cell[BoxData[Cell["pasosMuestras",
   Background->None,ExpressionUUID->"f6a11205-6432-421f-8aa7-7282e78b9392"]], 
  "InlineCode",ExpressionUUID->"f39965be-2590-4dcc-bbb1-32e30514e0f8"],
 " pasos con la misma regla. "
}], "Text",ExpressionUUID->"b7872e34-8b8d-49f2-a3c5-4c7f77d1129c"],

Cell[TextData[{
 Cell[BoxData[Cell["posiciones[[i]]",
   Background->None,ExpressionUUID->"1e70cd18-ffcf-42d7-864f-238b596142dc"]], 
  "InlineCode",ExpressionUUID->"21aa1d97-da24-4386-8718-77092556ec0f"],
 ": las ",
 Cell[BoxData[Cell["{fila, columna}",
   Background->None,ExpressionUUID->"af2b2e28-ebf1-4d92-b591-0c82a9ec7156"]], 
  "InlineCode",ExpressionUUID->"546ba96c-cd48-468f-b7ac-e2a16d7d6f5e"],
 " de los generadores de la muestra ",
 StyleBox["i", "TI"],
 "; el primero es el de altura 0."
}], "Item",ExpressionUUID->"8d0b6c2b-f7b2-4e6a-b24a-2613d833d493"],

Cell[TextData[{
 Cell[BoxData[Cell["mascarasMuestras[[i]]",
   Background->None,ExpressionUUID->"5962fd6b-0435-407f-9daf-e04aa5411a7c"]], 
  "InlineCode",ExpressionUUID->"8b031fd4-4ba3-442f-a898-6e94bdaad444"],
 ": la m\[AAcute]scara de generadores de la muestra ",
 StyleBox["i", "TI"],
 "."
}], "Item",ExpressionUUID->"b9eb0699-e244-4703-a013-8ed933004988"],

Cell[TextData[{
 StyleBox["evos", "TI"],
 ": forma ",
 Cell[BoxData[
 Cell["(nMuestras, pasosMuestras + 1, ladoMuestras, ladoMuestras)",
   Background->None,ExpressionUUID->"323afe95-0141-4a74-8544-9e0c13c4cd98"]], 
  "InlineCode",ExpressionUUID->"4dd4c008-f240-43d7-9e65-8219e9a80050"],
 "; cada evoluci\[OAcute]n incluye la configuraci\[OAcute]n inicial como \
cuadro 0."
}], "Item",ExpressionUUID->"c510805b-40bc-4cfe-803f-fa99c8d34b7e"],

Cell["\<\
Con 50 \[Times] 50 y 4 generadores el sistema se relaja hasta el paso ~1 200 \
y desde ah\[IAcute] queda en un estado estacionario con ~2.19 granos por \
celda y ~8 % de celdas inestables (el generador agrega arena en cada paso, as\
\[IAcute] que siempre hay una avalancha en curso). \
\>", "Text",ExpressionUUID->"8af4de5f-d4d8-4985-8f74-ed4e8c9d8050"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nMuestras", "=", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ladoMuestras", "=", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pasosMuestras", "=", "1500"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nGeneradores", "=", "4"}], ";"}], "\[IndentingNewLine]", "\t"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"posiciones", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"RandomSample", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"Range", "[", "ladoMuestras", "]"}], ",", "2"}], "]"}], ",", 
       "nGeneradores"}], "]"}], ",", "nMuestras"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mascarasMuestras", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"ReplacePart", "[", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"ladoMuestras", ",", "ladoMuestras"}], "}"}]}], "]"}], ",", 
       
       RowBox[{"Thread", "[", 
        RowBox[{"#", "->", "1"}], "]"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
    "posiciones"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"iniciales", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"ReplacePart", "[", 
       RowBox[{
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{
             RowBox[{"2", " ", "umbral"}], "-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"ladoMuestras", ",", "ladoMuestras"}], "}"}]}], "]"}], ",",
         "\[IndentingNewLine]", "\t\t", 
        RowBox[{"Thread", "[", 
         RowBox[{"#", "->", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{"RandomInteger", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{"2", " ", "umbral"}]}], "}"}], ",", 
              RowBox[{"nGeneradores", "-", "1"}]}], "]"}], ",", "0"}], 
           "]"}]}], "]"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
     "posiciones"}]}], ";"}], "\[IndentingNewLine]", "\t"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"evolucionar", "[", 
    RowBox[{"g0_", ",", "m_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"#", "+", 
       RowBox[{"desplazamiento", " ", "m"}]}], ")"}], " ", "&"}], " ", "/@", 
    " ", 
    RowBox[{"NestList", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"paso", "[", 
        RowBox[{"#", ",", "m"}], "]"}], " ", "&"}], ",", "g0", ",", "n"}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evos", "=", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"evolucionar", "[", 
       RowBox[{"#1", ",", "#2", ",", "pasosMuestras"}], "]"}], " ", "&"}], ",", 
     RowBox[{"{", 
      RowBox[{"iniciales", ",", "mascarasMuestras"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "[", "evos", "]"}], ",", 
   RowBox[{"Union", "[", 
    RowBox[{"Flatten", "[", "evos", "]"}], "]"}]}], "}"}]}], "Input",Expressio\
nUUID->"421a4b6e-5846-4209-80a2-1873dff613f2"],

Cell["Espacio vac\[IAcute]o con un generador", "Section",ExpressionUUID->"8283648f-0a87-42c9-92d9-a60bcaf9fc9b"],

Cell[TextData[{
 "Un espacio de ",
 Cell[BoxData[Cell["ladoCero \[Times] ladoCero",
   Background->None,ExpressionUUID->"5a64d274-3175-491d-90eb-e28dc19d9012"]], 
  "InlineCode",ExpressionUUID->"d74ccaa6-fa46-4cc5-bb7b-cc83803149d5"],
 " con todas las celdas en 0 y un generador con altura 0 en el centro. ",
 Cell[BoxData[Cell["evoCero",
   Background->None,ExpressionUUID->"f4fa7c91-53e2-427b-a387-e896a127fe9d"]], 
  "InlineCode",ExpressionUUID->"87de5567-a350-4e74-84d4-ac95baa2469f"],
 " tiene forma ",
 Cell[BoxData[Cell["(pasosCero + 1, ladoCero, ladoCero)",
   Background->None,ExpressionUUID->"5eb33e2b-3134-4ab3-875a-53999312b133"]], 
  "InlineCode",ExpressionUUID->"5d1da1a9-0c1a-4876-b1d3-e6b5ee8396d5"],
 " e incluye la configuraci\[OAcute]n inicial como cuadro 0. "
}], "Text",ExpressionUUID->"6871b716-1ec0-4cec-848b-1f2b3ccd37c4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ladoCero", "=", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pasosCero", "=", "2000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"centroCero", "=", 
   RowBox[{"{", 
    RowBox[{"25", ",", "25"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mascaraCero", "=", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"ladoCero", ",", "ladoCero"}], "}"}]}], "]"}], ",", 
      RowBox[{"centroCero", "->", "1"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\t"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evoCero", "=", 
   RowBox[{"evolucionar", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{"ladoCero", ",", "ladoCero"}], "}"}]}], "]"}], ",", 
     "mascaraCero", ",", "pasosCero"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "[", "evoCero", "]"}], ",", 
   RowBox[{"Union", "[", 
    RowBox[{"Flatten", "[", "evoCero", "]"}], "]"}]}], "}"}]}], "Input",Expres\
sionUUID->"c2ac6e9a-df80-48e2-a867-2ea3ff5c52d7"],

Cell["Colores por estado", "Section",ExpressionUUID->"05bfdb2b-e4db-4de0-bc25-afc37d1e2e5c"],

Cell["\<\
Cada altura tiene su color; el generador usa el mismo color oscurecido. \
\>", "Text",ExpressionUUID->"6183aba8-027a-49f9-a00c-2c8914ae9197"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"paleta", "=", 
   RowBox[{"RGBColor", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<#f0efec\>\"", ",", "\"\<#2a78d6\>\"", ",", "\"\<#eb6834\>\"",
       ",", "\"\<#1baf7a\>\"", ",", "\"\<#eda100\>\"", ",", "\"\<#e34948\>\"",
       ",", "\"\<#8f5bd6\>\"", ",", "\"\<#3d3d3a\>\"", 
      ",", "\"\<#c2185b\>\""}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"colores", "=", 
   RowBox[{"Association", "[", "\[IndentingNewLine]", "\t\t", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"h", "->", 
        RowBox[{"paleta", "[", 
         RowBox[{"[", 
          RowBox[{"h", "+", "1"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"h", ",", "alturasNormales"}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "\t\t", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"h", "+", "desplazamiento"}], "->", 
        RowBox[{"Darker", "[", 
         RowBox[{
          RowBox[{"paleta", "[", 
           RowBox[{"[", 
            RowBox[{"h", "+", "1"}], "]"}], "]"}], ",", "0.45"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"h", ",", "alturasGenerador"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"granosTexto", "[", "h_", "]"}], ":=", 
   RowBox[{
    RowBox[{"ToString", "[", "h", "]"}], " ", "<>", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"h", "==", "1"}], ",", "\"\< grano\>\"", 
      ",", "\"\< granos\>\""}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nombres", "=", 
   RowBox[{"Association", "[", "\[IndentingNewLine]", "\t\t", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"h", "->", 
        RowBox[{
         RowBox[{"ToString", "[", "h", "]"}], " ", "<>", " ", "\"\<: \>\"", 
         " ", "<>", " ", 
         RowBox[{"granosTexto", "[", "h", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"h", ",", "alturasNormales"}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "\t\t", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"h", "+", "desplazamiento"}], "->", 
        RowBox[{
         RowBox[{"ToString", "[", 
          RowBox[{"h", "+", "desplazamiento"}], "]"}], " ", "<>", 
         " ", "\"\<: generador, \>\"", " ", "<>", " ", 
         RowBox[{"granosTexto", "[", "h", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"h", ",", "alturasGenerador"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"6ac81cb5-865a-4045-86fc-d61dfd9d01d6"],

Cell["Proporci\[OAcute]n de estados", "Section",ExpressionUUID->"6521576a-5b01-463c-b52f-df4fddc57646"],

Cell[TextData[{
 "Proporci\[OAcute]n de cada estado sobre todas las celdas de todos los pasos \
de las ",
 Cell[BoxData[Cell["nMuestras",
   Background->None,ExpressionUUID->"0ee399e2-2905-40af-96af-c302b6d66259"]], 
  "InlineCode",ExpressionUUID->"7b7a07c2-80e2-470f-a57b-63c0b718d5a4"],
 " evoluciones de ",
 StyleBox["evos", "TI"],
 ". Los generadores se etiquetan como en el documento ($0",
 StyleBox["i \[Ellipsis] 8",
  FontSlant->Italic],
 "i$). El eje y es logar\[IAcute]tmico porque los generadores son unas \
cuantas celdas por espacio; cada barra lleva su porcentaje."
}], "Text",ExpressionUUID->"36c68596-7d1a-466b-9a17-d21a1d3c52dc"],

Cell[TextData[{
 "El color de cada barra depende de la altura, con dos reglas de color: los \
estados normales van de azul claro (altura 0) a azul oscuro (altura 7) y los \
generadores de naranja claro ($0",
 StyleBox["i$) a naranja oscuro ($8",
  FontSlant->Italic],
 "i$). "
}], "Text",ExpressionUUID->"d7432646-5881-49b3-a022-f01726f09294"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"conteoEstados", "=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"BinCounts", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", "#", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"Length", "[", "estados", "]"}], ",", "1"}], "}"}]}], "]"}],
       " ", "&"}], " ", "/@", " ", "evos"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"proporcionEstados", "=", 
    RowBox[{"N", "[", 
     RowBox[{"conteoEstados", "/", 
      RowBox[{"Total", "[", "conteoEstados", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\t"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"colorNormal", "[", "h_", "]"}], ":=", 
   RowBox[{"Blend", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RGBColor", "[", "\"\<#cfe0f6\>\"", "]"}], ",", 
       RowBox[{"RGBColor", "[", "\"\<#2a78d6\>\"", "]"}], ",", 
       RowBox[{"RGBColor", "[", "\"\<#0b2f5e\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"h", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "umbral"}], "-", "1"}], ")"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"colorGenerador", "[", "h_", "]"}], ":=", 
   RowBox[{"Blend", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RGBColor", "[", "\"\<#fbd9c9\>\"", "]"}], ",", 
       RowBox[{"RGBColor", "[", "\"\<#eb6834\>\"", "]"}], ",", 
       RowBox[{"RGBColor", "[", "\"\<#6b2208\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"h", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "umbral"}], ")"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"colorBarra", "[", "s_", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"s", "<", "desplazamiento"}], ",", 
      RowBox[{"colorNormal", "[", "s", "]"}], ",", 
      RowBox[{"colorGenerador", "[", 
       RowBox[{"s", "-", "desplazamiento"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\t"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"etiquetaEstado", "[", "s_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"s", "<", "desplazamiento"}], ",", 
     RowBox[{"ToString", "[", "s", "]"}], ",", 
     RowBox[{"Subscript", "[", 
      RowBox[{
       RowBox[{"s", "-", "desplazamiento"}], ",", "\"\<i\>\""}], "]"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"porcentaje", "[", "p_", "]"}], ":=", 
   RowBox[{
    RowBox[{"ToString", "[", 
     RowBox[{"NumberForm", "[", 
      RowBox[{
       RowBox[{"100", " ", "p"}], ",", 
       RowBox[{"{", 
        RowBox[{"Infinity", ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"p", "<", "0.001"}], ",", "3", ",", "1"}], "]"}]}], 
        "}"}]}], "]"}], "]"}], " ", "<>", " ", "\"\<%\>\""}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"divisionesLog", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"10", "^", "k"}], ",", 
        RowBox[{"Superscript", "[", 
         RowBox[{"10", ",", "k"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"-", "5"}], ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\t", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Con", " ", "ScalingFunctions"}], " ", "->", " ", 
    RowBox[{"\"\<Log\>\"", " ", "las", " ", "coordenadas", " ", "del", " ", 
     "Epilog", " ", "van", " ", "en", " ", "logaritmo", " ", "natural"}]}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"etiquetasPorcentaje", "=", 
    RowBox[{"MapIndexed", "[", "\[IndentingNewLine]", "\t\t", 
     RowBox[{
      RowBox[{
       RowBox[{"Text", "[", 
        RowBox[{
         RowBox[{"Rotate", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"porcentaje", "[", "#1", "]"}], ",", "9", ",", "Black"}],
             "]"}], ",", 
           RowBox[{"90", " ", "Degree"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"First", "[", "#2", "]"}], ",", 
           RowBox[{"Log", "[", "#1", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"-", "1.3"}]}], "}"}]}], "]"}], " ", "&"}], ",", 
      "\[IndentingNewLine]", "\t\t", "proporcionEstados"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\t"}], "\[IndentingNewLine]", 
 RowBox[{"graficaProporcionEstados", "=", 
  RowBox[{"BarChart", "[", 
   RowBox[{"proporcionEstados", ",", "\[IndentingNewLine]", "\t\t", 
    RowBox[{"ChartStyle", "->", 
     RowBox[{"(", 
      RowBox[{"colorBarra", " ", "/@", " ", "estados"}], ")"}]}], ",", 
    "\[IndentingNewLine]", "\t\t", 
    RowBox[{"ChartLabels", "->", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"etiquetaEstado", " ", "/@", " ", "estados"}], ",", "Axis"}], 
      "]"}]}], ",", "\[IndentingNewLine]", "\t\t", 
    RowBox[{"ScalingFunctions", "->", "\"\<Log\>\""}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"10", "^", 
        RowBox[{"-", "5"}]}], ",", "3"}], "}"}]}], ",", "\[IndentingNewLine]",
     "\t\t", 
    RowBox[{"Epilog", "->", "etiquetasPorcentaje"}], ",", 
    "\[IndentingNewLine]", "\t\t", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"Axes", "->", "False"}], ",", 
    RowBox[{"FrameStyle", "->", 
     RowBox[{"GrayLevel", "[", "0.4", "]"}]}], ",", "\[IndentingNewLine]", 
    "\t\t", 
    RowBox[{"FrameTicks", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"divisionesLog", ",", "None"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Automatic", ",", "None"}], "}"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", "\t\t", 
    RowBox[{"FrameTicksStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"Black", ",", "11"}], "]"}]}], ",", 
    RowBox[{"LabelStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"Black", ",", "12"}], "]"}]}], ",", "\[IndentingNewLine]", 
    "\t\t", 
    RowBox[{"GridLines", "->", 
     RowBox[{"{", 
      RowBox[{"None", ",", 
       RowBox[{"divisionesLog", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "}"}]}], ",", 
    RowBox[{"GridLinesStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"GrayLevel", "[", "0.85", "]"}], "]"}]}], ",", 
    "\[IndentingNewLine]", "\t\t", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Estado\>\"", ",", "\"\<Proporci\[OAcute]n\>\""}], "}"}]}], 
    ",", 
    RowBox[{
    "PlotLabel", 
     "->", "\"\<Proporci\[OAcute]n de estados en todas las evoluciones\>\""}],
     ",", "\[IndentingNewLine]", "\t\t", 
    RowBox[{"ImageSize", "->", "400"}], ",", 
    RowBox[{"AspectRatio", "->", 
     RowBox[{"3", "/", "4"}]}]}], "]"}]}]}], "Input",ExpressionUUID->\
"e08f673c-f5fe-431d-bd7b-d264931995df"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<../../../Documentation/img/experimentacion/duplicacion/sandpile/sp_proportion.png\>\"", ",", 
    "graficaProporcionEstados", ",", 
    RowBox[{"ImageResolution", "->", "200"}]}], "]"}], ";"}]], "Input",Express\
ionUUID->"9468e536-89e9-4d45-bece-40cae19493a2"],

Cell["Animaci\[OAcute]n", "Section",ExpressionUUID->"cfbe17d5-cb4c-467a-944e-566f9542d4fc"],

Cell[TextData[{
 "Un cuadro cada ",
 Cell[BoxData[Cell["cadaGif",
   Background->None,ExpressionUUID->"616ec960-8710-49e1-abc2-62863d32631e"]], 
  "InlineCode",ExpressionUUID->"c2e23901-99bb-4f6d-bafb-e20fdd6483f1"],
 " pasos; cada celda es de 8 \[Times] 8 p\[IAcute]xeles. "
}], "Text",ExpressionUUID->"77fe579b-192b-48be-a8b9-7a13caa6ec5b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"salida", "=", "\"\<../CA/Sandpile\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cadaGif", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cuadros", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ImageResize", "[", 
      RowBox[{
       RowBox[{"Image", "[", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"List", " ", "@@", " ", 
            RowBox[{"colores", "[", "#", "]"}]}], " ", "&"}], ",", 
          RowBox[{"evolucion", "[", 
           RowBox[{"[", 
            RowBox[{"k", "+", "1"}], "]"}], "]"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"8", " ", "lado"}], ",", 
       RowBox[{"Resampling", "->", "\"\<Nearest\>\""}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "pasos", ",", "cadaGif"}], "}"}]}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"salida", ",", "\"\<evo.gif\>\""}], "}"}], "]"}], ",", 
    "cuadros", ",", 
    RowBox[{"\"\<DisplayDurations\>\"", "->", "0.05"}], ",", 
    RowBox[{"AnimationRepetitions", "->", "Infinity"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"ca2002ca-da9a-46b3-9d4b-a2a8527c0559"],

Cell["Exportar datos", "Section",ExpressionUUID->"17b25a8c-a0bf-4c57-b0b1-bc74fe1e1f12"],

Cell[TextData[{
 "Mismo formato que exporta el simulador (GUI) y que lee ",
 Cell[BoxData[Cell["scripts/main.py",
   Background->None,ExpressionUUID->"fff878bd-b95c-4164-865a-e225e7ece150"]], 
  "InlineCode",ExpressionUUID->"37c180ae-f7ce-4f44-8cb9-26180f7c1075"],
 ": la evoluci\[OAcute]n ",
 Cell[BoxData[Cell["(pasos + 1, lado, lado)",
   Background->None,ExpressionUUID->"4784a11b-f871-44da-8987-921591febb3c"]], 
  "InlineCode",ExpressionUUID->"4253d201-47f6-45f6-b1a2-0d6e38212c6e"],
 " en enteros de 32 bits, como ",
 Cell[BoxData[Cell["evo.npy",
   Background->None,ExpressionUUID->"5c546d83-90d0-46c5-99ee-710e82f137ac"]], 
  "InlineCode",ExpressionUUID->"7fcaae54-34f5-4ad5-b7e0-99b10b272dca"],
 " y como ",
 Cell[BoxData[Cell["evo.mat",
   Background->None,ExpressionUUID->"073574ec-986c-48bb-99ea-3fcc505fa231"]], 
  "InlineCode",ExpressionUUID->"257676af-d11a-404a-b330-cb028d33133f"],
 " (variable ",
 StyleBox["evolution", "TI"],
 ", comprimido). ",
 Cell[BoxData[Cell["evo.json",
   Background->None,ExpressionUUID->"3af79919-8ca9-42b8-af79-9451b871b391"]], 
  "InlineCode",ExpressionUUID->"17041e5d-0a63-4959-b9b1-f1e6413aed82"],
 " guarda los par\[AAcute]metros, el significado y color de cada estado y la \
fracci\[OAcute]n de celdas en cada estado."
}], "Text",ExpressionUUID->"439adea3-565a-4f15-9e84-50f43a332ace"],

Cell[TextData[{
 "Mathematica no exporta ",
 Cell[BoxData[Cell[".npy",
   Background->None,ExpressionUUID->"105fa9b7-dd86-4280-be05-a3e1c27c4a00"]], 
  "InlineCode",ExpressionUUID->"ca09db36-54da-4598-839a-d34507ce9a6c"],
 ", as\[IAcute] que ",
 Cell[BoxData[Cell["exportarNPY",
   Background->None,ExpressionUUID->"ccf82cd1-e373-48aa-a259-5a7b3e7556e5"]], 
  "InlineCode",ExpressionUUID->"8e4c3caf-7579-40f3-a519-b95152a7b8f0"],
 " escribe el formato NPY 1.0 a mano: encabezado con tipo ",
 Cell[BoxData[Cell["<i4",
   Background->None,ExpressionUUID->"9653d709-aac9-4a75-a41b-81bc9632abaf"]], 
  "InlineCode",ExpressionUUID->"0975476c-32b4-4992-9ca7-9c070e3e859e"],
 ", orden C y forma, y despu\[EAcute]s los datos por bloques. "
}], "Text",ExpressionUUID->"90f3353f-9411-4305-bec6-c9387a1c6d25"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"exportarNPY", "[", 
    RowBox[{"archivo_String", ",", "datos_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dims", "=", 
        RowBox[{"Dimensions", "[", "datos", "]"}]}], ",", "cab", ",", "s", ",", 
       RowBox[{"b", "=", "500"}]}], "}"}], ",", "\[IndentingNewLine]", "\t\t", 
     RowBox[{
      RowBox[{"cab", "=", 
       RowBox[{"\"\<{'descr': '<i4', 'fortran_order': False, 'shape': (\>\"", 
        " ", "<>", " ", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{
          RowBox[{"ToString", " ", "/@", " ", "dims"}], ",", "\"\<, \>\""}], 
         "]"}], " ", "<>", " ", "\"\<), }\>\""}]}], ";", " ", 
      "\[IndentingNewLine]", "\t\t", 
      RowBox[{"cab", "=", 
       RowBox[{"cab", " ", "<>", " ", 
        RowBox[{"StringRepeat", "[", 
         RowBox[{"\"\< \>\"", ",", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"10", "+", 
               RowBox[{"StringLength", "[", "cab", "]"}], "+", "1"}], ")"}]}],
             ",", "64"}], "]"}]}], "]"}], " ", "<>", " ", "\"\<\\n\>\""}]}], ";",
       " ", "\[IndentingNewLine]", "\t\t", 
      RowBox[{"s", "=", 
       RowBox[{"OpenWrite", "[", 
        RowBox[{"archivo", ",", 
         RowBox[{"BinaryFormat", "->", "True"}]}], "]"}]}], ";", " ", 
      "\[IndentingNewLine]", "\t\t", 
      RowBox[{"BinaryWrite", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", "147", "}"}], ",", 
          RowBox[{"ToCharacterCode", "[", "\"\<NUMPY\>\"", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}]}], "]"}], 
        ",", "\"\<UnsignedInteger8\>\""}], "]"}], ";", " ", 
      "\[IndentingNewLine]", "\t\t", 
      RowBox[{"BinaryWrite", "[", 
       RowBox[{"s", ",", 
        RowBox[{"StringLength", "[", "cab", "]"}], 
        ",", "\"\<UnsignedInteger16\>\"", ",", 
        RowBox[{"ByteOrdering", "->", 
         RowBox[{"-", "1"}]}]}], "]"}], ";", " ", "\[IndentingNewLine]", 
      "\t\t", 
      RowBox[{"BinaryWrite", "[", 
       RowBox[{"s", ",", "cab", ",", "\"\<Character8\>\""}], "]"}], ";", " ", 
      "\[IndentingNewLine]", "\t\t", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"BinaryWrite", "[", 
         RowBox[{"s", ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{"datos", "[", 
             RowBox[{"[", 
              RowBox[{"i", " ", ";;", " ", 
               RowBox[{"Min", "[", 
                RowBox[{
                 RowBox[{"i", "+", "b", "-", "1"}], ",", 
                 RowBox[{"First", "[", "dims", "]"}]}], "]"}]}], "]"}], "]"}],
             "]"}], "]"}], ",", "\"\<Integer32\>\"", ",", 
          RowBox[{"ByteOrdering", "->", 
           RowBox[{"-", "1"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"First", "[", "dims", "]"}], ",", "b"}], "}"}]}], "]"}], ";",
       " ", "\[IndentingNewLine]", "\t\t", 
      RowBox[{"Close", "[", "s", "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hex", "[", "c_", "]"}], ":=", 
   RowBox[{"\"\<#\>\"", " ", "<>", " ", 
    RowBox[{"StringJoin", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"IntegerString", "[", 
        RowBox[{
         RowBox[{"Round", "[", 
          RowBox[{"255", " ", "#"}], "]"}], ",", "16", ",", "2"}], "]"}], " ",
        "&"}], " ", "/@", " ", 
      RowBox[{"List", " ", "@@", " ", 
       RowBox[{"ColorConvert", "[", 
        RowBox[{"c", ",", "\"\<RGB\>\""}], "]"}]}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fraccionEstados", "[", "datos_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"t", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"Length", "[", "estados", "]"}]}], "]"}]}], ",", 
        RowBox[{"b", "=", "500"}]}], "}"}], ",", "\[IndentingNewLine]", 
      "\t\t", 
      RowBox[{
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"t", " ", "+=", " ", 
          RowBox[{"BinCounts", "[", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"Normal", "[", 
              RowBox[{"datos", "[", 
               RowBox[{"[", 
                RowBox[{"i", " ", ";;", " ", 
                 RowBox[{"Min", "[", 
                  RowBox[{
                   RowBox[{"i", "+", "b", "-", "1"}], ",", 
                   RowBox[{"Length", "[", "datos", "]"}]}], "]"}]}], "]"}], 
               "]"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"Length", "[", "estados", "]"}], ",", "1"}], "}"}]}], 
           "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "datos", "]"}], ",", "b"}], "}"}]}], "]"}], 
       ";", " ", "\[IndentingNewLine]", "\t\t", 
       RowBox[{"N", "[", 
        RowBox[{"t", "/", 
         RowBox[{"Total", "[", "t", "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"exportarNPY", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"salida", ",", "\"\<evo.npy\>\""}], "}"}], "]"}], ",", 
    "evolucion"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"salida", ",", "\"\<evo.mat\>\""}], "}"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"\"\<evolution\>\"", "->", 
      RowBox[{"NumericArray", "[", 
       RowBox[{"evolucion", ",", "\"\<Integer32\>\""}], "]"}]}], "}"}], 
    ",", "\"\<LabeledData\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"salida", ",", "\"\<evo.json\>\""}], "}"}], "]"}], ",", 
    RowBox[{"<|", "\[IndentingNewLine]", "\t\t", 
     RowBox[{
      RowBox[{"\"\<simulation\>\"", "->", "\"\<sandpile\>\""}], ",", 
      RowBox[{"\"\<rule\>\"", 
       "->", "\"\<sincrona; el generador agrega un grano solo si no se \
derrumba\>\""}], ",", "\[IndentingNewLine]", "\t\t", 
      RowBox[{"\"\<shape\>\"", "->", 
       RowBox[{"Dimensions", "[", "evolucion", "]"}]}], ",", 
      RowBox[{"\"\<size\>\"", "->", "lado"}], ",", 
      RowBox[{"\"\<steps\>\"", "->", "pasos"}], ",", "\[IndentingNewLine]", 
      "\t\t", 
      RowBox[{"\"\<generators\>\"", "->", "generadores"}], ",", 
      RowBox[{"\"\<threshold\>\"", "->", "umbral"}], ",", 
      RowBox[{"\"\<grains_per_toppling\>\"", "->", "reparto"}], ",", 
      RowBox[{"\"\<boundary\>\"", "->", "\"\<open\>\""}], ",", 
      "\[IndentingNewLine]", "\t\t", 
      RowBox[{"\"\<state_encoding\>\"", 
       "->", "\"\<altura en celdas normales; altura + 8 en celdas generadoras\
\>\""}], ",", "\[IndentingNewLine]", "\t\t", 
      RowBox[{"\"\<states\>\"", "->", 
       RowBox[{"Values", "[", 
        RowBox[{"KeySort", "[", "nombres", "]"}], "]"}]}], ",", 
      RowBox[{"\"\<colors_hex\>\"", "->", 
       RowBox[{"(", 
        RowBox[{"hex", " ", "/@", " ", 
         RowBox[{"Values", "[", 
          RowBox[{"KeySort", "[", "colores", "]"}], "]"}]}], ")"}]}], ",", 
      "\[IndentingNewLine]", "\t\t", 
      RowBox[{"\"\<state_fraction\>\"", "->", 
       RowBox[{"fraccionEstados", "[", "evolucion", "]"}]}]}], "|>"}], 
    ",", "\"\<RawJSON\>\""}], "]"}], ";"}]}], "Input",ExpressionUUID->\
"886a896b-d818-4cf6-a2a2-79b1c87cd9f0"]
},
