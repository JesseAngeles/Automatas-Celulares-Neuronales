   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"umbral", "=", "4"}], ";"}], "                      ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "granos", " ", "con", " ", "los", " ", "que", " ", "una", " ", "celda", " ",
     "se", " ", "derrumba"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"reparto", "=", "4"}], ";"}], "                     ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "granos", " ", "que", " ", "entrega", " ", "al", " ", "derrumbarse"}], ",",
     " ", 
    RowBox[{"uno", " ", "por", " ", "vecino"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"alturas", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", 
     RowBox[{"umbral", "-", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"estados", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", 
     RowBox[{
      RowBox[{"2", " ", "umbral"}], "-", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mascara", "=", 
   RowBox[{"ReplacePart", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{"lado", ",", "lado"}], "}"}]}], "]"}], ",", 
     RowBox[{"Thread", "[", 
      RowBox[{"generadores", "->", "1"}], "]"}]}], "]"}]}], ";"}]}], "Input",E\
xpressionUUID->"16ea3543-2a8b-4b07-8f2e-52079f26f966"],

Cell["Simulaci\[OAcute]n", "Section",ExpressionUUID->"e5d5209f-fd34-4523-b4c1-f9a467eb0e54"],

Cell[TextData[{
 StyleBox["derrumbar", "TI"],
 " aplica una ronda: todas las celdas inestables se derrumban a la vez. ",
 StyleBox["relajar", "TI"],
 " repite rondas hasta que no queda ninguna inestable. Como el modelo es \
abeliano, el estado estable final no depende del orden de los derrumbes. El \
tama\[NTilde]o de la avalancha es el n\[UAcute]mero total de derrumbes. La \
simulaci\[OAcute]n trabaja con alturas; los estados de generador solo se \
agregan al guardar cada cuadro. "
}], "Text",ExpressionUUID->"00b77196-e708-4250-b8bd-e7adab0b0f50"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"derrumbar", "[", "g_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t", "=", 
        RowBox[{"UnitStep", "[", 
         RowBox[{"g", "-", "umbral"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"g", "-", 
       RowBox[{"reparto", " ", "t"}], "+", "\[IndentingNewLine]", "\t", 
       RowBox[{"ArrayPad", "[", 
        RowBox[{"t", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], "]"}], "+", 
       RowBox[{"ArrayPad", "[", 
        RowBox[{"t", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], "]"}], "+", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"ArrayPad", "[", 
        RowBox[{"t", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}], "+", 
       RowBox[{"ArrayPad", "[", 
        RowBox[{"t", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"relajar", "[", "g0_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g", "=", "g0"}], ",", 
        RowBox[{"derrumbes", "=", "0"}], ",", "t"}], "}"}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", "g", "]"}], ">=", "umbral"}], ",", 
         "\[IndentingNewLine]", "\t\t", 
         RowBox[{
          RowBox[{"t", "=", 
           RowBox[{"UnitStep", "[", 
            RowBox[{"g", "-", "umbral"}], "]"}]}], ";", " ", 
          RowBox[{"derrumbes", " ", "+=", " ", 
           RowBox[{"Total", "[", 
            RowBox[{"t", ",", "2"}], "]"}]}], ";", " ", 
          RowBox[{"g", "=", 
           RowBox[{"derrumbar", "[", "g", "]"}]}]}]}], "]"}], ";", " ", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"{", 
        RowBox[{"g", ",", "derrumbes"}], "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"simular", "[", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"lado", ",", "lado"}], "}"}]}], "]"}]}], ",", "evo", ",", 
        "avalanchas", ",", "r"}], "}"}], ",", "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"evo", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pasos", "+", "1"}], ",", "lado", ",", "lado"}], "}"}]}], 
         "]"}]}], ";", " ", "\[IndentingNewLine]", "\t", 
       RowBox[{"avalanchas", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", "pasos"}], "]"}]}], ";", " ", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{
        RowBox[{"evo", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", 
        RowBox[{"g", "+", 
         RowBox[{"umbral", " ", "mascara"}]}]}], ";", " ", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "\t\t", 
        RowBox[{
         RowBox[{
          RowBox[{"Scan", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"g", "[", 
                RowBox[{"[", 
                 RowBox[{"Sequence", " ", "@@", " ", "#"}], "]"}], "]"}], 
               "++"}], ")"}], " ", "&"}], ",", "generadores"}], "]"}], ";", 
          " ", "\[IndentingNewLine]", "\t\t", 
          RowBox[{"r", "=", 
           RowBox[{"relajar", "[", "g", "]"}]}], ";", " ", 
          RowBox[{"g", "=", 
           RowBox[{"r", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", "\[IndentingNewLine]",
           "\t\t", 
          RowBox[{
           RowBox[{"avalanchas", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "=", 
           RowBox[{"r", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", 
          RowBox[{
           RowBox[{"evo", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "1"}], "]"}], "]"}], "=", 
           RowBox[{"g", "+", 
            RowBox[{"umbral", " ", "mascara"}]}]}]}], ",", 
         "\[IndentingNewLine]", "\t\t", 
         RowBox[{"{", 
          RowBox[{"k", ",", "pasos"}], "}"}]}], "]"}], ";", " ", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"{", 
        RowBox[{"evo", ",", "avalanchas"}], "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"evolucion", ",", "avalanchas"}], "}"}], "=", 
   RowBox[{"simular", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"altura", "=", 
   RowBox[{"Mod", "[", 
    RowBox[{"evolucion", ",", "umbral"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "[", "evolucion", "]"}], ",", 
   RowBox[{"Union", "[", 
    RowBox[{"Flatten", "[", "evolucion", "]"}], "]"}], ",", 
   RowBox[{"Max", "[", "avalanchas", "]"}]}], "}"}]}], "Input",ExpressionUUID->\
"fb9fa5ee-2291-442f-bdc2-235f0ffa4fb2"],

Cell["Colores por estado", "Section",ExpressionUUID->"d473c455-a0bb-414b-8cc2-e311d164b42f"],

Cell["\<\
Cada altura tiene su color; el generador usa el mismo color oscurecido. En \
los espacios, un recuadro negro marca los generadores. \
\>", "Text",ExpressionUUID->"b521f768-05f2-49c7-9c20-5a34221f1758"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"paleta", "=", 
   RowBox[{"RGBColor", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<#f0efec\>\"", ",", "\"\<#2a78d6\>\"", ",", "\"\<#eb6834\>\"",
       ",", "\"\<#1baf7a\>\"", ",", "\"\<#eda100\>\""}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"colores", "=", 
    RowBox[{"Association", "[", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"h", "->", 
         RowBox[{"paleta", "[", 
          RowBox[{"[", 
           RowBox[{"h", "+", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"h", ",", "alturas"}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"h", "+", "umbral"}], "->", 
         RowBox[{"Darker", "[", 
          RowBox[{
           RowBox[{"paleta", "[", 
            RowBox[{"[", 
             RowBox[{"h", "+", "1"}], "]"}], "]"}], ",", "0.45"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"h", ",", "alturas"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "El", " ", "estado", " ", "0", " ", "es", " ", "casi", " ", "blanco", " ",
      "en", " ", "el", " ", "espacio"}], ";", " ", 
    RowBox[{
    "en", " ", "las", " ", "gr\[AAcute]ficas", " ", "de", " ", 
     "l\[IAcute]neas", " ", "se", " ", "dibuja", " ", "en", " ", "gris"}]}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coloresLinea", "=", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{"KeyTake", "[", 
      RowBox[{"colores", ",", "alturas"}], "]"}], ",", 
     RowBox[{"0", "->", 
      RowBox[{"GrayLevel", "[", "0.55", "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"granosTexto", "[", "h_", "]"}], ":=", 
   RowBox[{
    RowBox[{"ToString", "[", "h", "]"}], " ", "<>", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"h", "==", "1"}], ",", "\"\< grano\>\"", 
      ",", "\"\< granos\>\""}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nombres", "=", 
   RowBox[{"Association", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"h", "->", 
        RowBox[{
         RowBox[{"ToString", "[", "h", "]"}], " ", "<>", " ", "\"\<: \>\"", 
         " ", "<>", " ", 
         RowBox[{"granosTexto", "[", "h", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"h", ",", "alturas"}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"h", "+", "umbral"}], "->", 
        RowBox[{
         RowBox[{"ToString", "[", 
          RowBox[{"h", "+", "umbral"}], "]"}], " ", "<>", 
         " ", "\"\<: generador, \>\"", " ", "<>", " ", 
         RowBox[{"granosTexto", "[", "h", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"h", ",", "alturas"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"leyendaEstados", "=", 
    RowBox[{"SwatchLegend", "[", 
     RowBox[{
      RowBox[{"Values", "[", "colores", "]"}], ",", 
      RowBox[{"Values", "[", "nombres", "]"}], ",", 
      RowBox[{"LegendMarkerSize", "->", "14"}], ",", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{"LegendMarkers", "->", 
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"EdgeForm", "[", 
           RowBox[{"GrayLevel", "[", "0.6", "]"}], "]"}], ",", 
          RowBox[{"Rectangle", "[", "]"}]}], "}"}], "]"}]}]}], "]"}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"marcaGeneradores", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"EdgeForm", "[", 
      RowBox[{"{", 
       RowBox[{"Black", ",", 
        RowBox[{"AbsoluteThickness", "[", "1.2", "]"}]}], "}"}], "]"}], ",", 
     RowBox[{"FaceForm", "[", "None", "]"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"Rectangle", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", "1", "-", "1.5"}], ",", 
           RowBox[{"lado", "-", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", "1.5"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "+", "1.5"}], ",", 
           RowBox[{"lado", "-", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", "1", "+", "1.5"}]}], 
          "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", "generadores"}]}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"espacio", "[", 
    RowBox[{"k_", ",", "opts___"}], "]"}], ":=", 
   RowBox[{"ArrayPlot", "[", 
    RowBox[{
     RowBox[{"evolucion", "[", 
      RowBox[{"[", 
       RowBox[{"k", "+", "1"}], "]"}], "]"}], ",", 
     RowBox[{"ColorRules", "->", 
      RowBox[{"Normal", "[", "colores", "]"}]}], ",", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameTicks", "->", "None"}], ",", 
     RowBox[{"FrameStyle", "->", 
      RowBox[{"GrayLevel", "[", "0.6", "]"}]}], ",", 
     RowBox[{"Epilog", "->", "marcaGeneradores"}], ",", "\[IndentingNewLine]",
      "\t", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"\"\<Paso \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "k", "]"}]}], ",", "Black", ",", "12"}], 
       "]"}]}], ",", 
     RowBox[{"ImageSize", "->", "160"}], ",", "opts"}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"b70e19b9-683a-4d72-a471-d7f56d6553e6"],

