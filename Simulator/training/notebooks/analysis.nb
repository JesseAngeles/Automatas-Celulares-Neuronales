Cell[BoxData[{
 RowBox[{
  RowBox[{"evo1", "=", 
   RowBox[{
    RowBox[{"Import", "[", "\"\<./Evolutions/gol_1000s.mat\>\"", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evo2", "=", 
   RowBox[{"CellularAutomaton", "[", 
    RowBox[{"\"\<GameOfLife\>\"", ",", 
     RowBox[{"evo1", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", "1000"}], "]"}]}], ";"}]}], "Input",\

 CellChangeTimes->{{3.987930293587781*^9, 3.9879303024768667`*^9}, {
  3.987930374243635*^9, 3.987930567984583*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"dfca05a1-f8bc-4952-8bf9-2a0f54bd96f2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"plot1", "=", 
   RowBox[{"ArrayPlot", "[", 
    RowBox[{"evo1", "[", 
     RowBox[{"[", 
      RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plot2", "=", 
   RowBox[{"ArrayPlot", "[", 
    RowBox[{"evo2", "[", 
     RowBox[{"[", 
      RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plot3", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{"#", ",", "2"}], "]"}], "&"}], ",", 
       RowBox[{"Abs", "[", 
        RowBox[{"evo1", "-", "evo2"}], "]"}]}], "]"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Diferencia absoluta por paso\>\""}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Paso\>\"", ",", "\"\<Pixeles discordantes\>\""}], 
       "}"}]}]}], "]"}]}], ";"}]}], "Input",
