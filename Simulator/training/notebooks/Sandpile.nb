Cell["Tasa de aprendizaje con decaimiento exponencial", "Section",ExpressionUUID->"3e3b7bb5-23a9-4eb1-bbe5-51792f12e6d3"],

Cell[TextData[{
 "La tasa de aprendizaje baja de 0.001 a 0.000001 con decaimiento exponencial \
a lo largo de las 2000 \[EAcute]pocas (",
 Cell[BoxData[Cell["--lr-schedule exp",
   Background->None,ExpressionUUID->"23cd5356-cd33-4efe-bd81-30d0828e9e92"]], 
  "InlineCode",ExpressionUUID->"031e5ff3-c044-4ed6-9c29-29d98a23a159"],
 "). No alcanza la p\[EAcute]rdida objetivo y termina en la \[EAcute]poca \
1999. "
}], "Text",ExpressionUUID->"47ff82ec-3752-4ef6-a3e4-f33cd46c7c04"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"graficaExp", "=", 
   RowBox[{"graficaPerdidaDe", "[", 
    RowBox[{"\"\<../NCA/Sandpile/4generadores/objetivo0.000001_exp/2-64-relu_\
17-linear.csv\>\"", ",", "0.000001"}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<../../../Documentation/img/experimentacion/duplicacion/\
sandpile/sp_4generadores_loss_exp.png\>\"", ",", "graficaExp", ",", 
    RowBox[{"ImageResolution", "->", "200"}]}], "]"}], ";"}]}], "Input",Expres\
sionUUID->"3cef4642-f278-4d72-8fa0-a60719186a05"],

Cell["Tasa de aprendizaje con decaimiento din\[AAcute]mico", "Section",ExpressionUUID->"2bbc85a7-1597-4813-9fcf-8352773f40b3"],

Cell[TextData[{
 "La tasa de aprendizaje empieza en 0.001 y se reduce a la mitad cuando la p\
\[EAcute]rdida no supera su m\[IAcute]nimo en 20 \[EAcute]pocas (",
 Cell[BoxData[Cell["--lr-schedule plateau",
   Background->None,ExpressionUUID->"e75ab038-49b0-4c46-9eec-bd8f5dbd4f3f"]], 
  "InlineCode",ExpressionUUID->"c82406ea-0011-475b-bd17-2e577244a667"],
 ", ",
 Cell[BoxData[Cell["ReduceLROnPlateau",
   Background->None,ExpressionUUID->"6ffb6571-cc43-4489-9bd0-05960818eb1b"]], 
  "InlineCode",ExpressionUUID->"741ed262-d0c7-4760-a6ee-73fa0f0ffb45"],
 "), sin bajar de 0.000001. Se redujo en las \[EAcute]pocas 230, 252, 569, \
942 y 1053 (hasta 0.00003125) y converge en la \[EAcute]poca 1318. "
}], "Text",ExpressionUUID->"96fc808b-94a9-4152-9614-4db97d60b402"],

