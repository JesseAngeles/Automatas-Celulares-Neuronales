       " ", "que", " ", "ambas", " ", "tengan", " ", "el", " ", "mismo", " ", 
      "tama\[NTilde]o"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m9", "=", 
