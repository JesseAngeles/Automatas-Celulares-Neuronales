       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}], "==", 
        RowBox[{"{", 
         RowBox[{"6", ",", "6"}], "}"}]}], ",", "2", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"i", "-", "6"}], "]"}], "<=", "4"}], "&&", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"j", "-", "6"}], "]"}], "<=", "4"}]}], ",", "1", ",", 
       "True", ",", "0"}], "]"}], ",", 
     RowBox[{"{", 
