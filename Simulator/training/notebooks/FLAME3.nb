Cell["Distribuci\[OAcute]n de estados de FLAME 3", "Chapter",ExpressionUUID->"d259843e-9149-46e7-a5c2-0711b686e72a"],

Cell[TextData[{
 "Proporci\[OAcute]n de celdas en cada estado, juntando los tres conjuntos \
limpios y segmentados de ",
 Cell[BoxData[Cell["CA/FLAME3/seleccion2",
   Background->None,ExpressionUUID->"307e30f2-100f-484b-8bc8-4e2c967707b6"]], 
  "InlineCode",ExpressionUUID->"803602c9-bad4-4c4a-b25d-0ad7c53f9c49"],
 " (todas las celdas de todos los frames de ",
 Cell[BoxData[Cell["flame_plot_1",
   Background->None,ExpressionUUID->"ac1f8cf5-fcc2-433f-8f41-0a49b335f4c5"]], 
  "InlineCode",ExpressionUUID->"953bbcad-a00f-4cf2-a6a2-aa3ecfe53af9"],
 ", ",
 Cell[BoxData[Cell["flame_plot_2",
   Background->None,ExpressionUUID->"3273ae55-5d47-4497-b721-5347cf56a8da"]], 
  "InlineCode",ExpressionUUID->"57de0c9d-0d9d-407c-a8de-d000bae33d56"],
 " y ",
 Cell[BoxData[Cell["flame_plot_3",
   Background->None,ExpressionUUID->"cf253e3d-59c6-43e5-8747-944cf6bbd5da"]], 
  "InlineCode",ExpressionUUID->"105a65de-9fda-4069-a452-2ef97c23ab6a"],
 ", 100\[Times]100). Cuatro versiones: "
}], "Text",ExpressionUUID->"ecf9b04f-4b8d-48a1-a3b7-081b1da76c9f"],

Cell[TextData[{
 "15 estados: los de ",
 Cell[BoxData[Cell["tiff_to_states.py",
   Background->None,ExpressionUUID->"25e65488-d6bb-447f-85da-fad350288a81"]], 
  "InlineCode",ExpressionUUID->"90543e36-d73a-4723-a77e-85c4d1078659"],
 ", 15 cortes iguales en log(\[Degree]C) comunes a los tres conjuntos (",
 Cell[BoxData[Cell["<conjunto>/evo.mat",
   Background->None,ExpressionUUID->"bf517b04-a908-45db-8612-5e6a989b8a2b"]], 
  "InlineCode",ExpressionUUID->"c7cf0b41-ba67-4dd9-a0b5-e43b84b5f2b9"],
 ")."
}], "Item",ExpressionUUID->"ce12d3af-f8ac-47f4-b862-8a405af9d798"],

Cell[TextData[{
 "13 estados: los estados 0, 1 y 2 unidos en uno (25.3\[Dash]47.8 \
\[Degree]C), de ",
 Cell[BoxData[Cell["merge_states.py --merge 0 1 2",
   Background->None,ExpressionUUID->"510f3ca7-531f-46c1-9482-78900ab976d0"]], 
  "InlineCode",ExpressionUUID->"e77afba4-0df5-4037-ae7d-29f4fa0e90c7"],
 " (",
 Cell[BoxData[Cell["<conjunto>/estados13/evo.mat",
   Background->None,ExpressionUUID->"a9638b61-312a-486d-aead-fb7ee4723391"]], 
  "InlineCode",ExpressionUUID->"327db5df-9c63-434c-a63e-25a631c359e7"],
 ")."
}], "Item",ExpressionUUID->"a8858bf0-5055-49f6-bc16-124d10f13f09"],

Cell[TextData[{
 "12 estados: los estados 0 a 3 unidos en uno (25.3\[Dash]59.0 \[Degree]C), \
de ",
 Cell[BoxData[Cell["merge_states.py --merge 0 1 2 3",
   Background->None,ExpressionUUID->"0634e246-9a95-48b4-9b7f-85ad2b0bb2ea"]], 
  "InlineCode",ExpressionUUID->"f58f79bd-6eec-4424-963a-ae13044b469f"],
 " (",
 Cell[BoxData[Cell["<conjunto>/estados12/evo.mat",
   Background->None,ExpressionUUID->"6b02f15b-9d4d-4df4-aacb-d36131984064"]], 
  "InlineCode",ExpressionUUID->"05c43f06-979d-4da9-be78-4ae683725451"],
 ")."
}], "Item",ExpressionUUID->"a42631b9-45cc-4fcf-b62a-bd61c4cbcf3f"],

Cell[TextData[{
 "18 estados: 12 de temperatura y 6 de quemado, de ",
 Cell[BoxData[Cell["burned_states.py --burned 6 --rise 30",
   Background->None,ExpressionUUID->"582ee842-b9ce-44ff-9ce9-fdf6ab54a9f8"]], 
  "InlineCode",ExpressionUUID->"1002ae0b-f64b-4bc1-8d19-345dabe8231a"],
 " (",
 Cell[BoxData[Cell["BurnedStates/<conjunto>/evo.mat",
   Background->None,ExpressionUUID->"4abf3f24-6679-40ff-b2b9-c00ab5d73e6d"]], 
  "InlineCode",ExpressionUUID->"56394bb9-c189-4609-9dc6-c28f915a7458"],
 "). Solo ",
 Cell[BoxData[Cell["flame_plot_1",
   Background->None,ExpressionUUID->"a289a7e9-10c2-4590-a57d-cd14935fa724"]], 
  "InlineCode",ExpressionUUID->"ff8bd54f-b045-4bb8-b813-84f419c43181"],
 " (IRX 662\[Dash]777) y ",
 Cell[BoxData[Cell["flame_plot_2",
   Background->None,ExpressionUUID->"783ed61b-36c3-43d7-bd3f-f0a9452aa045"]], 
  "InlineCode",ExpressionUUID->"4ec06c87-e98a-4b75-b6b5-7f95dba8df3d"],
 " (IRX 1189\[Dash]1254)."
}], "Item",ExpressionUUID->"0ed3e528-c756-43c8-8106-daf71f6a1407"],

Cell["Funciones", "Section",ExpressionUUID->"08be3913-696f-4940-a9c3-5b6e8aad9c20"],

Cell[TextData[{
 "Cada barra lleva el color del estado en la GUI (la paleta que indica ",
 Cell[BoxData[Cell["evo.json",
   Background->None,ExpressionUUID->"761d77de-e341-48d1-aa5e-5fde06ce1fde"]], 
  "InlineCode",ExpressionUUID->"4a0e073e-5fe3-4057-86b4-d5ff94adcf63"],
 "), el n\[UAcute]mero de estado encima y su rango en \[Degree]C abajo. La \
escala logar\[IAcute]tmica muestra los estados m\[AAcute]s calientes, que en \
la escala lineal casi no se ven. "
}], "Text",ExpressionUUID->"fb8e2c98-80b1-4ab7-9fd9-45c7ffbcd6ca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"carpeta", "=", "\"\<../CA/FLAME3/seleccion2\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"escenarios", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<flame_plot_1\>\"", ",", "\"\<flame_plot_2\>\"", 
     ",", "\"\<flame_plot_3\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "destino", 
    "=", "\"\<../../../Documentation/img/experimentacion/naturales/Flame3/\>\"\
"}], ";"}], "\[IndentingNewLine]", "\t", "\[IndentingNewLine]", "\t", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"version", ":", " ", 
     RowBox[{"\"\<\>\"", " ", "para", " ", "15", " ", "estados"}]}], ",", " ", 
    RowBox[{"\"\<estados13\>\"", " ", "o", " ", "\"\<estados12\>\""}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"distribucion", "[", "version_String", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "evos", ",", "meta", ",", "k", ",", "bordes", ",", "cuentas", ",", 
        "prop"}], "}"}], ",", "\[IndentingNewLine]", "\t\t\t", 
      RowBox[{
       RowBox[{"evos", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"First", "[", 
           RowBox[{"Import", "[", 
            RowBox[{
             RowBox[{"FileNameJoin", "[", 
              RowBox[{"{", 
               RowBox[{
               "carpeta", ",", "#", ",", "version", ",", "\"\<evo.mat\>\""}], 
               "}"}], "]"}], ",", "\"\<MAT\>\""}], "]"}], "]"}], " ", "&"}], 
         " ", "/@", " ", "escenarios"}]}], ";", "\[IndentingNewLine]", 
       "\t\t\t", 
       RowBox[{"meta", "=", 
        RowBox[{"Import", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
            "carpeta", ",", "\"\<flame_plot_1\>\"", ",", "version", 
             ",", "\"\<evo.json\>\""}], "}"}], "]"}], 
          ",", "\"\<RawJSON\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\t\t\t", 
       RowBox[{"k", "=", 
        RowBox[{"meta", "[", "\"\<k\>\"", "]"}]}], ";", " ", 
       RowBox[{"bordes", "=", 
        RowBox[{"meta", "[", "\"\<edges_celsius\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", "\t\t\t", 
       RowBox[{"cuentas", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"Counts", "[", 
           RowBox[{"Round", "[", 
            RowBox[{"Flatten", "[", "evos", "]"}], "]"}], "]"}], ",", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{"k", "-", "1"}]}], "]"}], ",", "0"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\t\t\t", 
       RowBox[{"prop", "=", 
        RowBox[{"N", "[", 
         RowBox[{"cuentas", "/", 
          RowBox[{"Total", "[", "cuentas", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\t\t\t", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<cuentas\>\"", "->", "cuentas"}], ",", 
         RowBox[{"\"\<proporcion\>\"", "->", "prop"}], ",", 
         "\[IndentingNewLine]", "\t\t\t  ", 
         RowBox[{"\"\<rangos\>\"", "->", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ToString", "[", 
              RowBox[{"NumberForm", "[", 
               RowBox[{
                RowBox[{"bordes", "[", 
                 RowBox[{"[", "s", "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"4", ",", "1"}], "}"}]}], "]"}], "]"}], " ", "<>", 
             " ", "\"\<\[Dash]\>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", 
              RowBox[{"NumberForm", "[", 
               RowBox[{
                RowBox[{"bordes", "[", 
                 RowBox[{"[", 
                  RowBox[{"s", "+", "1"}], "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"4", ",", "1"}], "}"}]}], "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"s", ",", "k"}], "}"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "\t\t\t  ", 
         RowBox[{"\"\<paleta\>\"", "->", 
          RowBox[{"RGBColor", " ", "/@", " ", 
           RowBox[{"StringSplit", "[", 
            RowBox[{"Import", "[", 
             RowBox[{
              RowBox[{"\"\<../../\>\"", " ", "<>", " ", 
               RowBox[{"meta", "[", "\"\<palette\>\"", "]"}]}], 
              ",", "\"\<Text\>\""}], "]"}], "]"}]}]}]}], "|>"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\t", "\[IndentingNewLine]", "\t", 
  RowBox[{"(*", " ", 
   RowBox[{"18", " ", "estados", " ", "de", " ", 
    RowBox[{"BurnedStates", ":", " ", 
     RowBox[{
     "el", " ", "rango", " ", "de", " ", "cada", " ", "estado", " ", "sale", " ",
       "de", " ", "\"\<states\>\"", " ", "en", " ", 
      RowBox[{"evo", ".", "json"}]}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"distribucionQuemado", "[", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "evos", ",", "meta", ",", "k", ",", "cuentas", ",", "prop", ",", 
        "rangos"}], "}"}], ",", "\[IndentingNewLine]", "\t\t\t", 
      RowBox[{
       RowBox[{"evos", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"First", "[", 
           RowBox[{"Import", "[", 
            RowBox[{
             RowBox[{"FileNameJoin", "[", 
              RowBox[{"{", 
               RowBox[{
               "carpeta", ",", "\"\<BurnedStates\>\"", ",", "#", 
                ",", "\"\<evo.mat\>\""}], "}"}], "]"}], ",", "\"\<MAT\>\""}], 
            "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<flame_plot_1\>\"", ",", "\"\<flame_plot_2\>\""}], 
          "}"}]}]}], ";", "\[IndentingNewLine]", "\t\t\t", 
       RowBox[{"meta", "=", 
        RowBox[{"Import", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
            "carpeta", ",", "\"\<BurnedStates\>\"", 
             ",", "\"\<flame_plot_1\>\"", ",", "\"\<evo.json\>\""}], "}"}], 
           "]"}], ",", "\"\<RawJSON\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\t\t\t", 
       RowBox[{"k", "=", 
        RowBox[{"meta", "[", "\"\<k\>\"", "]"}]}], ";", "\[IndentingNewLine]",
        "\t\t\t", 
       RowBox[{"cuentas", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"Counts", "[", 
           RowBox[{"Round", "[", 
            RowBox[{"Flatten", "[", "evos", "]"}], "]"}], "]"}], ",", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{"k", "-", "1"}]}], "]"}], ",", "0"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\t\t\t", 
       RowBox[{"prop", "=", 
        RowBox[{"N", "[", 
         RowBox[{"cuentas", "/", 
          RowBox[{"Total", "[", "cuentas", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\t\t\t", 
       RowBox[{"rangos", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"StringReplace", "[", 
           RowBox[{
            RowBox[{"First", "[", 
             RowBox[{"StringCases", "[", 
              RowBox[{"#", ",", 
               RowBox[{
               "RegularExpression", 
                "[", "\"\<\\\\d+\\\\.\\\\d+ \[Dash] \\\\d+\\\\.\\\\d+\>\"", 
                "]"}]}], "]"}], "]"}], ",", 
            RowBox[{"\"\< \[Dash] \>\"", "->", "\"\<\[Dash]\>\""}]}], "]"}], 
          " ", "&"}], " ", "/@", " ", 
         RowBox[{"meta", "[", "\"\<states\>\"", "]"}]}]}], ";", 
       "\[IndentingNewLine]", "\t\t\t", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<cuentas\>\"", "->", "cuentas"}], ",", 
         RowBox[{"\"\<proporcion\>\"", "->", "prop"}], ",", 
         RowBox[{"\"\<rangos\>\"", "->", "rangos"}], ",", 
         "\[IndentingNewLine]", "\t\t\t  ", 
         RowBox[{"\"\<paleta\>\"", "->", 
          RowBox[{"RGBColor", " ", "/@", " ", 
           RowBox[{"StringSplit", "[", 
            RowBox[{"Import", "[", 
             RowBox[{
              RowBox[{"\"\<../../\>\"", " ", "<>", " ", 
               RowBox[{"meta", "[", "\"\<palette\>\"", "]"}]}], 
              ",", "\"\<Text\>\""}], "]"}], "]"}]}]}]}], "|>"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\t"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"tablaDe", "[", "d_", "]"}], ":=", 
    RowBox[{"Dataset", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Estado\>\"", "->", 
          RowBox[{"s", "-", "1"}]}], ",", 
         RowBox[{"\"\<Rango (\[Degree]C)\>\"", "->", 
          RowBox[{
           RowBox[{"d", "[", "\"\<rangos\>\"", "]"}], "[", 
           RowBox[{"[", "s", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<Celdas\>\"", "->", 
          RowBox[{
           RowBox[{"d", "[", "\"\<cuentas\>\"", "]"}], "[", 
           RowBox[{"[", "s", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
         "\t\t\t", 
         RowBox[{"\"\<Proporci\[OAcute]n\>\"", "->", 
          RowBox[{
           RowBox[{"d", "[", "\"\<proporcion\>\"", "]"}], "[", 
           RowBox[{"[", "s", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<Acumulada\>\"", "->", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"d", "[", "\"\<proporcion\>\"", "]"}], "[", 
            RowBox[{"[", " ", 
             RowBox[{";;", " ", "s"}], "]"}], "]"}], "]"}]}]}], "|>"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"d", "[", "\"\<cuentas\>\"", "]"}], "]"}]}], "}"}]}], "]"}],
      "]"}]}], ";"}], "\[IndentingNewLine]", "\t"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"estilo", "=", 
    RowBox[{"Sequence", "[", 
     RowBox[{
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"Axes", "->", "False"}], ",", 
      RowBox[{"FrameStyle", "->", 
       RowBox[{"GrayLevel", "[", "0.4", "]"}]}], ",", 
      RowBox[{"FrameTicksStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "11"}], "]"}]}], ",", "\[IndentingNewLine]", 
      "\t\t\t", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "12"}], "]"}]}], ",", 
      RowBox[{"GridLinesStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"GrayLevel", "[", "0.85", "]"}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\t"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"graficarDistribucion", "[", 
     RowBox[{"d_", ",", "titulo_", ",", 
      RowBox[{"escalaLog_", " ", ":", " ", "False"}], ",", 
      RowBox[{"tam_", " ", ":", " ", "400"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"valores", "=", 
         RowBox[{"d", "[", "\"\<proporcion\>\"", "]"}]}], ",", "n", ",", 
        "div"}], "}"}], ",", "\[IndentingNewLine]", "\t\t\t", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "valores", "]"}]}], ";", "\[IndentingNewLine]",
        "\t\t\t", 
       RowBox[{"div", "=", 
        RowBox[{"If", "[", 
         RowBox[{"escalaLog", ",", 
          RowBox[{"10", "^", 
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{"-", "4"}], ",", "0"}], "]"}]}], ",", 
          RowBox[{"N", "[", 
           RowBox[{"FindDivisions", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"1.12", " ", 
                RowBox[{"Max", "[", "valores", "]"}]}]}], "}"}], ",", "6"}], 
            "]"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\t\t\t", 
       RowBox[{"BarChart", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{"Style", ",", 
           RowBox[{"{", 
            RowBox[{"valores", ",", 
             RowBox[{"d", "[", "\"\<paleta\>\"", "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"ChartElementFunction", "->", "\"\<Rectangle\>\""}], ",", 
         RowBox[{"BarSpacing", "->", "0.15"}], ",", "\[IndentingNewLine]", 
         "\t\t\t\t", 
         RowBox[{"ScalingFunctions", "->", 
          RowBox[{"If", "[", 
           RowBox[{"escalaLog", ",", "\"\<Log10\>\"", ",", "None"}], "]"}]}], 
         ",", 
         RowBox[{"ChartBaseStyle", "->", 
          RowBox[{"EdgeForm", "[", 
           RowBox[{"GrayLevel", "[", "0.4", "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", "\t\t\t\t", 
         RowBox[{"ChartLabels", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", 
              RowBox[{"n", "-", "1"}]}], "]"}], ",", "Above"}], "]"}]}], ",", 
         "\[IndentingNewLine]", "\t\t\t\t", 
         RowBox[{"FrameTicks", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{"escalaLog", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"#", ",", 
                    RowBox[{"Superscript", "[", 
                    RowBox[{"10", ",", 
                    RowBox[{"Log10", "[", "#", "]"}]}], "]"}]}], "}"}], " ", 
                  "&"}], " ", "/@", " ", "div"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"#", ",", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"{", 
                    RowBox[{"3", ",", "2"}], "}"}]}], "]"}]}], "}"}], " ", 
                  "&"}], " ", "/@", " ", "div"}]}], "]"}], ",", "None"}], 
             "}"}], ",", "\[IndentingNewLine]", "\t\t\t\t\t", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"s", ",", 
                  RowBox[{"Rotate", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"d", "[", "\"\<rangos\>\"", "]"}], "[", 
                    RowBox[{"[", "s", "]"}], "]"}], ",", 
                    RowBox[{"90", " ", "Degree"}]}], "]"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"s", ",", "n"}], "}"}]}], "]"}], ",", "None"}], 
             "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", "\t\t\t\t", 
         RowBox[{"GridLines", "->", 
          RowBox[{"{", 
           RowBox[{"None", ",", "div"}], "}"}]}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"If", "[", 
           RowBox[{"escalaLog", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"10", "^", 
               RowBox[{"-", "4"}]}], ",", "2.5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"Max", "[", "div", "]"}]}], "}"}]}], "]"}]}], ",", 
