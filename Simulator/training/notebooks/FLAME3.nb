    RowBox[{
     RowBox[{"Flatten", "[", "mDispersa", "]"}], ",", 
     RowBox[{"1", " ", "|", " ", "2"}]}], "]"}]}], "}"}]}], "Input",Expression\
UUID->"af71ed08-d618-40cd-8664-0da3cea8be3b"],

