Cell[BoxData[
 RowBox[{
  RowBox[{"names", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"ToExpression", "[", 
      RowBox[{"\"\<0.\>\"", "<>", 
       RowBox[{"StringJoin", "[", 
        RowBox[{
         RowBox[{"Characters", "[", "#", "]"}], "[", 
