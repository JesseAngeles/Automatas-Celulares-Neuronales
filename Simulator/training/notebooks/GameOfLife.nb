Cell[CellGroupData[{

Cell["Medidas", "Section",ExpressionUUID->"82db275a-49af-4775-9fb8-498052d9af95"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"celdas", "[", "evo_", "]"}], ":=", 
   RowBox[{"Times", " ", "@@", " ", 
    RowBox[{"Rest", "[", 
     RowBox[{"Dimensions", "[", "evo", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"proporciones", "[", "evo_", "]"}], ":=", 
   RowBox[{"<|", 
    RowBox[{"\"\<Unos\>\"", "->", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"evo", ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "/", 
       RowBox[{"celdas", "[", "evo", "]"}]}], "]"}]}], "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cambios", "[", "evo_", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"d", "=", 
        RowBox[{"Differences", "[", "evo", "]"}]}], ",", 
       RowBox[{"n", "=", 
        RowBox[{"N", "[", 
         RowBox[{"celdas", "[", "evo", "]"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Nacimientos\>\"", "->", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"Clip", "[", 
            RowBox[{"d", ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "/", "n"}]}], ",", 
       "\[IndentingNewLine]", "\t  ", 
       RowBox[{"\"\<Muertes\>\"", "->", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"Clip", "[", 
            RowBox[{
             RowBox[{"-", "d"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "/", "n"}]}], ",", 
       "\[IndentingNewLine]", "\t  ", 
       RowBox[{"\"\<Quietos\>\"", "->", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"1", "-", 
            RowBox[{"Abs", "[", "d", "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "/", "n"}]}]}], "|>"}]}],
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datosProporciones", "=", 
   RowBox[{"proporciones", " ", "/@", " ", "evoluciones"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datosCambios", "=", 
   RowBox[{"cambios", " ", "/@", " ", "evoluciones"}]}], ";"}]}], "Input",
 CellLabel->"In[75]:=",ExpressionUUID->"3b4eb12b-10ca-4666-837f-538ffbfc0062"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Gr\[AAcute]ficas", "Section",ExpressionUUID->"7e3d00a8-50ca-4e47-9d4a-3a3591485767"],

Cell[TextData[{
 StyleBox["maximo", "TI"],
 " es el l\[IAcute]mite superior del eje y (1 por defecto); las marcas del \
eje y las l\[IAcute]neas gu\[IAcute]a usan las mismas divisiones. Con una \
sola medida no se agrega leyenda; el t\[IAcute]tulo la nombra. "
}], "Text",ExpressionUUID->"c303f98b-53cd-4180-a138-3cac4c0031a7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"colores", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"\"\<Unos\>\"", "->", 
      RowBox[{"RGBColor", "[", "\"\<#2a78d6\>\"", "]"}]}], ",", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"\"\<Nacimientos\>\"", "->", 
      RowBox[{"RGBColor", "[", "\"\<#2a78d6\>\"", "]"}]}], ",", 
     RowBox[{"\"\<Muertes\>\"", "->", 
      RowBox[{"RGBColor", "[", "\"\<#eb6834\>\"", "]"}]}], ",", 
     RowBox[{"\"\<Quietos\>\"", "->", 
      RowBox[{"RGBColor", "[", "\"\<#1baf7a\>\"", "]"}]}]}], "|>"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"graficar", "[", 
    RowBox[{"datos_List", ",", "pasos_List", ",", "titulo_String", ",", 
     RowBox[{"maximo_", " ", ":", " ", "1"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"medidas", "=", 
        RowBox[{"Keys", "[", 
         RowBox[{"First", "[", "datos", "]"}], "]"}]}], ",", 
       RowBox[{"divisiones", "=", 
        RowBox[{"FindDivisions", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "maximo"}], "}"}], ",", "6"}], "]"}]}], ",", 
       "grafica"}], "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"grafica", "=", 
       RowBox[{"Show", "[", "\[IndentingNewLine]", "\t\t", 
        RowBox[{
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Transpose", "[", 
                RowBox[{"{", 
                 RowBox[{"pasos", ",", 
                  RowBox[{"d", "[", "m", "]"}]}], "}"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"m", ",", "medidas"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"d", ",", "datos"}], "}"}]}], "]"}], ",", "1"}], 
            "]"}], ",", "\[IndentingNewLine]", "\t\t\t", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"ConstantArray", "[", 
                 RowBox[{
                  RowBox[{"Directive", "[", 
                   RowBox[{
                    RowBox[{"colores", "[", "m", "]"}], ",", 
                    RowBox[{"Opacity", "[", "0.3", "]"}], ",", 
                    RowBox[{"AbsoluteThickness", "[", "1", "]"}]}], "]"}], ",", 
                  RowBox[{"Length", "[", "datos", "]"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"m", ",", "medidas"}], "}"}]}], "]"}], ",", "1"}], 
             "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", "\t\t", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"pasos", ",", 
                RowBox[{"Mean", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"#", "[", "m", "]"}], " ", "&"}], " ", "/@", " ", 
                  "datos"}], "]"}]}], "}"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"m", ",", "medidas"}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", "\t\t\t", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Directive", "[", 
                RowBox[{
                 RowBox[{"colores", "[", "#", "]"}], ",", 
                 RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], " ", 
               "&"}], " ", "/@", " ", "medidas"}], ")"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", "\t\t", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Min", "[", "pasos", "]"}], ",", 
              RowBox[{"Max", "[", "pasos", "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "maximo"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"Axes", "->", "False"}], ",", "\[IndentingNewLine]", "\t\t", 
         
         RowBox[{"FrameTicks", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"#", ",", 
                  RowBox[{"NumberForm", "[", 
                   RowBox[{
                    RowBox[{"N", "[", "#", "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}], "}"}], " ", 
                "&"}], " ", "/@", " ", "divisiones"}], ",", "None"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Automatic", ",", "None"}], "}"}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", "\t\t", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Paso\>\"", ",", "\"\<Proporci\[OAcute]n\>\""}], 
           "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "titulo"}], ",", "\[IndentingNewLine]", 
         "\t\t", 
         RowBox[{"GridLines", "->", 
          RowBox[{"{", 
           RowBox[{"None", ",", "divisiones"}], "}"}]}], ",", 
         RowBox[{"GridLinesStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"GrayLevel", "[", "0.85", "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", "\t\t", 
         RowBox[{"FrameStyle", "->", 
          RowBox[{"GrayLevel", "[", "0.4", "]"}]}], ",", 
         RowBox[{"FrameTicksStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Black", ",", "11"}], "]"}]}], ",", 
         RowBox[{"LabelStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Black", ",", "12"}], "]"}]}], ",", "\[IndentingNewLine]", 
         "\t\t", 
         RowBox[{"ImageSize", "->", "400"}], ",", 
         RowBox[{"AspectRatio", "->", 
          RowBox[{"3", "/", "4"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "medidas", "]"}], "==", "1"}], ",", "grafica",
         ",", "\[IndentingNewLine]", "\t\t", 
        RowBox[{"Legended", "[", 
