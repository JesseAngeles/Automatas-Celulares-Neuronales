Cell[BoxData[
 RowBox[{
  RowBox[{"names", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"ToExpression", "[", 
      RowBox[{"\"\<0.\>\"", "<>", 
       RowBox[{"StringJoin", "[", 
        RowBox[{
         RowBox[{"Characters", "[", "#", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"6", ";;", 
           RowBox[{"-", "5"}]}], "]"}], "]"}], "]"}]}], "]"}], "&"}], "/@", 
