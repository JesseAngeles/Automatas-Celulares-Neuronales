Cell[BoxData[
 RowBox[{
  RowBox[{"basevector", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Part", "[", 
