    RowBox[{"LabelStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"FontSize", "->", "11"}], "]"}]}], ",", 
    RowBox[{"BarSpacing", "->", "0.42"}]}], "]"}]}]}], "Input",
