  RowBox[{
   RowBox[{"distSorted", "=", 
    RowBox[{"distancias", "[", 
     RowBox[{"[", "orden", "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"primerNoCero", "=", 
   RowBox[{
    RowBox[{"FirstPosition", "[", 
     RowBox[{"distSorted", ",", 
      RowBox[{"x_", "/;", 
       RowBox[{"x", ">", "0"}]}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mask", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"distSorted", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ">", "0"}], "||", 
       RowBox[{"i", "==", 
        RowBox[{"primerNoCero", "-", "1"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "distSorted", "]"}]}], "}"}]}], "]"}]}], ";"}],
   "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"namesFiltered", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{"namesSorted", ",", "mask"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"distFiltered", "=", 
    RowBox[{"Pick", "[", 
     RowBox[{"distSorted", ",", "mask"}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Colorear", " ", "seg\[UAcute]n", " ", "el", " ", "VALOR"}], ",", 
    
    RowBox[{
    "no", " ", "seg\[UAcute]n", " ", "la", " ", "posici\[OAcute]n"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"colorFunc", "=", 
   RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"valoresEscalados", "=", 
    RowBox[{"Rescale", "[", "distFiltered", "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"normaliza", " ", "entre", " ", "0", " ", "y", " ", "1"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coloresPorValor", "=", 
    RowBox[{"colorFunc", "/@", "valoresEscalados"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"fplot", "=", 
  RowBox[{"BarChart", "[", 
   RowBox[{"distFiltered", ",", 
    RowBox[{"ChartStyle", "->", "coloresPorValor"}], ",", 
    RowBox[{"ChartLabels", "->", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Rotate", "[", 
          RowBox[{"#", ",", 
           RowBox[{"90", " ", "Degree"}]}], "]"}], "&"}], "/@", 
        "namesFiltered"}], ",", "Axis"}], "]"}]}], ",", 
    RowBox[{"ScalingFunctions", "->", "\"\<Log\>\""}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Perdida objetivo\>\"", 
       ",", "\"\<Distancia de Manhattan\>\""}], "}"}]}], ",", 
    RowBox[{
    "PlotLabel", "->", "\"\<Distancia de Manhattan respecto a B3/S236\>\""}], 
    ",", 
    RowBox[{"ImageSize", "->", "700"}], ",", 
    RowBox[{"LabelStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"FontSize", "->", "11"}], "]"}]}], ",", 
    RowBox[{"BarSpacing", "->", "0.42"}]}], "]"}]}]}], "Input",
