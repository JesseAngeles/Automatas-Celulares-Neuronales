Cell[BoxData[{
 RowBox[{
  RowBox[{"names", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"\"\<C\>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", "\"\< N\>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "&"}], "/@", 
    RowBox[{"Keys", "[", "patternCount", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"total", "=", 
   RowBox[{"Total", "[", 
    RowBox[{"patternCount", "[", 
     RowBox[{"[", 
      RowBox[{";;", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.997579059164174*^9, 3.9975791041808357`*^9}, {
   3.9975809401956787`*^9, 3.9975809404341373`*^9}, 3.9975812486493483`*^9, {
   3.9975813008264503`*^9, 3.997581301464995*^9}, 3.997581338083755*^9},
 CellLabel->"In[23]:=",ExpressionUUID->"7230ce86-5415-4afe-8a2c-1b311e62f8f6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"props", "=", 
   FractionBox[
    RowBox[{"Values", "[", "patternCount", "]"}], "total"]}], ";", 
  RowBox[{"propsSampled", "=", 
   RowBox[{
    TemplateBox[{"props"},
     "Transpose"], "\[LeftDoubleBracket]", 
    RowBox[{"1", ";;", "All", ";;", "4"}], "\[RightDoubleBracket]"}]}], ";", 
  RowBox[{"meansPct", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"ToString", "[", 
       TagBox[
        RowBox[{"Slot", "[", 
         InterpretationBox[
          StyleBox["\<\"1\"\>",
           ShowStringCharacters->False],
          1,
          Editable->False], "]"}],
        NumberForm[#, {Infinity, 3}]& ], "]"}], "&"}], ")"}], "/@", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Mean", "/@", 
       TemplateBox[{"propsSampled"},
        "Transpose"]}], " ", "100"}], "]"}]}]}], ";", 
  RowBox[{"legends", "=", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#1", "<>", "\"\<: \>\"", "<>", "#2", "<>", "\"\<%\>\""}], 
      "&"}], ",", 
     RowBox[{"{", 
      RowBox[{"names", ",", "meansPct"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9975809642362947`*^9, 3.9975809708905993`*^9}, {
   3.997581032837113*^9, 3.9975810632852373`*^9}, {3.997581127191564*^9, 
   3.997581146126837*^9}, {3.99758118652076*^9, 3.997581203360147*^9}, {
   3.997581392524686*^9, 3.997581409220368*^9}, 3.997582008806321*^9},
 CellLabel->"In[25]:=",ExpressionUUID->"121cc85e-765d-4a7f-bb0e-34e708314ff1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"meansVec", "=", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"Mean", "/@", 
      RowBox[{"Transpose", "[", "propsSampled", "]"}]}], "]"}], " ", 
    "100"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"stdVec", "=", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"StandardDeviation", "/@", 
      RowBox[{"Transpose", "[", "propsSampled", "]"}]}], "]"}], " ", 
    "100"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"order", "=", 
   RowBox[{"Ordering", "[", 
    RowBox[{"meansVec", ",", "All", ",", "Greater"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"namesSorted", "=", 
   RowBox[{"names", "[", 
    RowBox[{"[", "order", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"meansSorted", "=", 
   RowBox[{"meansVec", "[", 
    RowBox[{"[", "order", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"stdSorted", "=", 
   RowBox[{"stdVec", "[", 
    RowBox[{"[", "order", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"colors", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"StringStartsQ", "[", 
        RowBox[{"#", ",", "\"\<C0\>\""}], "]"}], ",", 
       TemplateBox[<|"color" -> RGBColor[1, 0.8, 0.081]|>,
        "RGBColorSwatchTemplate"], ",", 
       TemplateBox[<|"color" -> RGBColor[0.392, 1, 0.736]|>,
        "RGBColorSwatchTemplate"]}], "]"}], "&"}], "/@", "namesSorted"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", 
    RowBox[{"Length", "[", "meansSorted", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"lowerBound", "=", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"#1", "-", "#2"}], ",", "0.001"}], "]"}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{"meansSorted", ",", "stdSorted"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"upperBound", "=", 
    RowBox[{"meansSorted", "+", "stdSorted"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"barChart", "=", 
    RowBox[{"BarChart", "[", 
     RowBox[{"meansSorted", ",", 
      RowBox[{"ChartLabels", "->", 
       RowBox[{"Placed", "[", 
        RowBox[{"namesSorted", ",", "Axis", ",", 
         RowBox[{
          RowBox[{"Rotate", "[", 
           RowBox[{"#", ",", 
            RowBox[{"90", " ", "Degree"}]}], "]"}], "&"}]}], "]"}]}], ",", 
      RowBox[{"ChartStyle", "->", "colors"}], ",", 
      RowBox[{
      "PlotLabel", 
       "->", "\"\<Proporci\[OAcute]n de patrones (media \[PlusMinus] std \
entre muestras)\>\""}], ",", 
      RowBox[{"ScalingFunctions", "->", "\"\<Log\>\""}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"errorBars", "=", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{"Black", ",", "Thick", ",", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"#1", ",", 
               RowBox[{"Log", "[", 
                RowBox[{"10", ",", "#2"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"#1", ",", 
               RowBox[{"Log", "[", 
                RowBox[{"10", ",", "#3"}], "]"}]}], "}"}]}], "}"}], "]"}], 
          "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Range", "[", "n", "]"}], ",", "lowerBound", ",", 
           "upperBound"}], "}"}]}], "]"}]}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Etiquetas", " ", "verticales"}], ",", 
    RowBox[{"rotadas", " ", "90", " ", "grados"}], ",", 
    RowBox[{
    "ancladas", " ", "a", " ", "la", " ", "izquierda", " ", "del", " ", 
     "punto"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"valueLabels", "=", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{"Black", ",", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Text", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ToString", "[", 
              RowBox[{"NumberForm", "[", 
               RowBox[{"#2", ",", 
                RowBox[{"{", 
                 RowBox[{"Infinity", ",", "3"}], "}"}]}], "]"}], "]"}], 
             "<>", "\"\<%\>\""}], ",", 
            RowBox[{"{", 
             RowBox[{"#1", ",", 
              RowBox[{
               RowBox[{"Log", "[", 
                RowBox[{"10", ",", "#3"}], "]"}], "+", "0.1"}]}], "}"}], ",", 
            
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}]}], "  ", 
           RowBox[{"(*", 
            RowBox[{"direcci\[OAcute]n", " ", "del", " ", 
             RowBox[{"texto", ":", 
              RowBox[{"vertical", " ", "hacia", " ", "arriba"}]}]}], "*)"}], 
           "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Range", "[", "n", "]"}], ",", "meansSorted", ",", 
           "upperBound"}], "}"}]}], "]"}]}], "}"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fplot", "=", 
   RowBox[{"Show", "[", 
    RowBox[{"barChart", ",", "errorBars", ",", "valueLabels", ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"ImageSize", "->", "400"}], ",", 
     RowBox[{"PlotRangeClipping", "->", "False"}], ",", 
     RowBox[{"ImagePadding", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"20", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"30", ",", "10"}], "}"}]}], "}"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.997581895857645*^9, 3.997581895857657*^9}, {
  3.9975819348224297`*^9, 3.997581992588801*^9}, {3.997582224384973*^9, 
  3.997582268545702*^9}, {3.9975823286186132`*^9, 3.997582339234397*^9}, {
