      RowBox[{"meansSorted", ",", "stdSorted"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"upperBound", "=", 
    RowBox[{"meansSorted", "+", "stdSorted"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"barChart", "=", 
    RowBox[{"BarChart", "[", 
     RowBox[{"meansSorted", ",", 
      RowBox[{"ChartLabels", "->", 
       RowBox[{"Placed", "[", 
        RowBox[{"namesSorted", ",", "Axis", ",", 
         RowBox[{
          RowBox[{"Rotate", "[", 
           RowBox[{"#", ",", 
            RowBox[{"90", " ", "Degree"}]}], "]"}], "&"}]}], "]"}]}], ",", 
      RowBox[{"ChartStyle", "->", "colors"}], ",", 
      RowBox[{
      "PlotLabel", 
       "->", "\"\<Proporci\[OAcute]n de patrones (media \[PlusMinus] std \
entre muestras)\>\""}], ",", 
      RowBox[{"ScalingFunctions", "->", "\"\<Log\>\""}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"errorBars", "=", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{"Black", ",", "Thick", ",", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"#1", ",", 
               RowBox[{"Log", "[", 
                RowBox[{"10", ",", "#2"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"#1", ",", 
               RowBox[{"Log", "[", 
                RowBox[{"10", ",", "#3"}], "]"}]}], "}"}]}], "}"}], "]"}], 
          "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Range", "[", "n", "]"}], ",", "lowerBound", ",", 
           "upperBound"}], "}"}]}], "]"}]}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Etiquetas", " ", "verticales"}], ",", 
    RowBox[{"rotadas", " ", "90", " ", "grados"}], ",", 
    RowBox[{
    "ancladas", " ", "a", " ", "la", " ", "izquierda", " ", "del", " ", 
     "punto"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"valueLabels", "=", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{"Black", ",", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Text", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ToString", "[", 
              RowBox[{"NumberForm", "[", 
               RowBox[{"#2", ",", 
                RowBox[{"{", 
                 RowBox[{"Infinity", ",", "3"}], "}"}]}], "]"}], "]"}], 
             "<>", "\"\<%\>\""}], ",", 
            RowBox[{"{", 
             RowBox[{"#1", ",", 
              RowBox[{
               RowBox[{"Log", "[", 
                RowBox[{"10", ",", "#3"}], "]"}], "+", "0.1"}]}], "}"}], ",", 
            
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}]}], "  ", 
           RowBox[{"(*", 
            RowBox[{"direcci\[OAcute]n", " ", "del", " ", 
             RowBox[{"texto", ":", 
              RowBox[{"vertical", " ", "hacia", " ", "arriba"}]}]}], "*)"}], 
           "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Range", "[", "n", "]"}], ",", "meansSorted", ",", 
           "upperBound"}], "}"}]}], "]"}]}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"fplot", "=", 
   RowBox[{"Show", "[", 
    RowBox[{"barChart", ",", "errorBars", ",", "valueLabels", ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"ImageSize", "->", "400"}], ",", 
     RowBox[{"PlotRangeClipping", "->", "False"}], ",", 
     RowBox[{"ImagePadding", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"20", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"30", ",", "10"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
